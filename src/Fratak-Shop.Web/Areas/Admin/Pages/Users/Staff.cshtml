@page "/admin/users/staff"
@model Fratak_Shop.Web.Areas.Admin.Pages.Users.StaffModel
@{
    var selected = Model.Input.SelectedRoles;
}

<div class="grid gap-6 lg:grid-cols-12">
    <div class="card overflow-hidden lg:col-span-7">
        <div class="border-b border-zinc-100 px-5 py-4">
            <h2 class="text-sm font-bold text-zinc-800">اعضای پنل</h2>
            <p class="mt-1 text-[11px] text-zinc-400">هر کاربر می‌تواند هم‌زمان چند نقش داشته باشد؛ دسترسی‌ها با اجتماع نقش‌ها محاسبه می‌شود.</p>
        </div>
        <div class="overflow-x-auto">
            <table class="table-admin w-full">
                <thead>
                    <tr>
                        <th>عضو</th>
                        <th>نقش‌ها</th>
                        <th>وضعیت</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="4" class="py-8 text-center text-xs text-zinc-400">عضو پنلی ثبت نشده است.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <span class="text-xs font-semibold text-zinc-700">@item.FullName</span>
                                <span class="block text-[11px] text-zinc-400 fa-num" dir="ltr">@item.PhoneNumber</span>
                            </td>
                            <td>
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var role in item.Roles)
                                    {
                                        <span class="badge @(role == UserRole.SuperAdmin ? "badge-sky" : "badge-gray")">@role.GetTitle()</span>
                                    }
                                </div>
                            </td>
                            <td><span class="badge @(item.IsActive ? "badge-green" : "badge-gray")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td>
                            <td>
                                <div class="flex items-center gap-x-2">
                                    <a class="text-xs text-sky-600" href="/admin/users/staff?edit=@item.Id">ویرایش نقش‌ها</a>
                                    @if (!item.Roles.Contains(UserRole.SuperAdmin))
                                    {
                                        <form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-xs text-zinc-500">@(item.IsActive ? "غیرفعال کن" : "فعال کن")</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="lg:col-span-5">
        <div class="card sticky top-24 p-5">
            <h2 class="section-title">@(Model.Input.Id.HasValue ? "ویرایش عضو پنل" : "افزودن عضو پنل")</h2>
            <form method="post" asp-page-handler="Save" class="grid gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Input.Id" />

                <div>
                    <label class="form-label" asp-for="Input.PhoneNumber">شماره موبایل</label>
                    <input class="form-input text-left" dir="ltr" asp-for="Input.PhoneNumber" placeholder="09120000000" />
                    <span class="form-error" asp-validation-for="Input.PhoneNumber"></span>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="form-label" asp-for="Input.FirstName">نام</label>
                        <input class="form-input" asp-for="Input.FirstName" />
                    </div>
                    <div>
                        <label class="form-label" asp-for="Input.LastName">نام خانوادگی</label>
                        <input class="form-input" asp-for="Input.LastName" />
                    </div>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Email">ایمیل</label>
                    <input class="form-input text-left" dir="ltr" asp-for="Input.Email" />
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Password">@(Model.Input.Id.HasValue ? "رمز عبور جدید (اختیاری)" : "رمز عبور")</label>
                    <input class="form-input text-left" dir="ltr" type="text" asp-for="Input.Password" />
                    <span class="form-error" asp-validation-for="Input.Password"></span>
                </div>

                <fieldset>
                    <legend class="form-label">نقش‌ها (چند انتخابی)</legend>
                    <div class="flex flex-col gap-2">
                        @foreach (var role in Fratak_Shop.Web.Areas.Admin.Pages.Users.StaffModel.Roles)
                        {
                            <label class="flex items-start gap-x-2 rounded-xl border border-zinc-100 p-2 text-[11px] text-zinc-600">
                                <input class="form-checkbox mt-0.5" type="checkbox" name="Input.SelectedRoles" value="@role.Role"
                                       checked="@selected.Contains(role.Role)" />
                                <span>
                                    <span class="font-semibold text-zinc-700">@role.Title</span>
                                    <span class="block text-zinc-400">@role.Role.GetDescription()</span>
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>

                <div>
                    <label class="form-label" asp-for="Input.PrimaryRole">نقش اصلی (مسیر ورود به پنل)</label>
                    <select class="form-input" asp-for="Input.PrimaryRole">
                        @foreach (var role in Fratak_Shop.Web.Areas.Admin.Pages.Users.StaffModel.Roles)
                        {
                            <option value="@role.Role">@role.Title</option>
                        }
                    </select>
                </div>

                <label class="flex items-center gap-x-2 text-xs text-zinc-600">
                    <input type="checkbox" class="form-checkbox" asp-for="Input.IsActive" />
                    حساب فعال باشد
                </label>

                <button type="submit" class="btn-primary w-full text-xs">ذخیره عضو پنل</button>
            </form>
        </div>
    </div>
</div>
