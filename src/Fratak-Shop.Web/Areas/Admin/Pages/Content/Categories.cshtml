@page "/admin/categories"
@model Fratak_Shop.Web.Areas.Admin.Pages.Content.CategoriesModel
@{
}

<div class="grid gap-6 lg:grid-cols-12">
    <div class="card overflow-hidden lg:col-span-7">
        <h2 class="border-b border-zinc-100 px-5 py-4 text-sm font-bold text-zinc-800">دسته‌بندی‌ها</h2>
        <div class="overflow-x-auto">
            <table class="table-admin w-full">
                <thead>
                    <tr>
                        <th>نام</th>
                        <th>والد</th>
                        <th>محصول</th>
                        <th>وضعیت</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="5" class="py-8 text-center text-xs text-zinc-400">دسته‌بندی‌ای ثبت نشده است.</td></tr>
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="flex items-center gap-x-2">
                                    <img class="h-8 w-8 rounded-lg object-cover" src="@Ui.CategoryImage(item.ImageName)" alt="@item.Name" />
                                    <span class="text-xs text-zinc-700">@item.Name</span>
                                </div>
                            </td>
                            <td class="text-xs text-zinc-500">@(item.ParentName ?? "—")</td>
                            <td class="text-xs text-zinc-600">@PriceHelper.ToPersianDigits(item.ProductCount.ToString())</td>
                            <td><span class="badge @(item.IsActive ? "badge-green" : "badge-gray")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td>
                            <td>
                                <div class="flex items-center gap-x-2">
                                    <a class="text-xs text-sky-600" href="/admin/categories?edit=@item.Id">ویرایش</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" data-confirm="این دسته‌بندی حذف شود؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-xs text-rose-500">حذف</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="lg:col-span-5">
        <div class="card sticky top-24 p-5">
            <h2 class="section-title">@(Model.Input.Id.HasValue ? "ویرایش دسته‌بندی" : "افزودن دسته‌بندی")</h2>
            <form method="post" asp-page-handler="Save" enctype="multipart/form-data" class="grid gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Input.Id" />
                <input type="hidden" asp-for="Input.ImageName" />

                <div>
                    <label class="form-label" asp-for="Input.Name">نام دسته‌بندی</label>
                    <input class="form-input" asp-for="Input.Name" />
                    <span class="form-error" asp-validation-for="Input.Name"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ParentId">دسته والد</label>
                    <select class="form-input" asp-for="Input.ParentId">
                        <option value="">بدون والد (دسته اصلی)</option>
                        @foreach (var parent in Model.Parents)
                        {
                            <option value="@parent.Id">@parent.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Description">توضیحات</label>
                    <textarea class="form-input" asp-for="Input.Description" rows="2"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="form-label" asp-for="Input.DisplayOrder">ترتیب</label>
                        <input class="form-input text-center" asp-for="Input.DisplayOrder" inputmode="numeric" />
                    </div>
                    <div>
                        <label class="form-label" asp-for="Input.Slug">نامک</label>
                        <input class="form-input text-left" dir="ltr" asp-for="Input.Slug" />
                    </div>
                </div>
                <div>
                    <label class="form-label" asp-for="Image">تصویر دسته‌بندی</label>
                    <input class="form-input" asp-for="Image" type="file" accept="image/*" />
                </div>
                <label class="flex items-center gap-x-2 text-xs text-zinc-600">
                    <input type="checkbox" class="form-checkbox" asp-for="Input.IsActive" />
                    فعال باشد
                </label>

                <details class="rounded-xl border border-zinc-100 p-3">
                    <summary class="cursor-pointer text-xs font-semibold text-zinc-700">تنظیمات سئو</summary>
                    <div class="mt-3 flex flex-col gap-3">
                        <div>
                            <label class="form-label" asp-for="Input.SeoTitle">عنوان سئو</label>
                            <input class="form-input" asp-for="Input.SeoTitle" data-seo-title />
                        </div>
                        <div>
                            <label class="form-label" asp-for="Input.SeoDescription">توضیحات متا</label>
                            <textarea class="form-input" asp-for="Input.SeoDescription" rows="2" data-seo-description></textarea>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="form-label" asp-for="Input.SeoFocusKeyword">کلمه کلیدی</label>
                                <input class="form-input" asp-for="Input.SeoFocusKeyword" />
                            </div>
                            <div>
                                <label class="form-label" asp-for="Input.SeoKeywords">کلمات کلیدی</label>
                                <input class="form-input" asp-for="Input.SeoKeywords" />
                            </div>
                        </div>
                    </div>
                </details>

                <button type="submit" class="btn-primary w-full text-xs">ذخیره دسته‌بندی</button>
                @if (Model.Input.Id.HasValue)
                {
                    <a class="btn-ghost w-full text-xs" href="/admin/categories">انصراف از ویرایش</a>
                }
            </form>
        </div>
    </div>
</div>
