@page "/admin/comments"
@model Fratak_Shop.Web.Areas.Admin.Pages.Content.CommentsModel
@{
}

<div class="card overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 px-5 py-4">
        <div>
            <h1 class="text-sm font-bold text-zinc-800">دیدگاه‌ها</h1>
            <p class="mt-1 text-[11px] text-zinc-400">بررسی، تأیید و پاسخ به دیدگاه‌های محصولات و مقالات.</p>
        </div>
        <form method="get" action="/admin/comments" class="flex flex-wrap items-center gap-2">
            <input class="form-input w-40 py-1.5 text-xs" name="q" value="@Model.Search" placeholder="جستجو..." />
            <select class="form-input w-32 py-1.5 text-xs" name="status" onchange="this.form.submit()">
                <option value="">همه وضعیت‌ها</option>
                <option value="@((int)CommentStatus.Pending)" selected="@(Model.Status == CommentStatus.Pending)">در انتظار تأیید</option>
                <option value="@((int)CommentStatus.Approved)" selected="@(Model.Status == CommentStatus.Approved)">تأییدشده</option>
                <option value="@((int)CommentStatus.Rejected)" selected="@(Model.Status == CommentStatus.Rejected)">ردشده</option>
            </select>
            <button type="submit" class="btn-secondary px-4 py-1.5 text-xs">فیلتر</button>
        </form>
    </div>

    <div class="divide-y divide-zinc-100">
        @if (Model.Result.Data.Count == 0)
        {
            <p class="py-10 text-center text-xs text-zinc-400">دیدگاهی یافت نشد.</p>
        }
        @foreach (var item in Model.Result.Data)
        {
            <article class="p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <div class="flex flex-wrap items-center gap-x-2">
                            <span class="text-xs font-semibold text-zinc-800">@item.AuthorName</span>
                            <span class="text-[11px] text-zinc-400 fa-num" dir="ltr">@item.AuthorPhone</span>
                            <span class="badge @Ui.CommentStatusClass(item.Status)">@Ui.CommentStatusTitle(item.Status)</span>
                            @if (item.Rating.HasValue)
                            {
                                <span class="badge badge-amber">@PriceHelper.ToPersianDigits(item.Rating.Value.ToString()) از ۵</span>
                            }
                        </div>
                        <p class="mt-1 text-[11px] text-zinc-400">@item.CreatedAt.ToPersianDateTime()</p>
                    </div>
                    <div class="flex items-center gap-x-2 text-xs">
                        @if (item.Status != CommentStatus.Approved)
                        {
                            <form method="post" asp-page-handler="Approve" asp-route-id="@item.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-emerald-600">تأیید</button>
                            </form>
                        }
                        @if (item.Status != CommentStatus.Rejected)
                        {
                            <form method="post" asp-page-handler="Reject" asp-route-id="@item.Id">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="text-amber-600">رد</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" data-confirm="این دیدگاه حذف شود؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-rose-500">حذف</button>
                        </form>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(item.Title))
                {
                    <p class="mt-3 text-xs font-semibold text-zinc-700">@item.Title</p>
                }
                <p class="mt-2 text-xs leading-6 text-zinc-600">@item.Content</p>

                @if (item.Replies.Count > 0)
                {
                    <div class="mt-3 flex flex-col gap-2 border-r-2 border-zinc-100 pr-4">
                        @foreach (var reply in item.Replies)
                        {
                            <div>
                                <span class="text-[11px] font-semibold text-zinc-600">@reply.AuthorName</span>
                                <p class="text-[11px] leading-6 text-zinc-500">@reply.Content</p>
                            </div>
                        }
                    </div>
                }
            </article>
        }
    </div>

    <partial name="_Pagination" model="Model.Result" />
</div>
