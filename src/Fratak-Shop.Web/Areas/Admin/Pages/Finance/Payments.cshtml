@page
@model Fratak_Shop.Web.Areas.Admin.Pages.Finance.PaymentsModel
@using Fratak_Shop.Data.Entities.Payments
@{
    ViewData["Title"] = "تراکنش‌های درگاه";
    var request = HttpContext.Request;
}
<div class="a-page-head">
  <div>
    <h2>تراکنش‌های درگاه <span class="a-muted text-sm font-normal">(@Format.Number(Model.Payments.Total))</span></h2>
    <p class="a-muted text-sm mt-1">همه تلاش‌های پرداخت آنلاین (سفارش، شارژ کیف پول، کارت هدیه) با کد پیگیری و پاسخ درگاه.</p>
  </div>
  @if (Model.Can(AdminPermissions.FinanceExport))
  {
    <div class="a-btn-group">
      <a href="@AdminUi.With(request, ("handler", "export"), ("format", "xlsx"))" class="a-btn a-btn-light">@Icons.Svg("Download", null, 18) اکسل</a>
      <a href="@AdminUi.With(request, ("handler", "export"), ("format", "csv"))" class="a-btn a-btn-light">CSV</a>
    </div>
  }
</div>

<div class="a-card mb-4">
  <form method="get" class="a-card-body a-filters">
    <div class="a-field" style="flex-basis:220px"><label class="a-label" for="p-q">جست‌وجو</label><input id="p-q" name="q" value="@Model.Search" class="a-input" placeholder="کد پیگیری، Authority، شماره سفارش یا موبایل"></div>
    <div class="a-field"><label class="a-label" for="p-status">وضعیت</label>
      <select id="p-status" name="status" class="a-select" data-autosubmit>
        <option value="">همه</option>
        @foreach (var st in new[] { PaymentTransactionStatus.Succeeded, PaymentTransactionStatus.Failed, PaymentTransactionStatus.Cancelled, PaymentTransactionStatus.Pending, PaymentTransactionStatus.Verifying }) { <option value="@st" selected="@(Model.Status == st)">@AdminUi.TransactionStatus(st)</option> }
      </select></div>
    <div class="a-field"><label class="a-label" for="p-purpose">نوع</label>
      <select id="p-purpose" name="purpose" class="a-select" data-autosubmit>
        <option value="">همه</option>
        @foreach (var pu in new[] { PaymentPurpose.OrderPayment, PaymentPurpose.WalletTopUp, PaymentPurpose.GiftCard }) { <option value="@pu" selected="@(Model.Purpose == pu)">@AdminUi.PaymentPurpose(pu)</option> }
      </select></div>
    <div class="a-field"><label class="a-label" for="p-from">از</label><input id="p-from" name="from" value="@Model.From" class="a-input a-ltr" placeholder="1404/01/01"></div>
    <div class="a-field"><label class="a-label" for="p-to">تا</label><input id="p-to" name="to" value="@Model.To" class="a-input a-ltr" placeholder="1404/12/29"></div>
    <div class="a-filters-actions"><button class="a-btn" type="submit">اعمال</button><a class="a-btn a-btn-light" href="/admin/finance/payments">پاک کردن</a></div>
  </form>
</div>

<div class="a-card">
  <div class="a-table-wrap">
    <table class="a-table a-table-cards a-table-compact">
      <thead><tr><th>تاریخ</th><th>نوع</th><th>مبلغ</th><th>وضعیت</th><th>کد پیگیری / کارت</th><th>کاربر</th><th>سفارش</th><th>پاسخ درگاه</th></tr></thead>
      <tbody>
        @foreach (var p in Model.Payments.Items)
        {
          <tr>
            <td data-label="تاریخ" class="nowrap text-xs">@Format.DateTime(p.CreatedAt)</td>
            <td data-label="نوع">@AdminUi.PaymentPurpose(p.Purpose) <span class="a-muted text-xs">@p.Gateway</span></td>
            <td data-label="مبلغ" class="num">@Format.Price(p.Amount)</td>
            <td data-label="وضعیت"><span class="a-badge @AdminUi.TransactionBadge(p.Status)">@AdminUi.TransactionStatus(p.Status)</span></td>
            <td data-label="کد پیگیری" class="a-ltr text-xs">@p.RefId @if (p.CardPan is not null) { <div class="a-muted">@p.CardPan</div> }</td>
            <td data-label="کاربر">@if (p.UserId is not null && Model.Can(AdminPermissions.CustomersView)) { <a class="a-link" href="/admin/customers/@p.UserId">@p.UserName</a> } else { @p.UserName }</td>
            <td data-label="سفارش">@if (p.OrderId is not null) { <a class="a-link a-ltr" href="/admin/orders/@p.OrderId">@p.OrderNumber</a> }</td>
            <td data-label="پاسخ درگاه" class="text-xs">@(p.ResultCode is null ? "" : $"[{p.ResultCode}] ")@p.Message</td>
          </tr>
        }
      </tbody>
    </table>
    @if (Model.Payments.Items.Count == 0) { <div class="a-empty">تراکنشی یافت نشد.</div> }
  </div>
  <partial name="_AdminPager" model="new PagerModel(Model.Payments.Page, Model.Payments.PageCount, Model.Payments.Total)" />
</div>
