@page "/admin/seo/analyze"
@model Fratak_Shop.Web.Areas.Admin.Pages.Seo.AnalyzeModel
@using Fratak_Shop.Core.Services.Seo.Engine
@using Fratak_Shop.Data.Entities.SeoEngine
@using Fratak_Shop.Web.Infrastructure.SeoEngine
@*
  تحلیل سئوی یک صفحه (مرحلهٔ هفتم – فاز ۸).
  • نمره (دایره)، خلاصهٔ متن و کلمهٔ کلیدی، پیش‌نمایش گوگل.
  • بررسی‌ها به تفکیک گروه؛ برای هر مورد مشخص است موتور می‌تواند درستش کند یا کار انسانی است.
  • کلمه‌های نامزد (فقط از داده‌های کش‌شده؛ صفحه بدون درخواست اینترنتی باز می‌شود) و تاریخچهٔ پیشنهادها.
*@
@{
    var a = Model.Analysis;
    var subject = a.Subject;
    var report = a.Report;
    ViewData["Title"] = "تحلیل سئو: " + subject.Name;
    var scoreColor = report.Score >= 80 ? "#16a34a" : report.Score >= 50 ? "#d97706" : "#dc2626";
    var groups = report.Checks.GroupBy(x => x.Group).ToList();
}

<div class="a-page-head">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span class="a-badge a-badge-gray">@SeoEngineUi.KindTitle(subject.Kind)</span>
      <h2>@subject.Name</h2>
    </div>
    <a class="a-muted text-xs a-ltr break-all" href="@SeoEngineUi.PublicUrl(subject.Path)" target="_blank" rel="noopener">@subject.Path</a>
  </div>
  <div class="a-btn-group">
    <form method="post" action="@AdminUi.With(HttpContext.Request, ("handler", "Generate"))" asp-antiforgery="true">
      <button type="submit" class="a-btn" disabled="@(subject.NoIndex ? "disabled" : null)">@Icons.Svg("MagicWand", null, 18) ساخت پیشنهاد</button>
    </form>
    <a class="a-btn a-btn-light" href="@a.EditUrl">@Icons.Svg("PencilSimple", null, 18) ویرایش صفحه</a>
    <a class="a-btn a-btn-light" href="@SeoEngineUi.PublicUrl(subject.Path)" target="_blank" rel="noopener">@Icons.Svg("Eye", null, 18) مشاهده</a>
  </div>
</div>

@if (subject.NoIndex)
{
  <div class="a-alert a-alert-warn mb-4">این صفحه noindex است (در گوگل نمایش داده نمی‌شود)؛ موتور برای آن پیشنهاد نمی‌سازد.</div>
}
else if (subject.HasCanonicalElsewhere)
{
  <div class="a-alert a-alert-info mb-4">کانونیکال این صفحه به آدرس دیگری اشاره می‌کند؛ موتور به‌طور خودکار برایش پیشنهاد نمی‌سازد.</div>
}

<div class="grid gap-4 lg:grid-cols-3 mb-4">
  <div class="a-card">
    <div class="a-card-body flex items-center gap-4">
      <div class="a-score" style="--score:@(report.Score);--score-color:@scoreColor" role="img" aria-label="نمره @report.Score از ۱۰۰"><span>@Format.Number(report.Score)</span></div>
      <dl class="a-kv text-sm flex-1">
        <dt>کلمهٔ کلیدی</dt><dd>@(string.IsNullOrWhiteSpace(subject.FocusKeyword) ? "تعیین نشده" : subject.FocusKeyword)</dd>
        <dt>حجم متن</dt><dd>@Format.Number(report.Words) واژه</dd>
        @if (report.KeywordCount > 0) { <dt>تکرار کلمه</dt><dd>@Format.Number(report.KeywordCount) بار (@report.Density.ToString("0.0")٪)</dd> }
        <dt>مشکل‌ها</dt><dd class="@(report.Problems > 0 ? "a-down" : "a-up")">@Format.Number(report.Problems)</dd>
        <dt>بازدید</dt><dd>@Format.Number(subject.Views)</dd>
      </dl>
    </div>
  </div>
  <div class="a-card lg:col-span-2">
    <div class="a-card-head"><span class="a-card-title">پیش‌نمایش فعلی در نتایج گوگل</span></div>
    <div class="a-card-body">
      <div class="a-seo-preview">
        <div class="a-seo-url a-ltr">@(Request.Host.Host + subject.Path)</div>
        <div class="a-seo-title">@SeoEngineUi.FullTitle(subject.EffectiveTitle, a.SiteName)</div>
        <div class="a-seo-desc">@subject.EffectiveDescription</div>
      </div>
      <p class="a-help mt-2">
        عنوان کامل @Format.Number(subject.EffectiveTitle.Length + a.TitleSuffixLength) نویسه (بهترین: تا ۶۰) ·
        توضیحات @Format.Number(subject.EffectiveDescription.Length) نویسه (بهترین: ۱۲۰ تا ۱۶۰)
      </p>
    </div>
  </div>
</div>

<div class="a-card mb-4">
  <div class="a-card-head"><span class="a-card-title">@Icons.Svg("Globe", null, 18) پیش‌نمایش اشتراک در تلگرام، واتس‌اپ و شبکه‌های اجتماعی</span></div>
  <div class="a-card-body"><partial name="_SharePreview" model="Model.Share" /></div>
</div>

<div class="grid gap-4 lg:grid-cols-3">
  <div class="lg:col-span-2 a-stack">
    @foreach (var group in groups)
    {
      <div class="a-card">
        <div class="a-card-head">
          <span class="a-card-title">@group.Key</span>
          <span class="a-muted text-xs">@Format.Number(group.Count(x => x.Level == SeoCheckLevel.Good)) از @Format.Number(group.Count(x => x.Level != SeoCheckLevel.Info)) خوب</span>
        </div>
        <ul class="a-checks">
          @foreach (var check in group.OrderByDescending(x => x.Level == SeoCheckLevel.Bad).ThenByDescending(x => x.Level == SeoCheckLevel.Ok))
          {
            <li>
              <span class="a-badge @SeoEngineUi.LevelBadge(check.Level)" title="@SeoEngineUi.LevelTitle(check.Level)">@Icons.Svg(SeoEngineUi.LevelIcon(check.Level), null, 14)</span>
              <span class="flex-1">@check.Message</span>
              @if (check.Level is SeoCheckLevel.Bad or SeoCheckLevel.Ok)
              {
                @if (check.Fix == SeoFields.None)
                {
                  <span class="a-badge a-badge-yellow" title="این مورد را فقط انسان می‌تواند درست کند">کار انسانی</span>
                }
                else
                {
                  <span class="a-badge a-badge-sky" title="موتور در پیشنهادش این را درست می‌کند">@SeoEngineUi.FieldTitle(check.Fix)</span>
                }
              }
            </li>
          }
        </ul>
      </div>
    }
  </div>

  <div class="a-stack">
    @if (Model.GoogleQueries.Count > 0)
    {
      <div class="a-card">
        <div class="a-card-head">
          <span class="a-card-title">@Icons.Svg("MagnifyingGlass", null, 18) عبارت‌های واقعی گوگل</span>
          <a class="a-link text-xs" href="/admin/seo/search-console">Search Console</a>
        </div>
        <ul class="a-checks">
          @foreach (var q in Model.GoogleQueries)
          {
            <li class="flex-col items-start">
              <div class="flex w-full items-center justify-between gap-2">
                <b>@q.Query</b>
                <span class="a-badge a-badge-gray" title="جایگاه میانگین">جایگاه @SearchConsoleModel.Position(q.Position)</span>
              </div>
              <div class="a-muted text-xs">@Format.Number(q.Impressions) نمایش · @Format.Number(q.Clicks) کلیک · نرخ کلیک @SearchConsoleModel.Percent(q.Ctr)</div>
            </li>
          }
        </ul>
        <div class="a-card-body"><p class="a-help">۲۸ روز اخیر. موتور سئو هنگام انتخاب کلمهٔ کلیدی به این عبارت‌ها وزن زیادی می‌دهد.</p></div>
      </div>
    }
    <div class="a-card">
      <div class="a-card-head"><span class="a-card-title">کلمه‌های کلیدی نامزد</span></div>
      @if (a.Keywords.Count == 0)
      {
        <div class="a-empty">نامزدی پیدا نشد.</div>
      }
      else
      {
        <ul class="a-checks">
          @foreach (var kw in a.Keywords)
          {
            <li class="flex-col items-start">
              <div class="flex w-full items-center justify-between gap-2"><b>@kw.Phrase</b><span class="a-badge a-badge-gray">@kw.Score.ToString("0.#")</span></div>
              @if (kw.Reasons.Count > 0) { <div class="a-muted text-xs">@(string.Join("، ", kw.Reasons))</div> }
            </li>
          }
        </ul>
        <div class="a-card-body"><p class="a-help">امتیاز از جست‌وجوهای داخلی سایت، پیشنهادهای گوگل/بینگ و عنوان صفحه‌های برتر (کش‌شده) حساب می‌شود.</p></div>
      }
    </div>

    <div class="a-card">
      <div class="a-card-head"><span class="a-card-title">تاریخچهٔ پیشنهادها</span></div>
      @if (a.History.Count == 0)
      {
        <div class="a-empty">هنوز پیشنهادی برای این صفحه ساخته نشده است.</div>
      }
      else
      {
        <ul class="a-checks">
          @foreach (var h in a.History)
          {
            <li>
              <span class="a-badge @SeoEngineUi.StatusBadge(h.Status)">@SeoEngineUi.StatusTitle(h.Status)</span>
              <span class="flex-1 text-sm">@Format.Number(h.ScoreBefore) ← @Format.Number(h.ScoreAfter) <span class="a-muted text-xs">· @AdminUi.Ago(h.CreatedAt)</span></span>
              @if (h.Status == SeoSuggestionStatus.Pending)
              {
                <a class="a-link text-xs" href="/admin/seo/review?focus=@h.Id">بررسی</a>
              }
            </li>
          }
        </ul>
      }
    </div>
  </div>
</div>
