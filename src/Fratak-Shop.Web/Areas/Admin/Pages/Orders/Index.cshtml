@page "/admin/orders"
@model Fratak_Shop.Web.Areas.Admin.Pages.Orders.IndexModel
@{
    string QueryUrl(object overrides)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(HttpContext.Request.QueryString.Value ?? string.Empty)
            .ToDictionary(item => item.Key, item => item.Value.ToString());
        foreach (var property in overrides.GetType().GetProperties())
        {
            var value = property.GetValue(overrides)?.ToString();
            if (string.IsNullOrWhiteSpace(value) || value == "False")
                query.Remove(property.Name);
            else
                query[property.Name] = value;
        }
        query.Remove("page");
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/admin/orders", query);
    }
}

<div class="mb-5 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="stat-card">
        <span class="stat-icon @Ui.StatTile("sky")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M230.14,58.87A8,8,0,0,0,224,56H62.68L56.6,22.57A8,8,0,0,0,48.73,16H24a8,8,0,0,0,0,16h18L67.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,160,204a28,28,0,1,0,28-28H91.17a8,8,0,0,1-7.87-6.57L80.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,230.14,58.87Z"></path></svg>
        </span>
        <div>
            <p class="stat-value">@Model.Stats.TotalOrders.ToString("N0")</p>
            <p class="stat-label">کل سفارش‌ها</p>
        </div>
    </div>
    <div class="stat-card">
        <span class="stat-icon @Ui.StatTile("amber")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Z"></path></svg>
        </span>
        <div>
            <p class="stat-value">@Model.Stats.PendingOrders.ToString("N0")</p>
            <p class="stat-label">در انتظار پرداخت</p>
        </div>
    </div>
    <div class="stat-card">
        <span class="stat-icon @Ui.StatTile("green")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm49.14,82.34-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L116,145.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z"></path></svg>
        </span>
        <div>
            <p class="stat-value">@Model.Stats.TodayRevenue.ToToman()</p>
            <p class="stat-label">فروش امروز</p>
        </div>
    </div>
    <a class="stat-card hover:border-sky-300" href="/admin/payments/bank-transfers">
        <span class="stat-icon @Ui.StatTile("red")">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M216,48H40A16,16,0,0,0,24,64V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V64A16,16,0,0,0,216,48Z"></path></svg>
        </span>
        <div>
            <p class="stat-value">@Model.Stats.AwaitingBankTransferReview.ToString("N0")</p>
            <p class="stat-label">فیش در انتظار بررسی</p>
        </div>
    </a>
</div>

<div class="card mb-5 p-4">
    <form method="get" action="/admin/orders" class="grid gap-3 md:grid-cols-4">
        <div>
            <label class="form-label" for="q">جستجو</label>
            <input class="form-input" id="q" name="q" value="@Model.Search" placeholder="شماره سفارش، نام یا موبایل" />
        </div>
        <div>
            <label class="form-label" for="status">وضعیت سفارش</label>
            <select class="form-input" id="status" name="status">
                <option value="">همه</option>
                @foreach (var status in Enum.GetValues<OrderStatus>())
                {
                    if (status == OrderStatus.None) { continue; }
                    <option value="@status" selected="@(Model.Status == status)">@Ui.OrderStatusTitle(status)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label" for="paymentStatus">وضعیت پرداخت</label>
            <select class="form-input" id="paymentStatus" name="paymentStatus">
                <option value="">همه</option>
                @foreach (var status in Enum.GetValues<PaymentStatus>())
                {
                    if (status == PaymentStatus.None) { continue; }
                    <option value="@status" selected="@(Model.PaymentStatusFilter == status)">@Ui.PaymentStatusTitle(status)</option>
                }
            </select>
        </div>
        <div class="flex items-end gap-2">
            <button type="submit" class="btn-primary flex-1">اعمال فیلتر</button>
            <a class="btn-secondary" href="@QueryUrl(new { pendingReview = true })">در انتظار بررسی</a>
        </div>
    </form>
</div>

<div class="card overflow-hidden">
    <div class="overflow-x-auto">
        <table class="table-admin w-full">
            <thead>
                <tr>
                    <th>سفارش</th>
                    <th>مشتری</th>
                    <th>مبلغ</th>
                    <th>پرداخت</th>
                    <th>وضعیت</th>
                    <th>تاریخ</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Result.Data.Count == 0)
                {
                    <tr><td colspan="7" class="py-8 text-center text-xs text-zinc-400">سفارشی با این شرایط یافت نشد.</td></tr>
                }
                @foreach (var order in Model.Result.Data)
                {
                    <tr>
                        <td class="fa-num text-xs font-semibold text-zinc-700">@PriceHelper.ToEnglishDigits(order.OrderNumber)</td>
                        <td>
                            <span class="block text-xs text-zinc-700">@order.CustomerName</span>
                            <span class="block text-[10px] text-zinc-400 fa-num">@PriceHelper.ToPersianDigits(order.CustomerPhone)</span>
                        </td>
                        <td class="text-xs font-semibold text-zinc-700">@order.PayableAmount.ToToman()</td>
                        <td>
                            <span class="badge @Ui.PaymentStatusClass(order.PaymentStatus)">@Ui.PaymentStatusTitle(order.PaymentStatus)</span>
                            <span class="mt-1 block text-[10px] text-zinc-400">@Ui.PaymentMethodTitle(order.PaymentMethod)</span>
                        </td>
                        <td><span class="badge @Ui.OrderStatusClass(order.Status)">@Ui.OrderStatusTitle(order.Status)</span></td>
                        <td class="text-[11px] text-zinc-500">@order.CreatedAt.ToPersianDateTime()</td>
                        <td><a class="text-xs text-sky-600" href="/admin/orders/detail/@order.Id">مدیریت</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model.Result" />
