@page "/admin/orders/board"
@model Fratak_Shop.Web.Areas.Admin.Pages.Orders.BoardModel
@*
  کانبان سفارش‌ها. کشیدن و رها کردن با Pointer Events در admin-orders.js ([data-order-board]) – روی موبایل هم کار می‌کند.
  هر کارت شناسه و وضعیت فعلی را در data-* دارد؛ ستون مقصد وضعیت جدید را.
*@
@{
    ViewData["Title"] = "کانبان سفارش‌ها";
    var canMove = Model.Can(AdminPermissions.OrdersManage);
}

<div class="a-page-head">
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/admin/orders" class="a-icon-btn" aria-label="بازگشت">@Icons.Svg("ArrowLeft", "rotate-180", 20)</a>
      <h2>کانبان سفارش‌ها</h2>
    </div>
    <p class="a-muted text-sm mt-1">
      @(canMove ? "کارت را به ستون بعد بکشید تا وضعیت سفارش عوض شود (مشتری خبردار می‌شود). برای لغو، ثبت فاکتور یا کد رهگیری، روی سفارش بزنید." : "نمای فقط‌خواندنی؛ برای جابه‌جایی کارت‌ها دسترسی «مدیریت سفارش‌ها» لازم است.")
    </p>
  </div>
  <div class="a-btn-group">
    <a href="/admin/orders?sla=overdue" class="a-btn a-btn-danger-soft">@Icons.Svg("Siren", null, 16) دیرکردها</a>
    <a href="/admin/orders" class="a-btn a-btn-light">فهرست سفارش‌ها</a>
  </div>
</div>

<div class="a-board" data-order-board="@(canMove ? "move" : "")" data-move-url="/admin/orders/board?handler=Move">
  @foreach (var col in Model.Columns)
  {
    <section class="a-board-col" data-board-column="@col.Status" aria-label="@col.Title">
      <div class="a-board-head">
        <span>@col.Title</span>
        <span class="a-badge a-badge-gray" data-board-count>@Format.Number(col.Total)</span>
      </div>
      <div class="a-board-list" data-board-list>
        @foreach (var o in col.Rows)
        {
          var missingInvoice = Model.RequiresInvoice && o.PurchaseInvoiceCount == 0 && o.Status is OrderStatus.Confirmed or OrderStatus.Processing;
          <article class="a-board-card" data-board-card="@o.Id" data-status="@o.Status" tabindex="0">
            <div class="flex items-center justify-between gap-2">
              <a class="a-link a-ltr font-bold" href="/admin/orders/@o.Id" data-board-link>@o.OrderNumber</a>
              <span class="num text-xs">@Format.Price(o.PayableAmount)</span>
            </div>
            <div class="mt-1">@o.CustomerName <span class="a-muted text-xs">· @o.ShippingCity</span></div>
            <div class="mt-2 flex flex-wrap items-center gap-1">
              <span class="a-badge @AdminUi.PaymentStatusBadge(o.PaymentStatus)">@Display.PaymentStatus(o.PaymentStatus)</span>
              @if (Model.SlaMap.TryGetValue(o.Id, out var slaRow))
              {
                <partial name="_SlaBadge" model="slaRow" />
              }
              @if (missingInvoice)
              {
                <span class="a-badge a-badge-red">بدون فاکتور</span>
              }
              @if (o.CreatedByStaffName is not null)
              {
                <span class="a-badge a-badge-purple">پنل</span>
              }
            </div>
            <div class="a-muted text-xs mt-1">@Format.DateTime(o.CreatedAt) · @Format.Number(o.ItemCount) کالا</div>
          </article>
        }
        @if (col.Rows.Count == 0)
        {
          <div class="a-empty text-sm" data-board-empty>خالی</div>
        }
      </div>
      @if (col.Total > col.Rows.Count)
      {
        <a class="a-list-foot a-link text-sm p-3" href="/admin/orders?status=@col.Status">+ @Format.Number(col.Total - col.Rows.Count) سفارش دیگر</a>
      }
    </section>
  }
</div>
