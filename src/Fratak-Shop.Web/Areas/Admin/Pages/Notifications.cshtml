@page "/admin/notifications"
@model Fratak_Shop.Web.Areas.Admin.Pages.NotificationsModel
@{
}

<div class="grid gap-6 lg:grid-cols-12">
    <div class="card overflow-hidden lg:col-span-7">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 px-5 py-4">
            <h1 class="text-sm font-bold text-zinc-800">اعلان‌ها</h1>
            <form method="get" action="/admin/notifications" class="flex items-center gap-2">
                <input class="form-input w-36 py-1.5 text-xs" name="q" value="@Model.Search" placeholder="جستجو..." />
                <select class="form-input w-32 py-1.5 text-xs" name="type" onchange="this.form.submit()">
                    <option value="">همه انواع</option>
                    @foreach (var type in Fratak_Shop.Web.Areas.Admin.Pages.NotificationsModel.Types)
                    {
                        <option value="@type" selected="@(Model.Type == type)">@type</option>
                    }
                </select>
                <button type="submit" class="btn-secondary px-4 py-1.5 text-xs">فیلتر</button>
            </form>
        </div>

        <div class="divide-y divide-zinc-100">
            @if (Model.Result.Data.Count == 0)
            {
                <p class="py-10 text-center text-xs text-zinc-400">اعلانی یافت نشد.</p>
            }
            @foreach (var item in Model.Result.Data)
            {
                <article class="flex flex-wrap items-start justify-between gap-3 p-5">
                    <div class="flex-1">
                        <div class="flex flex-wrap items-center gap-x-2">
                            <span class="badge @Ui.NotificationClass(item.Type)">@item.Type</span>
                            @if (item.IsBroadcast)
                            {
                                <span class="badge badge-sky">همگانی</span>
                            }
                            @if (!item.IsRead && !item.IsBroadcast)
                            {
                                <span class="badge badge-amber">خوانده‌نشده</span>
                            }
                        </div>
                        <p class="mt-2 text-xs font-semibold text-zinc-800">@item.Title</p>
                        @if (!string.IsNullOrWhiteSpace(item.Message))
                        {
                            <p class="mt-1 text-[11px] leading-6 text-zinc-500">@item.Message</p>
                        }
                        <p class="mt-1 text-[11px] text-zinc-400">
                            @(item.IsBroadcast ? "همه کاربران" : item.UserFullName ?? item.UserPhoneNumber ?? "—") — @item.CreatedAt.ToPersianDateTime()
                        </p>
                    </div>
                    <div class="flex items-center gap-x-2">
                        @if (!string.IsNullOrWhiteSpace(item.Url))
                        {
                            <a class="text-xs text-sky-600" href="@item.Url">مشاهده</a>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" data-confirm="این اعلان حذف شود؟">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-xs text-rose-500">حذف</button>
                        </form>
                    </div>
                </article>
            }
        </div>

        <partial name="_Pagination" model="Model.Result" />
    </div>

    <div class="lg:col-span-5">
        <div class="card sticky top-24 p-5">
            <h2 class="section-title">ارسال اعلان همگانی</h2>
            <form method="post" asp-page-handler="Broadcast" class="grid gap-4">
                @Html.AntiForgeryToken()
                <div>
                    <label class="form-label" asp-for="Broadcast.Title">عنوان</label>
                    <input class="form-input" asp-for="Broadcast.Title" />
                    <span class="form-error" asp-validation-for="Broadcast.Title"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Broadcast.Message">متن اعلان</label>
                    <textarea class="form-input" asp-for="Broadcast.Message" rows="4"></textarea>
                </div>
                <div>
                    <label class="form-label" asp-for="Broadcast.Url">لینک مقصد (اختیاری)</label>
                    <input class="form-input text-left" dir="ltr" asp-for="Broadcast.Url" placeholder="/products" />
                </div>
                <div>
                    <label class="form-label" asp-for="Broadcast.Type">نوع اعلان</label>
                    <select class="form-input" asp-for="Broadcast.Type">
                        @foreach (var type in Fratak_Shop.Web.Areas.Admin.Pages.NotificationsModel.Types)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn-primary w-full text-xs">ارسال به همه کاربران</button>
                <p class="text-[11px] text-zinc-400">اعلان همگانی در پنل کاربری همه مشتریان نمایش داده می‌شود.</p>
            </form>
        </div>
    </div>
</div>
