@inject AdminBadgeService BadgeService
@inject IStaffNotificationService StaffNotifications
@inject IAdminShortcutService Shortcuts
@inject IAdminHelpService HelpArticles
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Fratak_Shop.Core.Services.Settings.IStoreSettingService StoreSettings
@inject Fratak_Shop.Core.Services.Team.IApprovalService ApprovalRequests
@inject Fratak_Shop.Core.Services.Team.IStaffTaskService StaffTasks
@{
    var access = ViewContext.HttpContext.Items[AdminPageFilter.AccessItemKey] as AdminAccess;
    var badges = access is null ? new Dictionary<string, int>() : new Dictionary<string, int>(await BadgeService.GetAsync());
    // فاز ۱۰: شمارنده‌های شخصی (تأییدهای منتظر من، کارهای دیرشده/امروز من) کنار شمارنده‌های عمومی.
    if (access is not null)
    {
        foreach (var (badgeKey, badgeValue) in await BadgeService.GetPersonalAsync(access, ApprovalRequests, StaffTasks)) { badges[badgeKey] = badgeValue; }
    }
    // منوی زنگوله: ۸ اعلان آخر + تعداد خوانده‌نشده‌ها (live.js آن را زنده به‌روز می‌کند).
    List<StaffNotificationDto> bellItems = access is null ? [] : await StaffNotifications.GetLatestAsync(access.UserId, 8);
    var bellUnread = access is null ? 0 : await StaffNotifications.GetUnreadCountAsync(access.UserId);
    var path = (ViewContext.HttpContext.Request.Path.Value ?? "/admin").TrimEnd('/').ToLowerInvariant();
    if (path.Length == 0) { path = "/admin"; }
    var title = ViewData["Title"] as string ?? "پنل مدیریت";
    // The most specific menu item that matches the current address is highlighted.
    var activeUrl = AdminNav.Groups.SelectMany(g => g.Items)
        .Where(i => path == i.Url || (i.Url != "/admin" && path.StartsWith(i.Url + "/")))
        .OrderByDescending(i => i.Url.Length).Select(i => i.Url).FirstOrDefault() ?? "/admin";

    // ── ابزارهای رابط کاربری (مرحلهٔ هفتم – P2) ──
    // سنجاق‌ها، صفحه‌های اخیر و فیلترهای ذخیره‌شدهٔ همین صفحه از تنظیمات شخصی کارمند خوانده می‌شوند (کش ۱۰ دقیقه‌ای).
    var http = ViewContext.HttpContext;
    var currentUrl = (http.Request.Path.Value ?? "/admin") + http.Request.QueryString.Value;
    List<PinItem> pins = access is null ? [] : await Shortcuts.GetPinsAsync(access.UserId);
    List<RecentItem> recents = access is null ? [] : await Shortcuts.GetRecentsAsync(access.UserId);
    List<SavedFilter> savedFilters = access is null ? [] : await Shortcuts.GetFiltersAsync(access.UserId, path);
    var isPinned = pins.Any(p => string.Equals(p.Url, currentUrl, StringComparison.OrdinalIgnoreCase));
    var activeIcon = AdminNav.Groups.SelectMany(g => g.Items).FirstOrDefault(i => i.Url == activeUrl)?.Icon ?? "PushPin";
    var help = access is null ? null : await HelpArticles.GetForPathAsync(path);
    var canEditHelp = access?.Has(AdminPermissions.SettingsManage) == true;
    // تم تیره/روشن از کوکی خوانده می‌شود تا بدون اسکریپت درون‌خطی (CSP) و بدون چشمک زدن اعمال شود.
    var theme = http.Request.Cookies["fratak_admin_theme"] == "dark" ? "dark" : "light";
    // توکن ضد جعل برای درخواست‌های fetch (admin-ux.js و editor.js آن را در هدر RequestVerificationToken می‌فرستند).
    var csrfToken = access is null ? "" : Antiforgery.GetAndStoreTokens(http).RequestToken;
    // ثبت صفحهٔ اخیر: فقط درخواست‌های GET موفق؛ خود صفحهٔ میانبرها ثبت نمی‌شود.
    if (access is not null && Microsoft.AspNetCore.Http.HttpMethods.IsGet(http.Request.Method) && http.Response.StatusCode == 200 && path != "/admin/ux")
    {
        await Shortcuts.TrackRecentAsync(access.UserId, http.Request.Path.Value ?? "/admin", title);
    }
    var jsonOptions = new global::System.Text.Json.JsonSerializerOptions(global::System.Text.Json.JsonSerializerDefaults.Web);
    var paletteJson = global::System.Text.Json.JsonSerializer.Serialize(new
    {
        pins = pins.Select(p => new { url = p.Url, title = p.Title }),
        recents = recents.Select(r => new { url = r.Url, title = r.Title }),
    }, jsonOptions);
    var filtersJson = global::System.Text.Json.JsonSerializer.Serialize(savedFilters.Select(f => new { name = f.Name, query = f.Query }), jsonOptions);
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="@theme">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="same-origin">
  <meta name="csrf-token" content="@csrfToken">
  @if (access is not null && access.HasAny(Fratak_Shop.Web.Infrastructure.SeoEngine.SmartUi.Permissions))
  {
    @* دکمه‌های «پیشنهاد هوشمند» و «سئوی هوشمند» (smart.js) فقط برای کارمندانی که حداقل یکی از مجوزهای محتوا را دارند. *@
    <meta name="fratak-smart" content="/admin/seo/smart">
  }
  <meta name="color-scheme" content="@(theme == "dark" ? "dark" : "light")">
  <title>@title | مدیریت @Site.Settings.SiteName</title>
  <partial name="_BrandHead" />
  <link rel="stylesheet" href="~/assets/css/output.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/font.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/admin.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/fa-inputs.css" asp-append-version="true">
  @await RenderSectionAsync("Head", required: false)
</head>
<body class="a-body" data-realtime="@(access is null ? "0" : "1")" data-palette="@paletteJson">
  <div class="a-shell">
    <aside class="a-sidebar" id="admin-sidebar" data-sidebar>
      <div class="a-sidebar-head">
        <a href="/admin" class="a-brand" aria-label="پنل مدیریت @Site.Settings.SiteName">
          @* مرحلهٔ دوازدهم: آیکون تیره + متن برند با اندازه‌ها و فاصله‌های «استودیوی لوگو» برای محل «پنل مدیریت». *@
          @await Html.PartialAsync("~/Pages/Shared/_BrandLockup.cshtml", new BrandLockupModel(BrandPlace.Admin))
        </a>
        <button type="button" class="a-icon-btn lg:hidden" data-sidebar-close aria-label="بستن منو">@Icons.Svg("Close", null, 20)</button>
      </div>
      @* دور ۲۳: جست‌وجوی منو (بدون بارگذاری صفحه؛ admin-nav.js) – با تایپ «سفارش» فقط لینک‌های مرتبط می‌مانند. *@
      <div class="a-nav-search">
        <input type="search" class="a-input a-input-sm" placeholder="جست‌وجو در منو…" aria-label="جست‌وجو در منو" data-nav-search autocomplete="off">
      </div>
      <nav class="a-nav" aria-label="منوی مدیریت">
        @if (pins.Count > 0)
        {
          <div class="a-nav-group">سنجاق‌شده‌ها</div>
          foreach (var pin in pins)
          {
            <a href="@pin.Url" class="a-nav-link @(string.Equals(pin.Url, currentUrl, StringComparison.OrdinalIgnoreCase) ? "is-active" : "")">
              @Icons.Svg(pin.Icon, "shrink-0", 20)
              <span class="flex-1 truncate">@pin.Title</span>
            </a>
          }
        }
        @foreach (var group in AdminNav.Groups)
        {
          var items = access is null ? Array.Empty<AdminNavItem>() : group.Items.Where(i => i.IsVisible(access)).ToArray();
          if (items.Length == 0) { continue; }
          // دور ۲۳: گروه‌های تاشو؛ گروه صفحهٔ فعلی همیشه باز است و بقیه طبق انتخاب قبلی کارمند (localStorage) باز/بسته می‌شوند.
          var hasActive = items.Any(i => i.Url == activeUrl);
          var groupBadges = items.Sum(i => i.BadgeKey is not null && badges.TryGetValue(i.BadgeKey, out var gc) ? gc : 0);
          if (string.IsNullOrEmpty(group.Title))
          {
            <div class="a-nav-sec" data-nav-sec>
              @foreach (var item in items)
              {
                var count = item.BadgeKey is not null && badges.TryGetValue(item.BadgeKey, out var c0) ? c0 : 0;
                <a href="@item.Url" class="a-nav-link @(item.Url == activeUrl ? "is-active" : "")" @(item.Url == activeUrl ? "aria-current=page" : "")>
                  @Icons.Svg(item.Icon, "shrink-0", 20)
                  <span class="flex-1">@item.Title</span>
                  @if (count > 0) { <span class="a-nav-badge">@(count > 99 ? "99+" : count.ToString())</span> }
                </a>
              }
            </div>
            continue;
          }
          <details class="a-nav-sec" data-nav-sec data-nav-group="@group.Title" open="@hasActive" data-nav-active="@(hasActive ? "1" : null)">
            <summary class="a-nav-group">
              <span class="flex-1">@group.Title</span>
              @if (groupBadges > 0) { <span class="a-nav-badge" data-nav-sum>@(groupBadges > 99 ? "99+" : groupBadges.ToString())</span> }
              @Icons.Svg("CaretDown", "a-nav-caret", 14)
            </summary>
            @foreach (var item in items)
            {
              var count = item.BadgeKey is not null && badges.TryGetValue(item.BadgeKey, out var c) ? c : 0;
              <a href="@item.Url" class="a-nav-link @(item.Url == activeUrl ? "is-active" : "")" @(item.Url == activeUrl ? "aria-current=page" : "")>
                @Icons.Svg(item.Icon, "shrink-0", 20)
                <span class="flex-1">@item.Title</span>
                @if (count > 0)
                {
                  <span class="a-nav-badge">@(count > 99 ? "99+" : count.ToString())</span>
                }
              </a>
            }
          </details>
        }
        <p class="a-nav-empty" data-nav-empty hidden>چیزی پیدا نشد.</p>
      </nav>
      <div class="a-sidebar-foot">
        <a href="/" class="a-nav-link" target="_blank" rel="noopener">@Icons.Svg("ArrowSquareOut", "shrink-0", 20)<span>مشاهده فروشگاه</span></a>
      </div>
    </aside>
    <div class="a-backdrop" data-sidebar-close></div>

    <div class="a-main">
      <header class="a-topbar">
        <button type="button" class="a-icon-btn lg:hidden" data-sidebar-open aria-controls="admin-sidebar" aria-label="باز کردن منو">@Icons.Svg("List", null, 22)</button>
        <h1 class="a-topbar-title">@title</h1>
        @if (access is not null)
        {
          <button type="button" class="a-icon-btn a-pin-btn @(isPinned ? "is-pinned" : "")" data-pin data-pin-url="@currentUrl" data-pin-title="@title" data-pin-icon="@activeIcon"
                  aria-pressed="@(isPinned ? "true" : "false")" aria-label="سنجاق کردن این صفحه" title="سنجاق کردن این صفحه">@Icons.Svg("Star", null, 20)</button>
          <button type="button" class="a-quick-search hidden md:flex" data-palette-open aria-label="جست‌وجوی سریع">
            @Icons.Svg("MagnifyingGlass", "text-gray-400", 18)
            <span class="flex-1 text-start a-muted">جست‌وجو در سفارش، مشتری، محصول، صفحه…</span>
            <kbd class="a-kbd">Ctrl K</kbd>
          </button>
          <button type="button" class="a-icon-btn md:hidden" data-palette-open aria-label="جست‌وجوی سریع">@Icons.Svg("MagnifyingGlass", null, 22)</button>
          @if (help is not null || canEditHelp)
          {
            <button type="button" class="a-icon-btn" data-help-open aria-controls="admin-help" aria-label="راهنمای این صفحه" title="راهنمای این صفحه">@Icons.Svg("Question", null, 22)</button>
          }
          @* فاز ۱۰: ساخت سریع «کار» با لینک همین صفحه. *@
          <a class="a-icon-btn hidden sm:inline-flex" href="/admin/tasks?new=1&amp;url=@Uri.EscapeDataString(currentUrl)&amp;title=@Uri.EscapeDataString(title)" aria-label="افزودن کار برای این صفحه" title="افزودن به کارهای من">@Icons.Svg("ListChecks", null, 20)</a>
          <button type="button" class="a-icon-btn hidden sm:inline-flex" data-theme-toggle aria-label="تغییر حالت تیره و روشن" title="حالت تیره / روشن">
            <span class="a-theme-dark">@Icons.Svg("Moon", null, 20)</span><span class="a-theme-light">@Icons.Svg("Sun", null, 20)</span>
          </button>
        }
        <div class="a-bell" data-dropdown>
          <button type="button" class="a-icon-btn relative" data-dropdown-toggle aria-haspopup="true" aria-expanded="false" aria-label="اعلان‌های من">
            @Icons.Svg("Bell", null, 22)
            <span class="a-bell-count" data-live-count="staff" data-value="@bellUnread" hidden="@(bellUnread <= 0)">@(bellUnread > 99 ? "99+" : bellUnread.ToString())</span>
          </button>
          <div class="a-dropdown a-bell-menu" data-dropdown-menu hidden>
            <div class="a-bell-head">
              <strong>اعلان‌ها</strong>
              <a href="/admin/inbox" class="text-xs text-sky-600 hover:underline">مشاهدهٔ همه</a>
            </div>
            <div class="a-bell-list" data-staff-list>
              @if (bellItems.Count == 0)
              {
                <p class="a-bell-empty" data-staff-empty>اعلان تازه‌ای ندارید.</p>
              }
              @foreach (var n in bellItems)
              {
                <a class="a-bell-item @(n.IsRead ? "" : "is-unread")" href="/admin/inbox?open=@n.Id">
                  <span class="a-bell-title">@n.Title</span>
                  <span class="a-bell-meta">@(string.IsNullOrEmpty(n.Body) ? "" : n.Body + " · ")@Format.Relative(n.CreatedAt)</span>
                </a>
              }
            </div>
            <div class="a-bell-foot">
              <button type="button" class="a-dropdown-item" data-sound-toggle aria-pressed="true">@Icons.Svg("SpeakerHigh", null, 18) <span data-sound-label>صدای اعلان</span></button>
              <button type="button" class="a-dropdown-item" data-push-enable>@Icons.Svg("BellRinging", null, 18) <span data-push-label>اعلان مرورگر</span></button>
            </div>
          </div>
        </div>
        <div class="a-user" data-dropdown>
          <button type="button" class="a-user-btn" data-dropdown-toggle aria-haspopup="true" aria-expanded="false">
            @Icons.Svg("UserCircle", null, 24)
            <span class="hidden sm:inline max-w-36 truncate">@(access?.DisplayName ?? "")</span>
            @Icons.Svg("CaretDown", null, 14)
          </button>
          <div class="a-dropdown" data-dropdown-menu hidden>
            <div class="px-3 py-2 text-xs text-gray-500 border-b border-gray-100">
              @if (access?.IsOwner == true)
              {
                <span class="a-badge a-badge-purple">مالک فروشگاه</span>
              }
              else
              {
                @string.Join("، ", access?.RoleNames ?? [])
              }
            </div>
            <a href="/admin/account" class="a-dropdown-item">@Icons.Svg("ShieldCheck", null, 18) امنیت حساب من</a>
            <a href="/admin/tasks" class="a-dropdown-item">@Icons.Svg("ListChecks", null, 18) کارهای من</a>
            <a href="/profile" class="a-dropdown-item">@Icons.Svg("User", null, 18) حساب کاربری من</a>
            <a href="/admin/ux" class="a-dropdown-item">@Icons.Svg("PushPin", null, 18) میانبرهای من</a>
            <button type="button" class="a-dropdown-item w-full sm:hidden" data-theme-toggle>@Icons.Svg("Moon", null, 18) حالت تیره / روشن</button>
            <a href="/" class="a-dropdown-item">@Icons.Svg("Storefront", null, 18) فروشگاه</a>
            <form method="post" action="/logout" class="m-0" asp-antiforgery="true">
              <button type="submit" class="a-dropdown-item w-full text-red-600">@Icons.Svg("SignOut", null, 18) خروج</button>
            </form>
          </div>
        </div>
      </header>

      <partial name="_AdminStatus" />

      @* فاز ۹: یادآوری روشن بودن حالت تعمیرات (بازدیدکنندگان سایت را نمی‌بینند). *@
      @if (access is not null && (await StoreSettings.GetAsync()).IsMaintenanceMode)
      {
        <div class="a-alert a-alert-warn mx-4 mt-3 lg:mx-6">
          @Icons.Svg("Wrench", "shrink-0", 20)
          <div class="flex-1"><b>حالت تعمیرات روشن است.</b> بازدیدکنندگان صفحهٔ «در حال به‌روزرسانی» می‌بینند؛ شما و کارکنان واردشده سایت را عادی می‌بینید.</div>
          @if (access.Has(AdminPermissions.SettingsManage)) { <a class="a-btn a-btn-xs a-btn-light" href="/admin/settings?tab=ops">خاموش کردن</a> }
        </div>
      }

      <main class="a-content" id="main" data-amount-words data-saved-filters="@filtersJson" data-filter-path="@path">
        @RenderBody()
      </main>
    </div>
  </div>

  @if (access is not null)
  {
    @* نوار پایین موبایل: دسترسی سریع با شست به پرکاربردترین بخش‌ها. *@
    <nav class="a-bottom-nav lg:hidden" aria-label="دسترسی سریع">
      <a href="/admin" class="@(activeUrl == "/admin" ? "is-active" : "")">@Icons.Svg("SquaresFour", null, 22)<span>داشبورد</span></a>
      @if (access.Has(AdminPermissions.OrdersView))
      {
        <a href="/admin/orders" class="@(activeUrl == "/admin/orders" ? "is-active" : "")">@Icons.Svg("Orders", null, 22)<span>سفارش‌ها</span></a>
      }
      <button type="button" data-palette-open>@Icons.Svg("MagnifyingGlass", null, 22)<span>جست‌وجو</span></button>
      <a href="/admin/inbox" class="@(activeUrl == "/admin/inbox" ? "is-active" : "")">@Icons.Svg("Tray", null, 22)<span>اعلان‌ها</span></a>
      <button type="button" data-sidebar-open aria-controls="admin-sidebar">@Icons.Svg("List", null, 22)<span>منو</span></button>
    </nav>

    @* کشوی راهنمای صفحه (admin-ux.js باز و بسته‌اش می‌کند؛ کلید Esc یا کلیک بیرون می‌بندد). *@
    <div class="a-drawer" id="admin-help" data-help-drawer hidden>
      <div class="a-drawer-backdrop" data-help-close></div>
      <aside class="a-drawer-panel" role="dialog" aria-modal="true" aria-labelledby="admin-help-title">
        <div class="a-drawer-head">
          <h2 id="admin-help-title">@Icons.Svg("Question", null, 20) @(help?.Title ?? "راهنما")</h2>
          <button type="button" class="a-icon-btn" data-help-close aria-label="بستن راهنما">@Icons.Svg("Close", null, 20)</button>
        </div>
        <div class="a-drawer-body a-prose">
          @if (help is not null)
          {
            @Html.Raw(help.Body)
          }
          else
          {
            <p class="a-muted">برای این صفحه هنوز راهنمایی نوشته نشده است.</p>
          }
        </div>
        @if (canEditHelp)
        {
          <div class="a-drawer-foot">
            <a class="a-btn a-btn-light a-btn-sm" href="@(help is null ? "/admin/help?new=true&path=" + Uri.EscapeDataString(path) : "/admin/help?id=" + help.Id)">@Icons.Svg("PencilSimple", null, 16) @(help is null ? "نوشتن راهنما" : "ویرایش این راهنما")</a>
          </div>
        }
      </aside>
    </div>
  }

  <script src="~/assets/js/modal.js" asp-append-version="true"></script>
  <script src="~/assets/js/lightbox.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin-gallery.js" asp-append-version="true"></script>
  <script src="~/assets/js/upload-webp.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin.js" asp-append-version="true"></script>
  <script src="~/assets/js/dependencies/signalr/signalr.min.js" asp-append-version="true"></script>
  <script src="~/assets/js/live.js" asp-append-version="true"></script>
  <script src="~/assets/js/fa-inputs.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin-ux.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin-nav.js" asp-append-version="true"></script>
  <script src="~/assets/js/editor.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin-tables.js" asp-append-version="true"></script>
  <script src="~/assets/js/table-align.js" asp-append-version="true" defer></script>
  <script src="~/assets/js/admin-edit.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin-orders.js" asp-append-version="true"></script>
  <script src="~/assets/js/admin-team.js" asp-append-version="true"></script>
  <script src="~/assets/js/smart.js" asp-append-version="true"></script>
  <script src="~/assets/js/seo-live.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
