@page "/admin/blog/categories"
@model Fratak_Shop.Web.Areas.Admin.Pages.Blog.CategoriesModel
@{
}

<div class="grid gap-6 lg:grid-cols-12">
    <div class="card overflow-hidden lg:col-span-7">
        <h2 class="border-b border-zinc-100 px-5 py-4 text-sm font-bold text-zinc-800">دسته‌بندی مقالات</h2>
        <table class="table-admin w-full">
            <thead>
                <tr>
                    <th>نام</th>
                    <th>نامک</th>
                    <th>وضعیت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="4" class="py-8 text-center text-xs text-zinc-400">دسته‌بندی‌ای ثبت نشده است.</td></tr>
                }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="text-xs text-zinc-700">@item.Name</td>
                        <td class="text-[11px] text-zinc-400" dir="ltr">@item.Slug</td>
                        <td><span class="badge @(item.IsActive ? "badge-green" : "badge-gray")">@(item.IsActive ? "فعال" : "غیرفعال")</span></td>
                        <td>
                            <div class="flex items-center gap-x-2">
                                <a class="text-xs text-sky-600" href="/admin/blog/categories?edit=@item.Id">ویرایش</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" data-confirm="این دسته حذف شود؟">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-xs text-rose-500">حذف</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="lg:col-span-5">
        <div class="card sticky top-24 p-5">
            <h2 class="section-title">@(Model.Input.Id.HasValue ? "ویرایش دسته" : "افزودن دسته")</h2>
            <form method="post" asp-page-handler="Save" class="grid gap-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Input.Id" />
                <div>
                    <label class="form-label" asp-for="Input.Name">نام دسته</label>
                    <input class="form-input" asp-for="Input.Name" />
                    <span class="form-error" asp-validation-for="Input.Name"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Slug">نامک</label>
                    <input class="form-input text-left" dir="ltr" asp-for="Input.Slug" />
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Description">توضیحات</label>
                    <textarea class="form-input" asp-for="Input.Description" rows="2"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="form-label" asp-for="Input.DisplayOrder">ترتیب</label>
                        <input class="form-input text-center" asp-for="Input.DisplayOrder" inputmode="numeric" />
                    </div>
                    <label class="flex items-end gap-x-2 pb-3 text-xs text-zinc-600">
                        <input type="checkbox" class="form-checkbox" asp-for="Input.IsActive" />
                        فعال
                    </label>
                </div>
                <details class="rounded-xl border border-zinc-100 p-3">
                    <summary class="cursor-pointer text-xs font-semibold text-zinc-700">سئو دسته</summary>
                    <div class="mt-3 flex flex-col gap-3">
                        <input class="form-input" asp-for="Input.SeoTitle" placeholder="عنوان سئو" />
                        <textarea class="form-input" asp-for="Input.SeoDescription" rows="2" placeholder="توضیحات متا"></textarea>
                    </div>
                </details>
                <button type="submit" class="btn-primary w-full text-xs">ذخیره دسته</button>
            </form>
        </div>
    </div>
</div>
