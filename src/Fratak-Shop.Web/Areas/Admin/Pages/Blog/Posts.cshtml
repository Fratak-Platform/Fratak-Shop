@page "/admin/blog/posts"
@model Fratak_Shop.Web.Areas.Admin.Pages.Blog.PostsModel

<div class="grid gap-6 lg:grid-cols-12">
    <div class="card overflow-hidden lg:col-span-7">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-100 px-5 py-4">
            <h2 class="text-sm font-bold text-zinc-800">مقالات</h2>
            <form method="get" action="/admin/blog/posts" class="flex items-center gap-2">
                <input class="form-input w-40 py-1.5 text-xs" name="q" value="@Model.Search" placeholder="جستجو..." />
                <button type="submit" class="btn-secondary px-4 py-1.5 text-xs">جستجو</button>
            </form>
        </div>
        <div class="overflow-x-auto">
            <table class="table-admin w-full">
                <thead>
                    <tr>
                        <th>عنوان</th>
                        <th>دسته</th>
                        <th>بازدید</th>
                        <th>وضعیت</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result.Data.Count == 0)
                    {
                        <tr><td colspan="5" class="py-8 text-center text-xs text-zinc-400">مقاله‌ای ثبت نشده است.</td></tr>
                    }
                    @foreach (var item in Model.Result.Data)
                    {
                        <tr>
                            <td>
                                <div class="flex items-center gap-x-2">
                                    <img class="h-9 w-12 rounded-lg object-cover" src="@Ui.BlogImage(item.ImageName)" alt="@item.Title" />
                                    <div>
                                        <span class="text-xs text-zinc-700">@item.Title</span>
                                        <span class="block text-[10px] text-zinc-400">@item.PublishedAt.ToPersianDate()</span>
                                    </div>
                                </div>
                            </td>
                            <td class="text-xs text-zinc-500">@item.CategoryPostDto?.Name</td>
                            <td class="text-xs text-zinc-500">@PriceHelper.ToPersianDigits(item.ViewCount.ToString())</td>
                            <td><span class="badge @(item.IsPublished ? "badge-green" : "badge-amber")">@(item.IsPublished ? "منتشرشده" : "پیش‌نویس")</span></td>
                            <td>
                                <div class="flex items-center gap-x-2">
                                    <a class="text-xs text-sky-600" href="/admin/blog/posts/edit?id=@item.Id">ویرایش و سئو</a>
                                    <a class="text-xs text-zinc-500" href="/blog/@item.Slug" target="_blank">مشاهده</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" data-confirm="این مقاله حذف شود؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-xs text-rose-500">حذف</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Result" />
    </div>

    <div class="lg:col-span-5">
        <div class="card sticky top-24 p-5">
            <h2 class="section-title">افزودن مقاله</h2>
            <p class="mb-4 text-[11px] text-zinc-400">پس از ثبت مقاله، برای «سئوی هوشمند» و «هوشمندسازی نوشته‌ها» روی «ویرایش و سئو» بزنید.</p>
            <form method="post" asp-page-handler="Create" enctype="multipart/form-data" class="grid gap-4">
                @Html.AntiForgeryToken()

                <div>
                    <label class="form-label" asp-for="Input.Title">عنوان مقاله</label>
                    <input class="form-input" asp-for="Input.Title" />
                    <span class="form-error" asp-validation-for="Input.Title"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.BlogCategoryId">دسته‌بندی</label>
                    <select class="form-input" asp-for="Input.BlogCategoryId">
                        <option value="">انتخاب دسته...</option>
                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </select>
                    <span class="form-error" asp-validation-for="Input.BlogCategoryId"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Excerpt">خلاصه مقاله</label>
                    <textarea class="form-input" asp-for="Input.Excerpt" rows="2" data-content-short-description></textarea>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.Content">متن مقاله (HTML مجاز)</label>
                    <textarea class="form-input" asp-for="Input.Content" rows="8" data-content-description></textarea>
                    <span class="form-error" asp-validation-for="Input.Content"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Image">تصویر شاخص</label>
                    <input class="form-input" asp-for="Image" type="file" accept="image/*" />
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ImageAlt">متن جایگزین تصویر</label>
                    <input class="form-input" asp-for="Input.ImageAlt" />
                </div>
                <label class="flex items-center gap-x-2 text-xs text-zinc-600">
                    <input type="checkbox" class="form-checkbox" asp-for="Input.IsPublished" />
                    انتشار در مجله
                </label>

                <details class="rounded-xl border border-zinc-100 p-3">
                    <summary class="cursor-pointer text-xs font-semibold text-zinc-700">تنظیمات سئو</summary>
                    <div class="mt-3 flex flex-col gap-3">
                        <input class="form-input" asp-for="Input.SeoTitle" placeholder="عنوان سئو" data-seo-title />
                        <textarea class="form-input" asp-for="Input.SeoDescription" rows="2" placeholder="توضیحات متا" data-seo-description></textarea>
                        <input class="form-input" asp-for="Input.SeoFocusKeyword" placeholder="کلمه کلیدی اصلی" />
                        <input class="form-input" asp-for="Input.SeoKeywords" placeholder="کلمات کلیدی" />
                    </div>
                </details>

                <button type="submit" class="btn-primary w-full text-xs">ثبت مقاله</button>
            </form>
        </div>
    </div>
</div>
