@page "/admin/manage/{key}"
@using Fratak_Shop.Web.Infrastructure.Admin.Manage
@model Fratak_Shop.Web.Areas.Admin.Pages.Manage.ListModel
@{
    var def = Model.Def;
    ViewData["Title"] = def.Title;
    var columns = def.Fields.Where(f => f.InList).ToList();
    var hasActive = def.Field("IsActive") is not null;
    var newUrl = $"/admin/manage/{def.Key}/edit" + (Model.Parent is { } pid ? $"?parent={pid}" : "");
}
<div class="a-page-head">
  <div>
    <h2>@def.Title <span class="a-muted text-sm font-normal">(@Format.Number(Model.List.Total))</span></h2>
    @if (Model.ParentLabel is not null)
    {
      <p class="a-muted text-sm mt-1">فیلتر: <b>@Model.ParentLabel</b> · <a class="a-link" href="/admin/manage/@def.Key">نمایش همه</a></p>
    }
    else if (def.Description is not null)
    {
      <p class="a-muted text-sm mt-1">@def.Description</p>
    }
  </div>
  <div class="a-btn-group">
    <a href="/admin/manage" class="a-btn a-btn-light">همه جدول‌ها</a>
    @if (def.CanCreate)
    {
      <a href="@newUrl" class="a-btn">@Icons.Svg("Plus", null, 18) @def.Singular جدید</a>
    }
  </div>
</div>

@if (def.Search.Length > 0)
{
  <form method="get" class="a-card a-card-body a-filters mb-4">
    @if (Model.Parent is not null) { <input type="hidden" name="parent" value="@Model.Parent"> }
    <div class="a-field" style="flex-basis:260px"><label class="a-label" for="f-q">جست‌وجو</label><input id="f-q" name="q" value="@Model.Search" class="a-input" maxlength="100"></div>
    <div class="a-filters-actions"><button class="a-btn" type="submit">جست‌وجو</button>@if (!string.IsNullOrEmpty(Model.Search)) { <a class="a-btn a-btn-light" href="/admin/manage/@def.Key">پاک کردن</a> }</div>
  </form>
}

<div class="a-card">
  <div class="a-table-wrap">
    <table class="a-table a-table-cards">
      <thead>
        <tr>
          @foreach (var c in columns) { <th>@c.Label</th> }
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var row in Model.List.Rows)
        {
          var id = ManageEngine.IdOf(row);
          <tr>
            @foreach (var c in columns)
            {
              <td data-label="@c.Label">
                @if (c.Name == "IsActive" && hasActive)
                {
                  <form method="post" asp-page-handler="Toggle" asp-route-key="@def.Key" class="inline">
                    <input type="hidden" name="id" value="@id">
                    <button type="submit" class="a-badge @(ManageEngine.Get(row, c) is true ? "a-badge-green" : "a-badge-gray")" title="تغییر وضعیت">@(ManageEngine.Get(row, c) is true ? "فعال" : "غیرفعال")</button>
                  </form>
                }
                else
                {
                  @ManageEngine.Cell(def, c, row, Model.List.RefLabels)
                }
              </td>
            }
            <td class="actions" data-label="">
              @foreach (var child in def.Children)
              {
                <a class="a-btn a-btn-light a-btn-xs" href="/admin/manage/@child.Key?parent=@id">@child.Title</a>
              }
              @if (def.PublicUrl is not null && def.Field("Slug") is { } slugField)
              {
                <a class="a-icon-btn" target="_blank" rel="noopener" href="@def.PublicUrl.Replace("{Slug}", ManageEngine.InputValue(row, slugField))" aria-label="مشاهده">@Icons.Svg("Eye", null, 18)</a>
              }
              <a class="a-icon-btn" href="/admin/manage/@def.Key/edit/@id" aria-label="ویرایش">@Icons.Svg("PencilSimple", null, 18)</a>
              @if (def.CanDelete)
              {
                <form method="post" asp-page-handler="Delete" asp-route-key="@def.Key" class="inline" data-confirm="«@def.Singular» حذف شود؟" data-confirm-danger>
                  <input type="hidden" name="id" value="@id">
                  <button type="submit" class="a-icon-btn text-red-600" aria-label="حذف">@Icons.Svg("Trash", null, 18)</button>
                </form>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
    @if (Model.List.Rows.Count == 0)
    {
      <div class="a-empty">موردی ثبت نشده است.</div>
    }
  </div>
  <partial name="_AdminPager" model="new PagerModel(Model.List.Page, Model.List.PageCount, Model.List.Total)" />
</div>
