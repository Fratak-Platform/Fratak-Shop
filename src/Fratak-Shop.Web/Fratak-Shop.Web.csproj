<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fratak_Shop.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- مرحلهٔ هفتم: اجرای آفلاین مدل کوچک خواندن کد امنیتی رهگیری پست (Resources/Captcha/digits.onnx)؛ رایگان و بدون سرویس بیرونی. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.116.1" />
    <!-- ابزار dotnet-ef فقط هنگام توسعه؛ contentfiles حذف شد تا پوشه‌های BuildHost (ده‌ها مگابایت) در bin کپی نشوند. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Front-end build files (Tailwind) are development-only and are not published. -->
  <ItemGroup>
    <Content Remove="package.json;package-lock.json;tailwind.config.js" />
  </ItemGroup>

  <!-- مدل ONNX کپچا کنار برنامه کپی می‌شود (build و publish)؛ مسیر خواندن: AppContext.BaseDirectory/Resources/Captcha/digits.onnx -->
  <ItemGroup>
    <None Update="Resources\Captcha\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fratak-Shop.Core\Fratak-Shop.Core.csproj" />
    <ProjectReference Include="..\Fratak-Shop.Data\Fratak-Shop.Data.csproj" />
  </ItemGroup>

</Project>
