<?xml version="1.0" encoding="utf-8"?>
<!--
  مرحلهٔ هفدهم: پروفایل انتشار Visual Studio برای سرور ویندوز (IIS / Plesk).
  Visual Studio: روی پروژهٔ Fratak-Shop.Web راست‌کلیک ← Publish ← IIS-Windows ← Publish.
  خروجی: پوشهٔ publish/windows در ریشهٔ مخزن، فقط با فایل‌های بومی ویندوز (x64 و x86)، بدون App_Data، wwwroot/uploads
  و appsettings.Development.json. معادل خط فرمان: tools/deploy/publish.ps1
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <PublishUrl>..\..\publish\windows</PublishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <FratakPublishTarget>windows</FratakPublishTarget>
  </PropertyGroup>
</Project>
