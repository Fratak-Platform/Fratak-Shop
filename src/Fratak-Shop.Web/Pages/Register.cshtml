@page "/register"
@model RegisterModel
@{
    Layout = "_LayoutMinimal";
    const string inputClass = "placeholder:text-right text-sm block w-full bg-zinc-50 rounded-xl border border-gray-300 px-4 py-4 text-gray-700 outline-none transition-all focus:border-sky-500 focus:outline-none";
}

  <main class="max-w-[1600px] mx-auto">
    <div class="flex justify-center items-center min-h-screen py-10">
      <a class="absolute top-2 left-2 text-sm bg-sky-500 text-white rounded-md py-2 px-6" asp-page="/Index">
        صفحه اصلی
      </a>
      <form method="post" class="bg-white rounded-3xl shadow-xl border border-zinc-100 w-11/12 sm:w-7/12 md:w-6/12 lg:w-4/12 h-auto py-5 px-4">
        <input type="hidden" asp-for="ReturnUrl" />
        <a asp-page="/Index"><img class="w-36 mx-auto" src="@Site.LogoUrl" alt="@Site.Settings.SiteName" width="144" height="40"></a>
        <h1 class="mt-5 text-lg font-semibold text-zinc-800">
          ثبت نام در سایت
        </h1>
        <div class="my-4 text-xs text-zinc-500">
          لطفا شماره موبایل و رمز عبور خود را وارد کنید
        </div>
        <partial name="_ValidationSummary" />
        <div class="grid grid-cols-2 gap-x-3 mb-7">
          <input asp-for="Input.FirstName" type="text" placeholder="نام (اختیاری)" autocomplete="given-name" class="@inputClass">
          <input asp-for="Input.LastName" type="text" placeholder="نام خانوادگی (اختیاری)" autocomplete="family-name" class="@inputClass">
        </div>
        <input asp-for="Input.Email" type="email" placeholder="ایمیل (اختیاری)" autocomplete="email" dir="ltr" class="@inputClass mb-7">
        <input asp-for="Input.PhoneNumber" type="tel" placeholder="شماره همراه" autocomplete="username" inputmode="numeric" maxlength="11" dir="ltr" class="@inputClass mb-7">
        <input asp-for="Input.Password" type="password" placeholder="رمز عبور (حداقل ۶ کاراکتر)" autocomplete="new-password" class="@inputClass mb-7">
        <input asp-for="Input.ConfirmPassword" type="password" placeholder="تکرار رمز عبور" autocomplete="new-password" class="@inputClass">
        <label class="flex items-center gap-x-2 mt-4 text-sm text-zinc-600 cursor-pointer">
          <input asp-for="Input.AcceptRules" type="checkbox" class="h-4 w-4 accent-sky-500">
          <span><a class="text-sky-500" href="/page/rules" target="_blank">قوانین و مقررات</a> را مطالعه کرده و می پذیرم</span>
        </label>
        <button type="submit" class="mx-auto w-full px-2 py-3 font-bold mt-8 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">
          ثبت نام
        </button>
        <div class="text-sm text-zinc-600 mt-4">
          <span>
            اکانت دارید؟
          </span>
          <a asp-page="/Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-sky-500">
            وارد شوید
          </a>
        </div>
        <div class="mt-8 text-xs text-zinc-500">
          ثبت نام شما به معنای پذیرش <a class="text-sky-400 hover:text-sky-500 transition" href="/page/rules"> قوانین و مقررات</a> @Site.Settings.SiteName میباشد.
        </div>
      </form>
    </div>
  </main>
