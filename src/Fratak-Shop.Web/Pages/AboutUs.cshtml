@page "/about-us"
@model AboutUsModel
@{
    Layout = "_Layout";
    var site = ShopSettings.Value.SiteName;
}


  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="bg-white border rounded-xl shadow-lg p-4">
      <div class="-mx-4 flex flex-wrap justify-between">
        <div class="w-full px-4 lg:pr-10 lg:w-1/2 xl:w-5/12 lg:pt-32">
          <div class="mt-10 lg:mt-0">
            <span class="mb-4 block text-lg font-semibold">
              درباره ما بخوانید
            </span>
            <h2
              class="mb-5 text-3xl font-bold dark:text-white sm:text-[40px]/[48px]">
              تیم @site تقدیم میکند.
            </h2>
            <p class="mb-5 text-base text-body-color">
              @site با هدف ارائه تجربه‌ای مطمئن و لذت‌بخش از خرید اینترنتی کالای دیجیتال فعالیت خود را آغاز کرد. تا به امروز @site از پویاترین و به‌روزترین فروشگاه‌های اینترنتی ایران بوده است که با ارائه محصولات متنوع، باکیفیت، مقرون ‌به ‌صرفه و تازه، ارزش‌های بنیادی خود را خلق کرده است.
            </p>
            <p class="mb-8 text-base text-body-color">
              مجموعه @site داشتن تخفیف‌های روزانه بر روی انواع کالاهای داخلی با کیفیتی استاندارد را، هدف اصلی خود در ارائه خدمات به مشتریان قرار داده است.
            </p>
            <a
              href="/contact-us"
              class="inline-flex items-center justify-center rounded-full bg-blue-500 px-7 py-3 text-center text-white hover:bg-opacity-90">
              تماس با ما
            </a>
          </div>
        </div>
        <div class="w-full px-4 lg:w-6/12">
          <div class="-mx-3 flex items-center sm:-mx-4">
            <div class="w-full sm:px-4 xl:w-1/2">
              <div class="py-3 sm:py-4">
                <img
                  src="~/assets/image/about/image-1.jpg"
                  alt="@site"
                  class="w-10/12 rounded-2xl mx-auto"/>
              </div>
              <div class="py-3 sm:py-4">
                <img
                  src="~/assets/image/about/image-2.jpg"
                  alt="@site"
                  class="w-10/12 rounded-2xl mx-auto"/>
              </div>
            </div>
            <div class="w-full sm:px-4 xl:w-1/2">
              <div class="relative z-10 my-4">
                <img
                  src="~/assets/image/about/image-3.jpg"
                  alt="@site"
                  class="w-10/12 rounded-2xl mx-auto"/>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mb-2 mt-10 text-xl font-semibold text-zinc-800 border-t pt-6">
        درباره @site
      </div>
      <div class="text-zinc-700 leading-8">
        @site مرجع تخصصی نقد و بررسی و فروش اینترنتی کالا در ایران است.  مختلف کالا مانند کالای دیجیتال، لوازم خانگی، لوازم شخصی، فرهنگ و هنر و ورزش و سرگرمی با تنوعی بی‌نظیر در @site عرضه . @site با در اختیار داشتن سهم  از بازار عرضه اینترنتی کالا در ایران با تنوعی بسیار بالا از برندهای مختلف، در همراهی مشتریان در فرآیند خرید و حفظ جایگاه  در میان آنها، نهایت تلاش خود را . کاربران و مشتریان @site  با حق انتخابی بسیار بالا و با دریافت اطلاعاتی کامل برای انتخاب درست کالای مورد نظر خود، وب سایت @site را بررسی کنند و با حداکثر اطمینان کالای خود را انتخاب و خرید کنند. همواره بهترین انتخاب و بهترین خدمات، شایسته مشتری @site است.
      </div>
      <div class="mb-2 mt-10 text-xl font-semibold text-zinc-800">
        درباره @site
      </div>
      <div class="text-zinc-700 leading-8">
        @site مرجع تخصصی نقد و بررسی و فروش اینترنتی کالا در ایران است.  مختلف کالا مانند کالای دیجیتال، لوازم خانگی، لوازم شخصی، فرهنگ و هنر و ورزش و سرگرمی با تنوعی بی‌نظیر در @site عرضه . @site با در اختیار داشتن سهم  از بازار عرضه اینترنتی کالا در ایران با تنوعی بسیار بالا از برندهای مختلف، در همراهی مشتریان در فرآیند خرید و حفظ جایگاه  در میان آنها، نهایت تلاش خود را . کاربران و مشتریان @site  با حق انتخابی بسیار بالا و با دریافت اطلاعاتی کامل برای انتخاب درست کالای مورد نظر خود، وب سایت @site را بررسی کنند و با حداکثر اطمینان کالای خود را انتخاب و خرید کنند. همواره بهترین انتخاب و بهترین خدمات، شایسته مشتری @site است.
      </div>
    </div>
  </main>
