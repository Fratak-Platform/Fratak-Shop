@page
@model ComingSoonModel
@{
    ViewData["Title"] = "به زودی برمی گردیم.";
    Layout = "_LayoutMinimal";
}



  <main>
    <div class="pt-44">
      <div class="text-center text-2xl md:text-6xl font-black text-zinc-800 flex justify-center items-center gap-5">
        در اولین فرصت بر میگردیم.
        <div class="size-8 md:size-10 border-black border-t-2 rounded-full animate-spin">
        </div>
      </div>
      <div class="text-center flex flex-col justify-center items-center mt-10 text-zinc-700 md:text-lg">
        شماره همراه خود را وارد کنید تا در اولین فرصت به شما پیغام دهیم.
        <input class="border p-2 rounded-lg border-zinc-400 focus:outline-none mt-2 min-w-96 placeholder:text-right" dir="ltr" type="text" placeholder="شماره همراه">
        <button class="mx-auto w-fit px-16 mt-5 py-3 text-sm bg-gradient-to-bl from-sky-400 to-sky-600 hover:opacity-80 transition text-gray-100 rounded-md">
          ارسال
        </button>
      </div>
    </div>
  </main>
