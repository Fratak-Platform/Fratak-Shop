@page "/faq"
@model FaqModel
@{
    Layout = "_Layout";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="bg-white border rounded-xl shadow-lg p-4">
      <div>
        <div class="-mx-4 flex flex-wrap">
          <div class="w-full px-4">
            <div class="mx-auto mb-[60px] max-w-[520px] text-center lg:mb-20">
              <h2
                class="my-4 text-3xl font-bold sm:text-[40px]/[48px]">
                سوالات متداول
              </h2>
              <p>
                اگه جواب سوال موردنظرتون رو پیدا نکردید به <a asp-page="/ContactUs" class="text-sky-600">پشتیبانی</a> پیام دهید.
              </p>
            </div>
          </div>
        </div>

        <div class="-mx-4 flex flex-wrap">
          <div class="w-full px-4 lg:w-1/2">
            @foreach (var item in Model.RightColumn)
            {
              <button type="button" class="group mb-8 w-full rounded-lg bg-white p-4 shadow-[0px_20px_95px_0px_rgba(201,203,204,0.30)] sm:p-8 lg:px-6 xl:px-8">
                <div class="flex items-center justify-between gap-x-3 min-h-8 px-3 rounded-lg text-zinc-700">
                  <span class="text-right">
                    @item.Question
                  </span>
                <svg class="size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                </div>
                <div class="max-h-0 overflow-hidden duration-300 group-focus:max-h-96 text-right text-sm">
                  <div class="py-5 px-4 text-zinc-700 leading-7">
                    @item.Answer
                  </div>
                </div>
              </button>
            }
          </div>
          <div class="w-full px-4 lg:w-1/2">
            @foreach (var item in Model.LeftColumn)
            {
              <button type="button" class="group mb-8 w-full rounded-lg bg-white p-4 shadow-[0px_20px_95px_0px_rgba(201,203,204,0.30)] sm:p-8 lg:px-6 xl:px-8">
                <div class="flex items-center justify-between gap-x-3 min-h-8 px-3 rounded-lg text-zinc-700">
                  <span class="text-right">
                    @item.Question
                  </span>
                <svg class="size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                </svg>
                </div>
                <div class="max-h-0 overflow-hidden duration-300 group-focus:max-h-96 text-right text-sm">
                  <div class="py-5 px-4 text-zinc-700 leading-7">
                    @item.Answer
                  </div>
                </div>
              </button>
            }
          </div>
        </div>
        @if (Model.RightColumn.Count == 0)
        {
          <p class="text-center text-zinc-500 pb-10">هنوز پرسشی ثبت نشده است.</p>
        }
      </div>
    </div>
  </main>
