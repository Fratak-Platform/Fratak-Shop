@page "/contact-us"
@model ContactUsModel
@{
    Layout = "_Layout";
    var shop = Site.Settings;
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="bg-white border rounded-xl shadow-lg p-4">
      <div>
        <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
          <div class="w-full h-px bg-zinc-300">
          </div>
          <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
            ارتباط با ما
          </div>
          <div class="w-full h-px bg-zinc-300">
          </div>
        </span>
        <div class="border border-dashed border-zinc-400 p-5 rounded-lg mt-10 grid md:grid-cols-2 gap-5">
          <form method="post">
            <div class="text-2xl font-semibold text-zinc-600">
              با ما در ارتباط باشید
            </div>
            <div class="mt-4"><partial name="_ValidationSummary" /></div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-4 mb-3">
              <input asp-for="Input.FullName" class="border p-2 rounded-lg border-zinc-400 focus:outline-none" type="text" placeholder="نام و نام خانوادگی" required>
              <input asp-for="Input.PhoneNumber" class="border p-2 rounded-lg border-zinc-400 focus:outline-none" type="tel" placeholder="شماره همراه" dir="ltr" maxlength="11" required>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-4 mb-3">
              <input asp-for="Input.Email" class="border p-2 rounded-lg border-zinc-400 focus:outline-none" type="email" placeholder="ایمیل" dir="ltr">
              <input asp-for="Input.Subject" class="border p-2 rounded-lg border-zinc-400 focus:outline-none" type="text" placeholder="موضوع">
            </div>
            <div>
              <textarea asp-for="Input.Content" class="border p-2 rounded-lg border-zinc-400 focus:outline-none w-full" placeholder="توضیحات" cols="30" rows="5" required></textarea>
            </div>
            <div>
              @if (Model.Captcha is not null)
              {
                <partial name="_Captcha" model="Model.Captcha" />
              }
              <button type="submit" class="bg-sky-600 hover:bg-sky-700 transition px-8 py-2 mt-2 rounded-lg text-white">
                ارسال اطلاعات
              </button>
            </div>
          </form>
          <div>
            <ul class="space-y-4 text-zinc-600 text-sm">
              @if (!string.IsNullOrWhiteSpace(shop.SupportPhone))
              {
                <li class="flex items-center gap-x-2">@Icons.Svg("Phone", "fill-sky-600") <a href="tel:@shop.SupportPhone" dir="ltr">@shop.SupportPhone</a></li>
              }
              @if (!string.IsNullOrWhiteSpace(shop.SupportEmail))
              {
                <li class="flex items-center gap-x-2">@Icons.Svg("Envelope", "fill-sky-600") <a href="mailto:@shop.SupportEmail">@shop.SupportEmail</a></li>
              }
              @if (!string.IsNullOrWhiteSpace(shop.Address))
              {
                <li class="flex items-center gap-x-2">@Icons.Svg("MapPin", "fill-sky-600") @shop.Address</li>
              }
              @if (!string.IsNullOrWhiteSpace(shop.WorkingHours))
              {
                <li class="flex items-center gap-x-2">@Icons.Svg("Clock", "fill-sky-600") @shop.WorkingHours</li>
              }
            </ul>
            @if (UrlSafety.IsHttpUrl(shop.MapEmbedUrl) && shop.MapEmbedUrl!.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            {
              <iframe title="موقعیت فروشگاه روی نقشه" loading="lazy" class="rounded-3xl w-full mt-5 border-0" src="@shop.MapEmbedUrl" height="250" allowfullscreen referrerpolicy="no-referrer-when-downgrade" sandbox="allow-scripts allow-same-origin allow-popups"></iframe>
            }
          </div>
        </div>
      </div>
    </div>
  </main>
