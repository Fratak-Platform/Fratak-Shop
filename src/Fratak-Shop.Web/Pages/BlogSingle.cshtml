@page
@model BlogSingleModel
@{
    ViewData["Title"] = "بلاگ";
    Layout = "_Layout";
}


  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
      <div class="w-full h-px bg-zinc-300">
      </div>
      <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
        7 روش  برای استفاده درست از هدفون
      </div>
      <div class="w-full h-px bg-zinc-300">
      </div>
    </span>
    <div class="flex flex-col md:flex-row gap-5">
      <div class="md:w-8/12 space-y-5">
        <div class="bg-white border rounded-xl shadow-lg p-4">
          <img class="rounded-2xl" src="~/assets/image/blog/1.jpg" alt="" />
          <div class="flex gap-4 mt-6 mb-10 flex-wrap">
            @foreach (var item in Model.PostMeta) {<div class="text-xs flex gap-x-1 items-center text-zinc-400">
              @Html.Raw(item.IconHtml)</path></svg>
              @item.Text
            </div>}
