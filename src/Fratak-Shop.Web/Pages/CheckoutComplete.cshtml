@page "/checkout/success/{orderNumber}"
@model CheckoutCompleteModel
@{
    Layout = "_Layout";
    var order = Model.Order;
    var paidOnline = order.PaymentStatus == Fratak_Shop.Data.Entities.Orders.PaymentStatus.Paid;
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
      <div class="w-full h-px bg-zinc-300">
      </div>
      <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
        سفارش موفق
      </div>
      <div class="w-full h-px bg-zinc-300">
      </div>
    </span>
    <div class="bg-white border rounded-xl shadow-lg p-4">
      @Icons.Svg("CheckCircle", "mx-auto fill-green-500 mt-12", 70)
      <div class="text-green-600 text-center text-lg font-semibold mt-2">
        @(paidOnline ? "پرداخت با موفقیت انجام شد" : "سفارش شما با موفقیت ثبت شد")
      </div>
      <div class="text-green-500 text-center text-sm mt-2">
        از خرید شما متشکریم؛ وضعیت سفارش را می توانید از بخش سفارش های من پیگیری کنید.
      </div>
      <div class="px-2 sm:px-6 py-3 rounded-xl shadow-lg border mx-auto my-5 max-w-md">
        <partial name="_OrderReceipt" model="order" />
        <a asp-page="/Profile/OrderDetail" asp-route-orderNumber="@order.OrderNumber" class="mx-auto block text-center w-full px-2 py-3 mt-5 text-sm bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">
          مشاهده جزئیات سفارش
        </a>
        <a asp-page="/Index" class="mx-auto block text-center w-full px-2 py-3 mt-3 text-sm border border-sky-500 text-sky-600 rounded-lg">
          ادامه خرید
        </a>
      </div>
    </div>
  </main>
