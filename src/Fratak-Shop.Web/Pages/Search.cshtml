@page "/search"
@model SearchModel
@{
    Layout = "_Layout";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-4 flex flex-col md:flex-row gap-5">
      <div class="md:w-4/12 lg:w-3/12">
        <div class="mb-4 rounded-2xl bg-white border">
          <div class="flex flex-col overflow-y-auto overflow-x-hidden p-4">
            <form method="get" action="/search" id="filterForm">
              <input type="hidden" name="q" value="@Model.Query" />
              <input type="hidden" name="sort" value="@Model.Sort" />
              <!-- title -->
              <div class="mb-6 flex items-center justify-between">
                <h3 class="text-zinc-700 font-semibold text-lg">
                  فیلتر ها
                </h3>
                <a href="/search" class="py-2 text-sm text-red-400 hover:text-red-500 transition">
                  حذف همه
                </a>
              </div>
              <ul class="space-y-2">
                <!-- category -->
                <li>
                  <details class="group border rounded-md" open>
                    <summary class="flex cursor-pointer items-center justify-between rounded-lg py-4 px-2 text-zinc-700">
                      <span class="font-semibold"> دسته بندی </span>
                      <span class="shrink-0 transition duration-200 group-open:-rotate-90">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#000000" viewBox="0 0 256 256"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path></svg>
                      </span>
                    </summary>
                    <div class="mt-2 max-h-60 overflow-y-auto px-2 pb-2">
                      <ul class="space-y-2 rounded-lg">
                        <li>
                          <div class="flex w-full items-center gap-x-2 pr-4 bg-gray-50 rounded-md">
                            <input class="h-4 w-4 accent-sky-500 cursor-pointer" type="radio" name="category" value="" id="cat-all" checked="@(string.IsNullOrWhiteSpace(Model.CategorySlug) ? "checked" : null)" data-autosubmit>
                            <label class="flex w-full cursor-pointer items-center gap-x-2 py-3 text-sm text-zinc-600" for="cat-all">
                              <span>همه دسته بندی ها</span>
                            </label>
                          </div>
                        </li>
                        @foreach (var category in Model.Categories)
                        {
                          <li>
                            <div class="flex w-full items-center gap-x-2 pr-4 bg-gray-50 rounded-md">
                              <input class="h-4 w-4 accent-sky-500 cursor-pointer" type="radio" name="category" value="@category.Slug" id="cat-@category.Slug" checked="@(category.Slug == Model.CategorySlug ? "checked" : null)" data-autosubmit>
                              <label class="flex w-full cursor-pointer items-center gap-x-2 py-3 text-sm text-zinc-600 font-semibold" for="cat-@category.Slug">
                                <span>@category.Name</span>
                              </label>
                            </div>
                          </li>
                          @foreach (var sub in category.SubCategories)
                          {
                            <li>
                              <div class="flex w-full items-center gap-x-2 pr-8 bg-gray-50 rounded-md">
                                <input class="h-4 w-4 accent-sky-500 cursor-pointer" type="radio" name="category" value="@sub.Slug" id="cat-@sub.Slug" checked="@(sub.Slug == Model.CategorySlug ? "checked" : null)" data-autosubmit>
                                <label class="flex w-full cursor-pointer items-center gap-x-2 py-3 text-sm text-zinc-600" for="cat-@sub.Slug">
                                  <span>@sub.Name</span>
                                </label>
                              </div>
                            </li>
                          }
                        }
                      </ul>
                    </div>
                  </details>
                </li>
                <!-- brand (category specific; hidden on /brand/{slug}) -->
                @if (Model.IsBrandPage)
                {
                  foreach (var slug in Model.BrandSlugs)
                  {
                    <input type="hidden" name="brand" value="@slug" />
                  }
                }
                else if (Model.ShowBrandFilter)
                {
                <li>
                  <details class="group border rounded-md" open="@(Model.BrandSlugs.Count > 0 ? "open" : null)">
                    <summary class="flex cursor-pointer items-center justify-between rounded-lg py-4 px-2 text-zinc-700">
                      <span class="font-semibold">
                        برند
                        @if (Model.BrandSlugs.Count > 0)
                        {
                          <span class="mr-1 rounded-full bg-sky-100 px-2 text-xs text-sky-600">@Model.BrandSlugs.Count</span>
                        }
                      </span>
                      <span class="shrink-0 transition duration-200 group-open:-rotate-90">
                        @Icons.Svg("CaretLeft", "fill-black", 16)
                      </span>
                    </summary>
                    <div class="mt-2 max-h-60 overflow-y-auto px-2 pb-2">
                      <ul class="space-y-2 rounded-lg" id="brandListFilterDesktop">
                        @if (Model.BrandFacets.Count > 8)
                        {
                        <li class="p-2 relative">
                          <input id="brandListFilterDesktopSearchInput" class="w-full pr-10 rounded-lg border border-none bg-gray-100 px-7 py-3 text-zinc-600 outline-none placeholder:text-sm placeholder:text-zinc-500 focus:ring-0" placeholder="جستجوی برند ..." type="text" aria-label="جستجوی برند" data-filter-list="#brandListFilterDesktop">
                          <svg class="absolute top-6 right-4 fill-zinc-600" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="" viewBox="0 0 256 256"><path d="M229.66,218.34l-50.07-50.06a88.11,88.11,0,1,0-11.31,11.31l50.06,50.07a8,8,0,0,0,11.32-11.32ZM40,112a72,72,0,1,1,72,72A72.08,72.08,0,0,1,40,112Z"></path></svg>
                        </li>
                        }
                        @foreach (var brand in Model.BrandFacets)
                        {
                          <li data-filter-item="@brand.Name @brand.EnglishName">
                            <div class="flex w-full items-center gap-x-2 pr-4 bg-gray-50 rounded-md">
                              <input class="h-4 w-4 accent-sky-500 cursor-pointer" type="checkbox" name="brand" value="@brand.Slug" id="brand-@brand.Slug" checked="@(brand.IsSelected ? "checked" : null)" data-autosubmit>
                              <label class="flex w-full cursor-pointer items-center gap-x-2 py-3 text-sm text-zinc-600 justify-between pl-3" for="brand-@brand.Slug">
                                <span>@brand.Name</span>
                                <span class="text-xs text-zinc-400">@Format.Number(brand.Count)</span>
                              </label>
                            </div>
                          </li>
                        }
                      </ul>
                    </div>
                  </details>
                </li>
                }
                <!-- specifications (admin managed: ProductFilterAttribute) -->
                @foreach (var facet in Model.Facets)
                {
                  var listId = $"facet-{facet.Slug}";
                  <li>
                    <details class="group border rounded-md" open="@(facet.HasSelection ? "open" : null)">
                      <summary class="flex cursor-pointer items-center justify-between rounded-lg py-4 px-2 text-zinc-700">
                        <span class="font-semibold">
                          @facet.Title
                          @if (facet.HasSelection)
                          {
                            <span class="mr-1 rounded-full bg-sky-100 px-2 text-xs text-sky-600">@facet.Values.Count(v => v.IsSelected)</span>
                          }
                        </span>
                        <span class="shrink-0 transition duration-200 group-open:-rotate-90">
                          @Icons.Svg("CaretLeft", "fill-black", 16)
                        </span>
                      </summary>
                      <div class="mt-2 max-h-60 overflow-y-auto px-2 pb-2">
                        <ul class="space-y-2 rounded-lg" id="@listId">
                          @if (facet.Values.Count > 8)
                          {
                            <li class="p-2">
                              <input class="w-full rounded-lg bg-gray-100 px-3 py-2 text-sm text-zinc-600 outline-none placeholder:text-zinc-500" placeholder="جستجو ..." type="text" aria-label="جستجو در @facet.Title" data-filter-list="#@listId">
                            </li>
                          }
                          @for (var i = 0; i < facet.Values.Count; i++)
                          {
                            var option = facet.Values[i];
                            var inputId = $"{listId}-{i}";
                            <li data-filter-item="@option.Value">
                              <div class="flex w-full items-center gap-x-2 pr-4 bg-gray-50 rounded-md">
                                <input class="h-4 w-4 accent-sky-500 cursor-pointer" type="checkbox" name="@(SearchModel.SpecificationPrefix + facet.Slug)" value="@option.Value" id="@inputId" checked="@(option.IsSelected ? "checked" : null)" data-autosubmit>
                                <label class="flex w-full cursor-pointer items-center justify-between gap-x-2 py-3 pl-3 text-sm text-zinc-600" for="@inputId">
                                  <span>@option.Value</span>
                                  <span class="text-xs text-zinc-400">@Format.Number(option.Count)</span>
                                </label>
                              </div>
                            </li>
                          }
                        </ul>
                      </div>
                    </details>
                  </li>
                }
                @if (Model.Category is null && !Model.IsBrandPage)
                {
                  <li class="flex items-start gap-x-2 rounded-md bg-sky-50 p-3 text-xs leading-6 text-sky-700">
                    @Icons.Svg("Info", "fill-sky-500 shrink-0 mt-0.5", 16)
                    <span>برای فیلتر بر اساس برند و مشخصات فنی، ابتدا یک دسته‌بندی را انتخاب کنید.</span>
                  </li>
                }
                <!-- price -->
                <li>
                  <details class="group border rounded-md">
                    <summary class="flex cursor-pointer items-center justify-between rounded-lg py-4 px-2 text-zinc-700">
                      <span class="font-semibold"> محدوده قیمت (تومان) </span>
                      <span class="shrink-0 transition duration-200 group-open:-rotate-90">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="#000000" viewBox="0 0 256 256"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path></svg>
                      </span>
                    </summary>
                    <div class="mt-2 px-2 pb-3 space-y-3">
                      <div class="flex items-center gap-x-2 text-sm text-zinc-600">
                        <label for="minPrice" class="w-6">از</label>
                        <input id="minPrice" name="minPrice" type="number" min="0" step="10000" value="@Model.MinPrice" placeholder="0" class="w-full rounded-lg bg-gray-100 px-3 py-2 outline-none focus:ring-1 focus:ring-sky-400" dir="ltr">
                      </div>
                      <div class="flex items-center gap-x-2 text-sm text-zinc-600">
                        <label for="maxPrice" class="w-6">تا</label>
                        <input id="maxPrice" name="maxPrice" type="number" min="0" step="10000" value="@Model.MaxPrice" placeholder="بدون سقف" class="w-full rounded-lg bg-gray-100 px-3 py-2 outline-none focus:ring-1 focus:ring-sky-400" dir="ltr">
                      </div>
                      <button type="submit" class="w-full rounded-lg bg-sky-500 hover:bg-sky-400 transition py-2 text-sm text-white">اعمال محدوده قیمت</button>
                    </div>
                  </details>
                </li>
                <!-- available -->
                <li>
                  <label class="flex cursor-pointer items-center justify-between py-5 px-2" for="onlyAvailableDesktop">
                    <div class="text-zinc-700 font-semibold">
                      فقط کالا های موجود
                    </div>
                    <div class="relative inline-flex cursor-pointer items-center">
                      <input class="peer sr-only" id="onlyAvailableDesktop" type="checkbox" name="available" value="true" checked="@(Model.Available ? "checked" : null)" data-autosubmit>
                      <div class="peer h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-[2px] after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-blue-400 peer-checked:after:translate-x-full peer-focus:ring-blue-400"></div>
                    </div>
                  </label>
                </li>
                <!-- special -->
                <li>
                  <label class="flex cursor-pointer items-center justify-between pt-5 px-2" for="onlySpecialDesktop">
                    <div class="text-zinc-700 font-semibold">
                     فقط کالاهای تخفیف دار
                    </div>
                    <div class="relative inline-flex cursor-pointer items-center">
                      <input class="peer sr-only" id="onlySpecialDesktop" type="checkbox" name="discounted" value="true" checked="@(Model.Discounted ? "checked" : null)" data-autosubmit>
                      <div class="peer h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-[2px] after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-all after:content-[''] peer-checked:bg-blue-400 peer-checked:after:translate-x-full peer-focus:ring-blue-400"></div>
                    </div>
                  </label>
                </li>
              </ul>
              <noscript><button type="submit" class="mt-4 w-full rounded-lg bg-sky-500 py-2 text-white">اعمال فیلتر</button></noscript>
            </form>
          </div>
        </div>
      </div>
      <div class="md:w-8/12 lg:w-9/12">
        <div class="flex justify-between items-center mb-5">
          <div class="px-5">
            <h1 class="text-zinc-800 font-semibold text-lg">@Model.Heading</h1>
            <div class="text-zinc-500 text-sm mt-1">@Model.Result.EntityCount کالا</div>
          </div>
          <div class="group relative">
            <select name="sort" form="sortForm" aria-label="مرتب سازی" class="leading-5.6 ease block w-48 appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding px-3 py-2 font-normal text-gray-700 outline-none transition-all placeholder:text-gray-500 focus:border-sky-500 focus:outline-none" data-autosubmit>
              @foreach (var option in SearchModel.SortOptions)
              {
                <option value="@option.Value" selected="@(option.Value == Model.Sort ? "selected" : null)">@option.Title</option>
              }
            </select>
            <svg class="absolute top-3 left-2" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#000000" viewBox="0 0 256 256"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"></path></svg>
          </div>
        </div>
        <form method="get" id="sortForm" action="@(Request.Path)" class="hidden">
          @foreach (var pair in Request.Query.Where(p => p.Key != "sort" && p.Key != "page"))
          {
            foreach (var value in pair.Value)
            {
              <input type="hidden" name="@pair.Key" value="@value" />
            }
          }
        </form>
        @if (Model.Result.Data.Count == 0)
        {
          <div class="bg-white border rounded-xl p-10 text-center">
            <img class="mx-auto w-40 opacity-80" src="~/assets/image/search.png" alt="">
            <p class="mt-5 text-zinc-600">محصولی با این مشخصات پیدا نشد.</p>
            @if (Model.DidYouMean is { } suggestion)
            {
              <p class="mt-3 text-sm text-zinc-600">
                منظورتان
                <a href="/search?q=@Uri.EscapeDataString(suggestion)" class="font-semibold text-sky-600 hover:underline">«@suggestion»</a>
                بود؟
              </p>
            }
            @if (Model.HasFilters)
            {
              <a href="/search" class="inline-block mt-4 rounded-lg bg-sky-500 px-6 py-2 text-sm text-white">حذف فیلترها</a>
            }
            @if (Model.PopularSearches.Count > 0)
            {
              <div class="mt-6">
                <div class="mb-2 text-xs text-zinc-400">جستجوهای پرطرفدار</div>
                <div class="flex flex-wrap justify-center gap-2">
                  @foreach (var popular in Model.PopularSearches)
                  {
                    <a href="/search?q=@Uri.EscapeDataString(popular)" class="rounded-full border px-3 py-1 text-xs text-zinc-600 hover:border-sky-300 hover:text-sky-600">@popular</a>
                  }
                </div>
              </div>
            }
            <ul class="mx-auto mt-6 max-w-sm list-disc space-y-1 pr-5 text-right text-xs text-zinc-400">
              <li>املای کلمات را بررسی کنید یا از کلمات کلی‌تر استفاده کنید.</li>
              <li>نام انگلیسی یا فارسی کالا را امتحان کنید (مثلاً «هندزفری» یا «earbuds»).</li>
            </ul>
          </div>
        }
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 mt-5">
          @foreach (var product in Model.Result.Data)
          {
            <partial name="_ProductGridCard" model="product" />
          }
        </div>
        <partial name="_Pagination" model="Model.Pager" />
        @if (Model.ListingDescriptionHtml is not null)
        {
          <section class="prose-content bg-white border rounded-xl p-4 md:p-8 mt-8 text-sm" aria-label="معرفی">
            @Html.Raw(Model.ListingDescriptionHtml)
          </section>
        }
      </div>
    </div>
  </main>
