@page "/payment/sandbox/{orderNumber}"
@model Fratak_Shop.Web.Pages.Payment.SandboxModel
@{
    Layout = "_LayoutMinimal";
    var separator = Model.CallbackUrl.Contains('?') ? "&" : "?";
}
  <main class="max-w-[1600px] mx-auto">
    <div class="flex justify-center items-center min-h-screen py-10">
      <div class="bg-white rounded-3xl shadow-xl border border-zinc-100 w-11/12 sm:w-7/12 md:w-6/12 lg:w-4/12 h-auto py-5 px-4">
        <img class="w-24 mx-auto" src="~/assets/image/service/zarinPal.png" alt="درگاه پرداخت">
        <div class="mt-5 text-lg font-semibold text-zinc-800 text-center">
          درگاه پرداخت آزمایشی
        </div>
        <div class="my-4 text-xs text-yellow-700 bg-yellow-50 border border-yellow-200 rounded-lg p-3 leading-6">
          این صفحه فقط برای محیط توسعه است و هیچ مبلغی کسر نمی شود. برای اتصال به درگاه واقعی، پیاده سازی IPaymentGateway را جایگزین کنید.
        </div>
        <div class="space-y-3 text-sm text-zinc-600">
          <div class="flex justify-between bg-gray-100 rounded-lg px-3 py-3">
            <span>شماره سفارش</span>
            <span dir="ltr">@Model.Order.OrderNumber</span>
          </div>
          <div class="flex justify-between bg-gray-100 rounded-lg px-3 py-3 font-semibold text-zinc-800">
            <span>مبلغ قابل پرداخت</span>
            <span>@Format.Toman(Model.Order.PayableAmount)</span>
          </div>
        </div>
        <a href="@($"{Model.CallbackUrl}{separator}status=ok")" class="mx-auto block text-center w-full px-2 py-3 font-bold mt-8 bg-green-500 hover:bg-green-400 transition text-gray-100 rounded-lg">
          پرداخت موفق
        </a>
        <a href="@($"{Model.CallbackUrl}{separator}status=cancel")" class="mx-auto block text-center w-full px-2 py-3 mt-3 bg-red-500 hover:bg-red-400 transition text-gray-100 rounded-lg">
          انصراف از پرداخت
        </a>
      </div>
    </div>
  </main>
