@page "/forgot-password/reset"
@model ResetPasswordModel
@{
    Layout = "_LayoutMinimal";
    const string inputClass = "placeholder:text-right text-sm block w-full bg-zinc-50 rounded-xl border border-gray-300 px-4 py-4 text-gray-700 outline-none transition-all focus:border-sky-500 focus:outline-none";
}
@* دور ۳۰ (#۷): بازیابی رمز عبور – گام دوم (کد پیامکی + رمز تازه). بعد از ثبت، همهٔ دستگاه‌ها از حساب خارج می‌شوند. *@
  <main class="max-w-[1600px] mx-auto">
    <div class="flex justify-center items-center min-h-screen py-10">
      <a class="absolute top-2 left-2 text-sm bg-sky-500 text-white rounded-md py-2 px-6" asp-page="/Index">
        صفحه اصلی
      </a>
      <div class="bg-white rounded-3xl shadow-xl border border-zinc-100 w-11/12 sm:w-7/12 md:w-6/12 lg:w-4/12 h-auto py-5 px-4">
        <a asp-page="/Index" class="flex justify-center" aria-label="@Site.Settings.SiteName">@await Html.PartialAsync("_BrandLockup", new BrandLockupModel(BrandPlace.Auth))</a>
        <form method="post">
          <input type="hidden" asp-for="Phone" />
          <h1 class="mt-5 text-lg font-semibold text-zinc-800">تعیین رمز عبور تازه</h1>
          <div class="my-4 text-xs leading-6 text-zinc-500">
            کد @Model.CodeLength رقمی پیامک‌شده به شماره <span dir="ltr">@Model.Phone</span> را وارد کنید و رمز تازه را دو بار بنویسید.
            <a asp-page="/ForgotPassword" asp-route-phone="@Model.Phone" class="text-sky-500 mr-1">ویرایش شماره</a>
          </div>
          <partial name="_ValidationSummary" />
          <partial name="_OtpDigits" model="Model.CodeLength" />
          <input asp-for="Input.NewPassword" type="password" placeholder="رمز عبور تازه (حداقل ۶ کاراکتر)" autocomplete="new-password" class="@inputClass mb-4">
          <input asp-for="Input.ConfirmPassword" type="password" placeholder="تکرار رمز عبور تازه" autocomplete="new-password" class="@inputClass">
          <p class="mt-2 text-[11px] leading-5 text-zinc-400">رمزهای خیلی رایج (مثل ۱۲۳۴۵۶) و شماره موبایل پذیرفته نمی‌شوند. بعد از ثبت، همهٔ دستگاه‌ها از حساب خارج می‌شوند.</p>
          @if (Model.Captcha is not null)
          {
            <partial name="_Captcha" model="Model.Captcha" />
          }
          <button type="submit" class="mx-auto w-full px-2 py-3 font-bold mt-6 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">
            ثبت رمز تازه
          </button>
        </form>
        <form method="post" asp-page-handler="Resend" class="mt-4 text-sm">
          <input type="hidden" name="phone" value="@Model.Phone" />
          <button type="submit" class="text-sky-500 hover:text-sky-600">ارسال مجدد کد</button>
        </form>
      </div>
    </div>
  </main>
