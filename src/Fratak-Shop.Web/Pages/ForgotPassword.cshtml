@page "/forgot-password"
@model ForgotPasswordModel
@{
    Layout = "_LayoutMinimal";
    const string inputClass = "placeholder:text-right text-sm block w-full bg-zinc-50 rounded-xl border border-gray-300 px-4 py-4 text-gray-700 outline-none transition-all focus:border-sky-500 focus:outline-none";
}
@* دور ۳۰ (#۷): بازیابی رمز عبور – گام اول (شماره موبایل). جواب برای شمارهٔ عضو و غیرعضو یکسان است. *@
  <main class="max-w-[1600px] mx-auto">
    <div class="flex justify-center items-center min-h-screen py-10">
      <a class="absolute top-2 left-2 text-sm bg-sky-500 text-white rounded-md py-2 px-6" asp-page="/Index">
        صفحه اصلی
      </a>
      <div class="bg-white rounded-3xl shadow-xl border border-zinc-100 w-11/12 sm:w-7/12 md:w-6/12 lg:w-4/12 h-auto py-5 px-4">
        <a asp-page="/Index" class="flex justify-center" aria-label="@Site.Settings.SiteName">@await Html.PartialAsync("_BrandLockup", new BrandLockupModel(BrandPlace.Auth))</a>
        <h1 class="mt-5 text-lg font-semibold text-zinc-800">بازیابی رمز عبور</h1>
        <form method="post" class="mt-2">
          <div class="my-4 text-xs leading-6 text-zinc-500">
            شماره موبایل حساب خود را وارد کنید. اگر این شماره در فروشگاه حساب داشته باشد، یک کد پیامکی برایتان فرستاده می‌شود
            تا رمز تازه تعیین کنید.
          </div>
          <partial name="_ValidationSummary" />
          <input asp-for="Input.PhoneNumber" type="tel" placeholder="شماره همراه (مثلاً ۰۹۱۲۱۲۳۴۵۶۷)" autocomplete="username" inputmode="numeric" maxlength="11" dir="ltr" class="@inputClass">
          @if (Model.Captcha is not null)
          {
            <partial name="_Captcha" model="Model.Captcha" />
          }
          <button type="submit" class="mx-auto w-full px-2 py-3 font-bold mt-8 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">
            دریافت کد بازیابی
          </button>
        </form>
        <div class="text-sm text-zinc-600 mt-4 flex flex-wrap items-center gap-x-2 gap-y-1">
          <span>رمز را به یاد آوردید؟</span>
          <a asp-page="/Login" asp-route-mode="password" class="text-sky-500">ورود با رمز عبور</a>
        </div>
      </div>
    </div>
  </main>
