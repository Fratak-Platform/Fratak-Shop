@page "/blog/{slug}"
@model BlogPostModel
@{
    Layout = "_Layout";
    var post = Model.Post;
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
      <div class="w-full h-px bg-zinc-300">
      </div>
      <h1 class="text-xl md:text-4xl font-semibold text-zinc-700 md:min-w-max text-center">
        @post.Title
      </h1>
      <div class="w-full h-px bg-zinc-300">
      </div>
    </span>
    <div class="flex flex-col md:flex-row gap-5">
      <div class="md:w-8/12 space-y-5">
        <article class="bg-white border rounded-xl shadow-lg p-4">
          <img class="rounded-2xl w-full" src="@ImageHelper.Blog(post.ImageName)" alt="@(post.ImageAlt ?? post.Title)" />
          <div class="flex gap-4 mt-6 mb-10 flex-wrap">
            @if (!string.IsNullOrWhiteSpace(post.BlogCategoryName))
            {
              <div class="text-xs flex gap-x-1 items-center text-zinc-400">
                @Icons.Svg("Folder", "fill-zinc-400", 16)
                دسته بندی
                <a class="hover:text-blue-500 transition" href="/blog/category/@post.BlogCategorySlug">
                  @post.BlogCategoryName
                </a>
              </div>
            }
            @if (!string.IsNullOrWhiteSpace(post.AuthorName))
            {
              <div class="text-xs flex gap-x-1 items-center text-zinc-400">
                @Icons.Svg("User", "fill-zinc-400", 16)
                @post.AuthorName
              </div>
            }
            <div class="text-xs flex gap-x-1 items-center text-zinc-400">
              @Icons.Svg("Clock", "fill-zinc-400", 16)
              @Format.LongDate(post.PublishedAt ?? post.CreatedAt)
            </div>
            <div class="text-xs flex gap-x-1 items-center text-zinc-400">
              @Icons.Svg("Info", "fill-zinc-400", 16)
              زمان مطالعه: @Format.ReadingMinutes(post.Content) دقیقه
            </div>
            <div class="text-xs flex gap-x-1 items-center text-zinc-400">
              @Icons.Svg("Chat", "fill-zinc-400", 16)
              @Model.Comments.Count دیدگاه
            </div>
          </div>
          <div class="prose-content leading-8 font-normal text-zinc-800 text-justify mt-2 mb-10">
            @Html.Raw(post.Content)
          </div>
        </article>
        <div class="bg-white border rounded-xl shadow-lg p-4" id="comments">
          <span class="flex items-center justify-center my-4 gap-x-5">
            <div class="w-full h-px bg-zinc-300">
            </div>
            <div class="text-xl md:text-2xl font-semibold text-zinc-700 min-w-max text-center">
              دیدگاه ها
            </div>
            <div class="w-full h-px bg-zinc-300">
            </div>
          </span>
          @if (Model.Comments.Count == 0)
          {
            <p class="text-center text-sm text-zinc-500 py-4">هنوز دیدگاهی ثبت نشده است.</p>
          }
          @foreach (var comment in Model.Comments)
          {
            <div class="border-2 border-dashed rounded-xl p-4 my-2">
              <div class="flex items-start">
                <div class="flex items-center gap-x-1">
                  <img class="max-w-16 md:max-w-24 ml-2 rounded-lg" src="~/assets/image/man.webp" alt="">
                  <div>
                    <div class="text-zinc-800 mb-3 font-semibold text-lg">
                      @comment.AuthorName
                    </div>
                    <div class="text-zinc-600 text-sm">
                      @Format.Date(comment.CreatedAt)
                    </div>
                  </div>
                </div>
              </div>
              <div class="text-zinc-600 py-3 whitespace-pre-line">@comment.Content</div>
            </div>
            @foreach (var reply in comment.Replies)
            {
              <div class="border-2 border-dashed rounded-xl p-4 my-2 mr-8 md:mr-20">
                <div class="flex items-center gap-x-1">
                  <img class="max-w-16 md:max-w-24 ml-2 rounded-lg" src="~/assets/image/logo.png" alt="">
                  <div>
                    <div class="text-zinc-800 mb-3 font-semibold text-lg">
                      @reply.AuthorName
                    </div>
                    <div class="text-zinc-600 text-sm">
                      @Format.Date(reply.CreatedAt)
                    </div>
                  </div>
                </div>
                <div class="text-zinc-600 py-3 whitespace-pre-line">@reply.Content</div>
              </div>
            }
          }
          <div class="mt-10">
            <div class="text-2xl font-semibold text-zinc-600">
              دیدگاه خود را ثبت کنید
            </div>
            @if (User.IsSignedIn())
            {
              <form method="post" asp-page-handler="Comment" asp-route-slug="@post.Slug">
                <div class="grid grid-cols-2 gap-5 mt-4 mb-3">
                  <input class="border p-2 rounded-lg border-zinc-400 bg-gray-50 text-zinc-500 focus:outline-none" type="text" value="@User.GetDisplayName()" disabled aria-label="نام">
                  <input class="border p-2 rounded-lg border-zinc-400 bg-gray-50 text-zinc-500 focus:outline-none" type="text" value="@User.GetPhoneNumber()" disabled aria-label="شماره همراه" dir="ltr">
                </div>
                <div>
                  <textarea asp-for="CommentText" class="border p-2 rounded-lg border-zinc-400 focus:outline-none w-full" placeholder="متن دیدگاه" cols="30" rows="5" required minlength="3" maxlength="2000"></textarea>
                </div>
                <div>
                  <button type="submit" class="bg-sky-600 hover:bg-sky-700 transition px-8 py-2 mt-2 rounded-lg text-white">
                    ارسال دیدگاه
                  </button>
                </div>
              </form>
            }
            else
            {
              <a asp-page="/Login" asp-route-returnUrl="@($"/blog/{post.Slug}#comments")" class="inline-block bg-sky-600 hover:bg-sky-700 transition px-8 py-2 mt-4 rounded-lg text-white">
                برای ثبت دیدگاه وارد شوید
              </a>
            }
          </div>
        </div>
      </div>
      <aside class="bg-white border rounded-xl shadow-lg p-4 md:w-4/12 h-fit space-y-5">
        <div class="font-semibold text-zinc-700">آخرین مقالات</div>
        @foreach (var latest in Model.LatestPosts)
        {
          <a href="/blog/@latest.Slug" class="flex items-center justify-start gap-x-2 w-full p-2 text-gray-600 bg-white border border-gray-300 rounded-lg cursor-pointer hover:text-gray-600 hover:bg-gray-100">
            <img class="w-24 h-20 object-cover rounded-lg" src="@ImageHelper.Blog(latest.ImageName)" alt="@latest.Title" loading="lazy">
            <div class="flex flex-col space-y-3">
              <div class="text-sm sm:text-base font-semibold">@latest.Title</div>
              <div class="flex items-start gap-x-1 text-xs text-zinc-400">
                @Icons.Svg("Clock", "fill-gray-400", 14)
                <span>
                  @Format.ReadingMinutes(latest.Content) دقیقه
                </span>
              </div>
            </div>
          </a>
        }
        <div class="pt-2 border-t">
          <div class="text-sm text-zinc-600 mb-2">اشتراک گذاری:</div>
          <button type="button" data-share="/blog/@post.Slug" data-share-title="@post.Title" class="text-sm text-sky-600 hover:text-sky-700">کپی لینک مقاله</button>
        </div>
      </aside>
    </div>
  </main>
