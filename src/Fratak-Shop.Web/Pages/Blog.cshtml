@page
@model BlogModel
@{
    ViewData["Title"] = "بلاگ";
    Layout = "_Layout";
}


  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="bg-white border rounded-xl shadow-lg p-4">
      <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
        <div class="w-full h-px bg-zinc-300">
        </div>
        <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
          وبلاگ
        </div>
        <div class="w-full h-px bg-zinc-300">
        </div>
      </span>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        @foreach (var item in Model.BlogCards) {<div class="bg-white rounded-2xl border border-zinc-300 group">
          <a href="" class="image-box">
            @Html.Raw(item.ImageTag)
          </a>
          <div class="p-2 md:p-4 mt-2">
            <a asp-page="/BlogSingle" class="font-semibold text-zinc-800">
              ۷ ترفند برای افزایش طول عمر هدفون
            </a>
            <p class="mb-4 mt-5 text-zinc-600">
              اگر از جمله کاربرانی هستید که هدفون‌های شما بعد از حدود یک یا دو سال استفاده خراب...
            </p>
            <a asp-page="/BlogSingle" class="flex items-center justify-center w-fit mx-auto text-blue-600 hover:text-blue-400 transition">
              ادامه مطلب
            </a>
          </div>
        </div>
        }
      </div>
      <ul class="flex items-center justify-center gap-x-2 md:gap-x-3 h-8 text-sm mt-10 mb-4">
        @foreach (var item in Model.PaginationItems) {<li>
          @Html.Raw(item.LinkHtml)</a>
        </li>
        }
      </ul>
    </div>
  </main>
