@page "/cart"
@model CartModel
@{
    Layout = "_Layout";
    var cart = Model.Cart;
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
      <div class="w-full h-px bg-zinc-300">
      </div>
      <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
        سبد خرید
      </div>
      <div class="w-full h-px bg-zinc-300">
      </div>
    </span>
    @if (Model.IsEmpty)
    {
      <div class="text-center text-xl md:text-2xl text-zinc-600 font-semibold">
        <img class="mx-auto w-40 mb-6 opacity-90" src="~/assets/image/Cart.webp" alt="">
        سبد خرید خالی است!
        <a href="/search?sort=BestSelling" class="text-gray-50 mx-auto w-fit mb-2 block px-6 md:px-8 py-2 mt-5 rounded-lg bg-gradient-to-r from-sky-500 to-sky-600 hover:opacity-80 transition">
          محصولات پرطرفدار
        </a>
      </div>
    }
    else
    {
    <div class="flex flex-col md:flex-row gap-5">
      <div class="md:w-8/12">
        <div class="bg-white border rounded-xl shadow-lg p-4">
          <div class="flex items-center justify-between">
            <div class="text-zinc-600">@(cart!.TotalQuantity) کالا در سبد خرید شما</div>
            <form method="post" asp-page-handler="Clear" data-confirm="همه کالاهای سبد خرید حذف شوند؟">
              <button type="submit" class="text-sm text-red-400 hover:text-red-500 transition">حذف همه</button>
            </form>
          </div>
          @foreach (var item in cart.Items)
          {
          <div class="mt-7 flex flex-col md:flex-row gap-y-5 border-b pb-4">
            <div class="w-10/12 mx-auto md:max-w-36">
              <a href="/product/@item.ProductSlug">
                <img src="@ImageHelper.Sized(ImageHelper.Product(item.ImageName), 320, Site.Settings.IsImageOptimizationEnabled)" alt="@(item.ImageAlt ?? item.ProductName)" loading="lazy" decoding="async">
              </a>
              @if (item.IsAvailable)
              {
              <div class="flex h-10 w-24 items-center justify-between rounded-lg border border-gray-100 px-2 py-1 mt-5 mx-auto">
                <form method="post" asp-page-handler="Update" class="flex">
                  <input type="hidden" name="productId" value="@item.ProductId" />
                  <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                  <button type="submit" aria-label="افزایش تعداد" disabled="@(item.Quantity >= item.StockQuantity ? "disabled" : null)">
                    <svg class="fill-green-600" xlink:href="#plus" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#4d4d4d" viewBox="0 0 256 256"><path d="M222,128a6,6,0,0,1-6,6H134v82a6,6,0,0,1-12,0V134H40a6,6,0,0,1,0-12h82V40a6,6,0,0,1,12,0v82h82A6,6,0,0,1,222,128Z"></path></svg>
                  </button>
                </form>
                <input value="@item.Quantity" disabled="" type="number" aria-label="تعداد" class="flex h-5 w-full grow select-none items-center justify-center bg-transparent text-center text-sm text-zinc-700 outline-none">
                <form method="post" asp-page-handler="@(item.Quantity > 1 ? "Update" : "Remove")" class="flex">
                  <input type="hidden" name="productId" value="@item.ProductId" />
                  <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                  <button type="submit" aria-label="کاهش تعداد">
                    <svg class="fill-red-600" xlink:href="#minus" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="" viewBox="0 0 256 256"><path d="M222,128a6,6,0,0,1-6,6H40a6,6,0,0,1,0-12H216A6,6,0,0,1,222,128Z"></path></svg>
                  </button>
                </form>
              </div>
              }
            </div>
            <div class="mr-2 md:mr-5 w-full">
              @* title *@
              <div class="flex items-start justify-between gap-x-3">
                <a href="/product/@item.ProductSlug" class="text-xl text-zinc-700">
                  @(item.ProductName ?? "این محصول دیگر موجود نیست")
                </a>
                <div class="flex shrink-0 items-center gap-x-3">
                  @if (Site.Settings.IsSaveForLaterEnabled && item.IsAvailable)
                  {
                    <form method="post" asp-page-handler="SaveForLater">
                      <input type="hidden" name="productId" value="@item.ProductId" />
                      <button type="submit" class="whitespace-nowrap text-xs text-sky-600 hover:text-sky-700" title="از سبد خارج و در لیست خرید بعدی نگه داشته می‌شود">خرید بعدی</button>
                    </form>
                  }
                  <form method="post" asp-page-handler="Remove">
                    <input type="hidden" name="productId" value="@item.ProductId" />
                    <button type="submit" class="text-xs text-red-400 hover:text-red-500 whitespace-nowrap">حذف</button>
                  </form>
                </div>
              </div>
              <div class="w-full space-y-2 mt-5">
                <div class="flex items-center gap-x-2 text-xs text-zinc-500">
                  <div class="flex items-center gap-x-2">
                    @Icons.Svg("Shield", "fill-zinc-500", 18)
                    <span>ضمانت اصالت و سلامت فیزیکی کالا</span>
                  </div>
                </div>
                <div class="flex items-center gap-x-2 text-xs text-zinc-500">
                  <div class="flex items-center gap-x-2">
                    @Icons.Svg("Truck", "fill-zinc-500", 18)
                    <span>@(item.HasEnoughStock ? "آماده ارسال" : "موجودی کافی نیست")</span>
                  </div>
                </div>
                @if (item.HasDiscount)
                {
                  <div class="flex items-center gap-x-2 text-xs text-red-500">
                    <span>تخفیف: @Format.Toman(item.DiscountAmount)</span>
                  </div>
                }
                @* price *@
                <div class="text-gray-700 pt-4">
                  @if (item.HasDiscount)
                  {
                    <span class="text-sm text-zinc-400 line-through ml-2">@Format.Price(item.UnitPrice * item.Quantity)</span>
                  }
                  <span class="text-xl font-bold">@Format.Price(item.TotalAmount)</span>
                  <span class="text-sm">تومان</span>
                  @if (!item.IsAvailable)
                  {
                    <div class="text-xs text-red-400 mt-3">این کالا از فروشگاه حذف شده است؛ لطفاً آن را از سبد خرید حذف کنید.</div>
                  }
                  else if (!item.HasEnoughStock)
                  {
                    <div class="text-xs text-red-400 mt-3">موجودی انبار @item.StockQuantity عدد است؛ تعداد را کاهش دهید.</div>
                  }
                  else if (item.StockQuantity <= 5)
                  {
                    <div class="text-xs text-red-400 mt-3">تنها @item.StockQuantity عدد در انبار باقی مانده</div>
                  }
                </div>
              </div>
            </div>
          </div>
          }
        </div>
      </div>
      <div class="bg-white border rounded-xl shadow-lg p-4 md:w-4/12 h-fit space-y-5">
        <div class="p-3">
          <div class="flex gap-x-1 justify-between items-center text-zinc-600 px-2 py-3 font-semibold">
            <div>
              قیمت کالاها (@cart.TotalQuantity)
            </div>
            <div class="flex gap-x-1">
              <div>
                @Format.Price(cart.SubtotalAmount)
              </div>
              <div>
                تومان
              </div>
            </div>
          </div>
          @if (cart.TotalDiscountAmount > 0)
          {
          <div class="flex gap-x-1 justify-between items-center text-red-500 font-semibold mt-3 px-2 py-3">
            <div>
              تخفیف
            </div>
            <div class="flex gap-x-1">
              <div>
                @Format.Price(cart.TotalDiscountAmount)
              </div>
              <div>
                تومان
              </div>
            </div>
          </div>
          }
          @if (Model.Coupon is { ItemsDiscount: > 0 } coupon)
          {
            <div class="flex gap-x-1 justify-between items-center text-red-500 font-semibold mt-3 px-2 py-3">
              <div>کد تخفیف <span dir="ltr">@coupon.Code</span></div>
              <div>@Format.Toman(coupon.ItemsDiscount)</div>
            </div>
          }
          <div class="flex gap-x-1 justify-between items-center text-zinc-800 mt-5 px-2 pt-5 font-black border-t" data-assistant="cart-summary">
            <div>
              جمع سبد خرید
            </div>
            <div class="flex gap-x-1">
              <div>
                @Format.Price(Model.PayableAfterCoupon)
              </div>
              <div>
                تومان
              </div>
            </div>
          </div>
          <p class="text-xs text-zinc-500 px-2 mt-3">هزینه ارسال در مرحله بعد بر اساس روش ارسال محاسبه می‌شود.</p>
          @* دور ۱۹ (C3): نوار پیشرفت ارسال رایگان – عدد واقعی تنظیمات؛ بدون فشار یا شمارش معکوس. *@
          @if (Site.Settings.FreeShippingThreshold > 0)
          {
            var freeShip = Site.Settings.FreeShippingThreshold;
            var remaining = freeShip - Model.PayableAfterCoupon;
            var progress = (int)Math.Clamp(Math.Round(Model.PayableAfterCoupon * 100m / freeShip), 0, 100);
            <div class="px-2 mt-3 text-xs text-zinc-600">
              @if (remaining > 0)
              {
                <div>با @Format.Toman(remaining) خرید بیشتر، ارسال رایگان می‌شود.</div>
              }
              else
              {
                <div class="text-emerald-700">ارسال این سفارش (با روش‌های عادی) رایگان است.</div>
              }
              <progress class="w-full h-1.5 mt-1" max="100" value="@progress" aria-label="پیشرفت تا ارسال رایگان"></progress>
            </div>
          }
          @if (Site.Settings.IsCouponEnabled)
          {
            <partial name="_CouponBox" model='new CouponBoxModel(cart.CouponCode, Model.Coupon, Model.CouponError, "/cart", Model.Captcha)' />
          }
          @if (Model.HasProblems)
          {
            <div class="mx-auto block text-center w-full px-2 py-3 mt-8 bg-zinc-300 text-zinc-600 rounded-lg cursor-not-allowed">
              ابتدا مشکلات سبد خرید را برطرف کنید
            </div>
          }
          else
          {
            <a asp-page="/Checkout" data-assistant="checkout-button" class="mx-auto block text-center w-full px-2 py-3 mt-8 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">
              تایید و تکمیل سفارش
            </a>
          }
        </div>
      </div>
    </div>
    }
    @if (Model.Saved.Count > 0)
    {
      <section id="saved" class="mt-8 rounded-xl border bg-white p-4 shadow-lg">
        <h2 class="mb-1 font-semibold text-zinc-700">لیست خرید بعدی <span class="text-sm font-normal text-zinc-400">(@Model.Saved.Count کالا)</span></h2>
        <p class="mb-4 text-xs text-zinc-500">این کالاها در سبد حساب نمی‌شوند؛ هر وقت خواستید به سبد برگردانید. قیمت‌ها لحظه‌ای است.</p>
        <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          @foreach (var saved in Model.Saved)
          {
            <li class="flex gap-3 rounded-xl border p-3">
              <a href="/product/@saved.ProductSlug" class="shrink-0">
                <img src="@ImageHelper.Sized(ImageHelper.Product(saved.ImageName), 160, Site.Settings.IsImageOptimizationEnabled)" alt="" width="72" height="72" loading="lazy" class="h-[72px] w-[72px] rounded-lg object-contain @(saved.IsAvailable ? "" : "grayscale opacity-60")">
              </a>
              <div class="min-w-0 flex-1">
                <a href="/product/@saved.ProductSlug" class="line-clamp-2 text-sm text-zinc-700 hover:text-sky-600">@saved.ProductName</a>
                <div class="mt-1 text-sm">
                  @if (saved.IsAvailable)
                  {
                    if (saved.FinalPrice < saved.Price)
                    {
                      <span class="ml-1 text-xs text-zinc-400 line-through">@Format.Price(saved.Price)</span>
                    }
                    <b class="text-zinc-700">@Format.Toman(saved.FinalPrice)</b>
                  }
                  else
                  {
                    <span class="text-xs text-red-400">ناموجود</span>
                  }
                </div>
                <div class="mt-2 flex items-center gap-x-3 text-xs">
                  @if (saved.IsAvailable)
                  {
                    <form method="post" asp-page-handler="MoveToCart">
                      <input type="hidden" name="productId" value="@saved.ProductId" />
                      <button type="submit" class="rounded-lg bg-sky-500 px-3 py-1 text-white hover:bg-sky-400">انتقال به سبد</button>
                    </form>
                  }
                  <form method="post" asp-page-handler="RemoveSaved">
                    <input type="hidden" name="productId" value="@saved.ProductId" />
                    <button type="submit" class="text-red-400 hover:text-red-500">حذف</button>
                  </form>
                </div>
              </div>
            </li>
          }
        </ul>
      </section>
    }
    <partial name="_ProductRail" model='new ProductRailModel(Model.IsEmpty ? "پیشنهاد برای شما" : "پیشنهاد برای تکمیل خرید", Model.Suggestions)' />
  </main>

@section Scripts {
    <script src="~/assets/js/dependencies/swiper.min.js" asp-append-version="true"></script>
    <script src="~/assets/js/sliders.js" asp-append-version="true"></script>
}
