@page "/profile/messages"
@model Fratak_Shop.Web.Pages.Profile.MessagesModel
@{
    Layout = "_Layout";
    const string inputClass = "focus:shadow-primary-outline text-sm leading-5.6 block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding px-3 py-2 font-normal text-gray-700 outline-none transition-all focus:border-sky-300 focus:outline-none";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.Messages" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0">
        <div>
          <h1 class="text-zinc-800 text-lg mb-4 font-semibold">
           پیغام ها:
          </h1>
          <details class="group border rounded-md mb-6" open="@(Model.Messages.Count == 0 || !ViewData.ModelState.IsValid ? "open" : null)">
            <summary class="flex cursor-pointer items-center justify-between rounded-lg py-3 px-3 text-zinc-700">
              <span class="font-semibold">ارسال پیام جدید به پشتیبانی</span>
              <span class="shrink-0 transition duration-200 group-open:-rotate-90">@Icons.Svg("ChevronLeft", "fill-zinc-700", 16)</span>
            </summary>
            <form method="post" class="px-3 pb-4 space-y-3">
              <partial name="_ValidationSummary" />
              <div class="sm:flex gap-x-3 space-y-3 sm:space-y-0">
                <select asp-for="Input.Type" class="@inputClass sm:w-1/3" aria-label="نوع پیام">
                  @foreach (var type in Fratak_Shop.Web.Pages.Profile.MessagesModel.Types)
                  {
                    <option value="@type.Type">@type.Title</option>
                  }
                </select>
                <input asp-for="Input.Subject" type="text" placeholder="موضوع" class="@inputClass sm:w-2/3" maxlength="250">
              </div>
              <textarea asp-for="Input.Content" rows="5" placeholder="متن پیام" class="@inputClass" maxlength="4000"></textarea>
              <button type="submit" class="px-8 py-2 text-sm bg-gradient-to-bl from-sky-500 to-sky-600 hover:opacity-80 transition text-gray-100 rounded-lg">ارسال پیام</button>
            </form>
          </details>
          @if (Model.Messages.Count == 0)
          {
            <div class="text-center py-6 text-zinc-500">هنوز پیامی ارسال نکرده اید.</div>
          }
          <div class="space-y-5">
            @foreach (var message in Model.Messages)
            {
              <div class="bg-zinc-100 rounded-md">
                <div class="border-b border-b-zinc-500 px-3 py-2 text-zinc-800 text-sm font-semibold flex justify-between items-center gap-2 flex-wrap">
                  <span>@(string.IsNullOrWhiteSpace(message.Subject) ? Display.MessageType(message.Type) : message.Subject)</span>
                  <span class="flex items-center gap-x-2">
                    <span class="text-zinc-50 px-3 py-1 text-xs rounded-md @Display.MessageStatusBadge(message.Status)">@Display.MessageStatus(message.Status)</span>
                    <span class="text-zinc-50 bg-sky-500 px-3 py-1 text-xs rounded-md">@Format.Date(message.CreatedAt)</span>
                  </span>
                </div>
                <div class="px-5 py-4 text-zinc-600 text-sm leading-7 whitespace-pre-line">@message.Content</div>
                @if (message.RepliedAt.HasValue)
                {
                  <div class="px-5 pb-4 text-xs text-green-600">پاسخ پشتیبانی در @Format.DateTime(message.RepliedAt.Value) ارسال شد.</div>
                }
              </div>
            }
          </div>
        </div>
      </div>
    </div>
  </main>
