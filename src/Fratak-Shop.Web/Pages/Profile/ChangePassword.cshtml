@page
@model Fratak_Shop.Web.Pages.Profile.ChangePasswordModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="grid gap-6 lg:grid-cols-12">
    <aside class="lg:col-span-3">
        <partial name="_ProfileSidebar" />
    </aside>

    <section class="lg:col-span-9">
        <div class="card p-5 md:p-6">
            <h1 class="section-title">تغییر رمز عبور</h1>

            <form method="post" class="grid max-w-xl gap-4">
                <div asp-validation-summary="ModelOnly" class="form-error"></div>

                <div>
                    <label class="form-label" asp-for="Input.CurrentPassword">رمز عبور فعلی</label>
                    <input class="form-input" asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" />
                    <p class="mt-1 text-[11px] text-zinc-400">اگر با کد یک‌بارمصرف وارد شده‌اید، این فیلد را خالی بگذارید.</p>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.NewPassword">رمز عبور جدید</label>
                    <input class="form-input" asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
                    <span class="form-error" asp-validation-for="Input.NewPassword"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ConfirmPassword">تکرار رمز عبور جدید</label>
                    <input class="form-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                    <span class="form-error" asp-validation-for="Input.ConfirmPassword"></span>
                </div>

                <div>
                    <button type="submit" class="btn-primary px-8">تغییر رمز عبور</button>
                </div>
            </form>
        </div>
    </section>
</div>
