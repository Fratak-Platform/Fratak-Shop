@page "/profile/info"
@model Fratak_Shop.Web.Pages.Profile.PersonalInfoModel
@{
    Layout = "_Layout";
    const string inputClass = "focus:shadow-primary-outline text-sm leading-5.6 block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding px-3 py-2 font-normal text-gray-700 outline-none transition-all focus:border-sky-300 focus:outline-none";
    var required = Icons.Svg("Asterisk", "fill-red-500", 10);
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.PersonalInfo" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0">
        <form method="post">
          @if (Model.Welcome)
          {
            @* مرحلهٔ دهم: تکمیل اطلاعات بعد از ثبت‌نام کاملاً اختیاری است. *@
            <input type="hidden" asp-for="Welcome" />
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-5 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-800 sm:flex sm:items-center sm:justify-between gap-3" role="status">
              <div>
                <b class="block mb-1">به @Site.Settings.SiteName خوش آمدید!</b>
                حساب شما آماده است. اگر بخواهید نام و تاریخ تولدتان را وارد کنید تا فاکتور و هدیه‌ها به نام خودتان باشد؛ این کار اختیاری است.
              </div>
              <a href="@Model.ContinueUrl" class="mt-3 sm:mt-0 inline-block shrink-0 rounded-lg border border-sky-300 bg-white px-4 py-2 text-sky-700 hover:bg-sky-100 transition">بعداً، ادامه بده</a>
            </div>
          }
          <h1 class="text-zinc-800 text-lg font-semibold">@(Model.Welcome ? "تکمیل اطلاعات (اختیاری)" : "اطلاعات حساب کاربری")</h1>
          @* inputs *@
          <div class="sm:flex gap-x-5 mt-5">
            <div class="sm:w-1/2 mb-2 sm:mb-0 flex flex-col gap-y-1">
              <label class="text-sm text-zinc-700 flex" for="Input_FirstName">
                نام
                @required
              </label>
              <input asp-for="Input.FirstName" type="text" autocomplete="given-name" class="@inputClass">
            </div>
            <div class="sm:w-1/2 flex flex-col gap-y-1">
              <label class="text-sm text-zinc-700 flex" for="Input_LastName">
                نام خانوادگی
                @required
              </label>
              <input asp-for="Input.LastName" type="text" autocomplete="family-name" class="@inputClass">
            </div>
          </div>
          <div class="sm:flex gap-x-5 mt-5">
            <div class="sm:w-1/2 mb-2 sm:mb-0 flex flex-col gap-y-1">
              <label class="text-sm text-zinc-700 flex" for="phone">
                تلفن همراه
              </label>
              <input id="phone" type="text" value="@Model.PhoneNumber" disabled dir="ltr" class="@inputClass bg-gray-100 text-zinc-500">
              <span class="text-xs @(Model.IsPhoneVerified ? "text-green-600" : "text-yellow-600")">
                @(Model.IsPhoneVerified ? "شماره موبایل تایید شده است." : "شماره موبایل تایید نشده است.")
                @if (!Model.IsPhoneVerified)
                {
                  <a asp-page="/Verify" class="text-sky-600">تایید شماره</a>
                }
              </span>
            </div>
            <div class="sm:w-1/2 mb-2 sm:mb-0 flex flex-col gap-y-1">
              <label class="text-sm text-zinc-700 flex" for="Input_Email">
                ایمیل
              </label>
              <input asp-for="Input.Email" type="email" autocomplete="email" dir="ltr" class="@inputClass">
              @if (!string.IsNullOrWhiteSpace(Model.SavedEmail))
              {
                @* مرحلهٔ دوازدهم: اعلان ایمیلی فقط به ایمیل تأییدشده ارسال می‌شود. *@
                <span class="text-xs @(Model.IsEmailVerified ? "text-green-600" : "text-yellow-600")">
                  @(Model.IsEmailVerified ? "ایمیل تأیید شده است." : "ایمیل تأیید نشده است؛ تا تأیید نشود اعلان ایمیلی ارسال نمی‌شود.")
                  @if (!Model.IsEmailVerified)
                  {
                    <button type="submit" form="send-email-verification" class="text-sky-600 hover:text-sky-500">ارسال لینک تأیید</button>
                  }
                </span>
              }
            </div>
          </div>
          <fieldset class="mt-5">
            <legend class="text-sm text-zinc-700 mb-1">تاریخ تولد <span class="text-xs text-zinc-400">(اختیاری؛ برای هدیه تولد @(Site.Settings.IsLoyaltyEnabled ? "باشگاه مشتریان" : ""))</span></legend>
            <div class="grid grid-cols-3 gap-3 sm:w-1/2">
              <select asp-for="Input.BirthDay" class="@inputClass" aria-label="روز تولد">
                <option value="">روز</option>
                @for (var d = 1; d <= 31; d++)
                {
                  <option value="@d">@d</option>
                }
              </select>
              <select asp-for="Input.BirthMonth" class="@inputClass" aria-label="ماه تولد">
                <option value="">ماه</option>
                @for (var m = 1; m <= 12; m++)
                {
                  <option value="@m">@Fratak_Shop.Web.Pages.Profile.PersonalInfoModel.PersianMonths[m - 1]</option>
                }
              </select>
              <select asp-for="Input.BirthYear" class="@inputClass" aria-label="سال تولد">
                <option value="">سال</option>
                @foreach (var y in Fratak_Shop.Web.Pages.Profile.PersonalInfoModel.BirthYears)
                {
                  <option value="@y">@y</option>
                }
              </select>
            </div>
          </fieldset>
          <button type="submit" class="mx-auto block w-full sm:w-1/3 px-2 py-3 mt-8 text-sm bg-gradient-to-bl from-sky-500 to-sky-600 hover:opacity-80 transition text-gray-100 rounded-lg">
            ثبت اطلاعات
          </button>
        </form>
        @if (!string.IsNullOrWhiteSpace(Model.SavedEmail) && !Model.IsEmailVerified)
        {
          @* فرم جدا (فرم تو در تو مجاز نیست)؛ دکمهٔ کنار ایمیل با form="send-email-verification" آن را ارسال می‌کند. *@
          <form id="send-email-verification" method="post" asp-page-handler="SendVerification" class="hidden">
            @if (Model.Welcome)
            {
              <input type="hidden" name="Welcome" value="true" />
              <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
            }
          </form>
        }
      </div>
    </div>
  </main>
