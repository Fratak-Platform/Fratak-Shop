@page "/profile/password"
@model Fratak_Shop.Web.Pages.Profile.PasswordModel
@{
    Layout = "_Layout";
    ViewData[PageMetaKeys.SitePage] = Fratak_Shop.Data.Entities.Pages.SitePage.UserProfile;
    const string inputClass = "placeholder:text-right text-sm block w-full rounded-md border border-gray-300 px-3 py-3 font-normal text-gray-700 outline-none transition-all focus:border-sky-500 focus:outline-none";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.Password" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0">
        @* دور ۳۱ (#۵/#۶): همهٔ کارهای امنیتی در یک کارت پیوسته؛ «رمز فعلی را نمی‌دانم» بازیابی با کد پیامکی را همین‌جا باز می‌کند. *@
        @if (Model.ForgotMode)
        {
          <section class="max-w-md" aria-labelledby="forgot-title">
            <h1 id="forgot-title" class="text-lg font-semibold text-zinc-800">بازیابی رمز عبور</h1>
            <p class="mt-4 mb-4 text-xs leading-6 text-zinc-500">
              رمز فعلی را به خاطر ندارید؟ اشکالی ندارد. یک کد @Model.CodeLength رقمی به شمارهٔ حساب شما
              (<span dir="ltr">@Model.MaskedPhone</span>) پیامک می‌شود؛ کد را وارد کنید و رمز تازه را دو بار بنویسید.
            </p>
            <form method="post" asp-page-handler="SendCode" class="mb-5">
              <button type="submit" class="rounded-lg border border-sky-300 px-4 py-2 text-sm text-sky-700 hover:bg-sky-50 transition">ارسال کد به موبایل من</button>
            </form>
            <form method="post" asp-page-handler="Forgot">
              <partial name="_ValidationSummary" />
              <partial name="_OtpDigits" model="Model.CodeLength" />
              <label class="block text-sm text-zinc-700 mb-2" for="forgot-new">رمز عبور تازه</label>
              <input id="forgot-new" name="forgot.NewPassword" type="password" autocomplete="new-password" minlength="6" maxlength="128" required class="@inputClass">
              <label class="block text-sm text-zinc-700 mt-5 mb-2" for="forgot-confirm">تکرار رمز عبور تازه</label>
              <input id="forgot-confirm" name="forgot.ConfirmPassword" type="password" autocomplete="new-password" minlength="6" maxlength="128" required class="@inputClass">
              <p class="mt-2 text-[11px] leading-5 text-zinc-400">رمزهای خیلی رایج (مثل ۱۲۳۴۵۶) و شماره موبایل پذیرفته نمی‌شوند. بعد از ثبت، سایر دستگاه‌ها از حساب خارج می‌شوند و همین دستگاه وارد می‌ماند.</p>
              <button type="submit" class="mx-auto w-full px-2 py-3 font-bold mt-6 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">ثبت رمز تازه</button>
            </form>
            <a href="/profile/password" class="mt-4 inline-block text-sm text-sky-600 hover:text-sky-700">رمز فعلی را به خاطر آوردم</a>
          </section>
        }
        else
        {
        <form method="post" class="max-w-md">
          <h1 class="text-lg font-semibold text-zinc-800">
            @(Model.CurrentUser?.HasPassword == false ? "تعیین رمز عبور" : "تغییر رمز عبور")
          </h1>
          @if (Model.CurrentUser?.HasPassword == false)
          {
            <div class="mt-4 mb-4 text-xs text-zinc-500">
              حساب شما رمز عبور ندارد و با کد پیامکی وارد می‌شوید. با تعیین رمز، ورود با رمز هم فعال می‌شود (ورود با کد پیامکی همچنان کار می‌کند).
            </div>
            <partial name="_ValidationSummary" />
          }
          else
          {
            <div class="mt-4 mb-4 text-xs text-zinc-500">
              برای تغییر رمز، رمز فعلی را وارد کنید.
            </div>
            <partial name="_ValidationSummary" />
            <div class="flex items-center justify-between text-sm text-zinc-700 mb-2">
              <span>رمز عبور فعلی</span>
              <a href="/profile/password?mode=forgot" class="text-xs text-sky-600 hover:text-sky-700">رمز فعلی را نمی‌دانم</a>
            </div>
            <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" class="@inputClass">
          }
          <div class="text-sm text-zinc-700 mt-5 mb-2">
            رمز عبور جدید
          </div>
          <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" class="@inputClass">
          <ul class="list-disc text-zinc-500 gap-y-3 flex flex-col mt-4 pr-8">
            @foreach (var rule in Fratak_Shop.Web.Pages.Profile.PasswordModel.Rules)
            {
              <li class="text-sm">
                @rule
              </li>
            }
          </ul>
          <div class="text-sm text-zinc-700 mt-5 mb-2">
            تکرار رمز عبور جدید
          </div>
          <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" class="@inputClass">
          <button type="submit" class="mx-auto w-full px-2 py-3 font-bold mt-8 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">
            ثبت رمز عبور جدید
          </button>
        </form>
        }

        @{
            var account = Model.CurrentUser;
            var twoFactorOn = account?.TwoFactorEnabled == true;
        }
        @if (Site.Settings.IsTwoFactorAvailable)
        {
        <section class="max-w-md mt-8 pt-6 border-t border-zinc-100" aria-labelledby="two-factor-title">
          <div class="flex items-center gap-x-2">
            @Icons.Svg("ShieldCheck", twoFactorOn ? "fill-green-500" : "fill-zinc-400", 24)
            <h2 id="two-factor-title" class="text-lg font-semibold text-zinc-800">ورود دو مرحله‌ای</h2>
            <span class="mr-auto rounded-full px-3 py-1 text-xs @(twoFactorOn ? "bg-green-50 text-green-600" : "bg-zinc-100 text-zinc-500")">
              @(twoFactorOn ? "فعال" : "غیرفعال")
            </span>
          </div>
          <p class="mt-3 text-sm leading-7 text-zinc-500">
            با فعال بودن این گزینه، هنگام ورود با رمز عبور یک کد تایید هم به شماره موبایل شما پیامک می‌شود و بدون آن کسی نمی‌تواند وارد حساب شما شود.
          </p>
          @if (account is not null && !account.HasPassword)
          {
            <p class="mt-3 rounded-lg bg-yellow-50 p-3 text-xs text-yellow-700">برای فعال‌سازی، ابتدا از فرم بالا یک رمز عبور برای حساب خود تعیین کنید.</p>
          }
          <form method="post" asp-page-handler="TwoFactor" class="mt-4">
            <input type="hidden" name="enable" value="@(twoFactorOn ? "false" : "true")" />
            <button type="submit" class="rounded-lg px-5 py-3 text-sm font-bold transition @(twoFactorOn ? "border border-red-200 text-red-500 hover:bg-red-50" : "bg-sky-500 text-white hover:bg-sky-400")"
                    disabled="@(account is null || (!twoFactorOn && !account.HasPassword))">
              @(twoFactorOn ? "غیرفعال کردن ورود دو مرحله‌ای" : "فعال کردن ورود دو مرحله‌ای")
            </button>
          </form>
        </section>
        }
      </div>
    </div>
  </main>
