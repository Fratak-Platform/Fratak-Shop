@page "/profile/tickets/new"
@model Fratak_Shop.Web.Pages.Profile.TicketNewModel
@using Fratak_Shop.Data.Entities.Support
@{
    Layout = "_Layout";
    var settings = Site.Settings;
    const string inputClass = "text-sm block w-full rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-gray-700 outline-none transition-all focus:border-sky-400";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.Tickets" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0 space-y-5">
        <nav class="text-xs text-zinc-400" aria-label="مسیر"><a href="/profile/tickets" class="hover:text-sky-600">تیکت‌ها</a><span class="mx-1">/</span>تیکت جدید</nav>
        <h1 class="text-zinc-800 text-lg font-semibold">ارسال تیکت جدید</h1>
        <partial name="_ValidationSummary" />
        <form method="post" enctype="multipart/form-data" class="grid gap-4 md:grid-cols-2">
          <div>
            <label for="Input_DepartmentId" class="mb-1 block text-xs text-zinc-600">بخش</label>
            <select id="Input_DepartmentId" name="Input.DepartmentId" required class="@inputClass">
              <option value="">انتخاب کنید</option>
              @foreach (var department in Model.Departments)
              {
                <option value="@department.Id" selected="@(Model.Input.DepartmentId == department.Id)" title="@department.Description">@department.Title</option>
              }
            </select>
          </div>
          <div>
            <label for="Input_Priority" class="mb-1 block text-xs text-zinc-600">اولویت</label>
            <select id="Input_Priority" name="Input.Priority" class="@inputClass">
              @foreach (var priority in new[] { TicketPriority.Low, TicketPriority.Normal, TicketPriority.High })
              {
                <option value="@((int)priority)" selected="@(Model.Input.Priority == priority)">@Fratak_Shop.Web.Pages.Profile.TicketsModel.PriorityText(priority)</option>
              }
            </select>
          </div>
          <div>
            <label for="Input_Subject" class="mb-1 block text-xs text-zinc-600">موضوع</label>
            <input id="Input_Subject" name="Input.Subject" value="@Model.Input.Subject" required minlength="3" maxlength="150" class="@inputClass">
          </div>
          <div>
            <label for="Input_OrderNumber" class="mb-1 block text-xs text-zinc-600">شماره سفارش (اختیاری)</label>
            <input id="Input_OrderNumber" name="Input.OrderNumber" value="@Model.Input.OrderNumber" maxlength="30" dir="ltr" class="@inputClass">
          </div>
          <div class="md:col-span-2">
            <label for="Input_Content" class="mb-1 block text-xs text-zinc-600">متن پیام</label>
            <textarea id="Input_Content" name="Input.Content" rows="6" required minlength="10" maxlength="4000" class="@inputClass">@Model.Input.Content</textarea>
          </div>
          <div class="md:col-span-2" data-review-images data-allow-pdf data-max="@settings.TicketMaxAttachments" data-max-kb="@settings.TicketMaxAttachmentSizeKb">
            <label class="flex cursor-pointer items-center justify-center gap-x-2 rounded-lg border border-dashed border-gray-300 px-3 py-3 text-sm text-zinc-600 transition hover:border-sky-400 hover:bg-sky-50">
              @Icons.Svg("Paperclip", "fill-sky-500", 20)
              <span>پیوست تصویر یا PDF (حداکثر @Format.Number(settings.TicketMaxAttachments) فایل، هر کدام تا @Format.Number(settings.TicketMaxAttachmentSizeKb) کیلوبایت)</span>
              <input type="file" name="Attachments" accept="image/jpeg,image/png,image/webp,application/pdf" multiple class="sr-only" data-review-images-input>
            </label>
            <div class="mt-2 grid grid-cols-3 gap-2 empty:hidden sm:grid-cols-6" data-review-images-preview></div>
          </div>
          <div class="md:col-span-2">
            <button type="submit" class="rounded-lg bg-sky-500 px-6 py-2.5 text-sm font-semibold text-white hover:bg-sky-400">ارسال تیکت</button>
          </div>
        </form>
      </div>
    </div>
  </main>
