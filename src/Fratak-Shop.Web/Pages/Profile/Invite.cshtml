@page "/profile/invite"
@model Fratak_Shop.Web.Pages.Profile.InviteModel
@{
    Layout = "_Layout";
    var settings = Site.Settings;
    var stats = Model.Stats;
    var shareText = string.IsNullOrWhiteSpace(settings.ReferralShareText)
        ? $"با لینک من در {settings.SiteName} ثبت‌نام کن و هدیه بگیر!"
        : settings.ReferralShareText;
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.Invite" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0 space-y-6">
        <div class="flex flex-wrap items-center gap-3">
          @Icons.Svg("UsersThree", "fill-sky-500", 28)
          <h1 class="text-zinc-800 text-lg font-semibold">دعوت از دوستان</h1>
        </div>

        <section class="rounded-2xl bg-gradient-to-l from-sky-500 to-cyan-400 p-5 text-white">
          <p class="text-sm leading-7">
            لینک یا کد زیر را برای دوستانتان بفرستید.
            @if (stats.SignupBonusPoints > 0)
            {
              <span>دوستتان با ثبت‌نام @Format.Number(stats.SignupBonusPoints) امتیاز هدیه می‌گیرد</span>
            }
            @if (stats.RewardPointsPerFriend > 0)
            {
              <span>و شما بعد از اولین خرید او @Format.Number(stats.RewardPointsPerFriend) امتیاز باشگاه دریافت می‌کنید.</span>
            }
          </p>
          @if (!string.IsNullOrWhiteSpace(stats.RewardDescription))
          {
            <p class="mt-1 text-xs opacity-90">@stats.RewardDescription</p>
          }
          @if (Model.InviteUrl is not null)
          {
            <div class="mt-4 space-y-2">
              <div class="flex items-center gap-2 rounded-xl bg-white/20 p-2">
                <span class="shrink-0 text-xs opacity-90">کد شما</span>
                <code class="flex-1 select-all text-center font-mono text-lg tracking-widest" dir="ltr">@stats.Code</code>
                <button type="button" data-copy="@stats.Code" class="rounded-lg bg-white px-2 py-1 text-sky-600 hover:bg-sky-50" aria-label="کپی کد">@Icons.Svg("Copy", "fill-sky-600", 16)</button>
              </div>
              <div class="flex items-center gap-2 rounded-xl bg-white/20 p-2">
                <span class="shrink-0 text-xs opacity-90">لینک دعوت</span>
                <code class="min-w-0 flex-1 truncate text-left font-mono text-xs" dir="ltr">@Model.InviteUrl</code>
                <button type="button" data-copy="@Model.InviteUrl" class="rounded-lg bg-white px-2 py-1 text-sky-600 hover:bg-sky-50" aria-label="کپی لینک">@Icons.Svg("Copy", "fill-sky-600", 16)</button>
                <button type="button" data-share="@Model.InviteUrl" data-share-title="@settings.SiteName" data-share-text="@shareText" class="rounded-lg bg-white px-2 py-1 text-sky-600 hover:bg-sky-50" aria-label="اشتراک‌گذاری">@Icons.Svg("ShareNetwork", "fill-sky-600", 16)</button>
              </div>
            </div>
          }
          else
          {
            <p class="mt-3 text-sm">کد دعوت شما هنوز آماده نیست؛ کمی بعد دوباره سر بزنید.</p>
          }
        </section>

        <section class="grid grid-cols-3 gap-3 text-center">
          <div class="rounded-xl border p-3"><div class="text-xs text-zinc-500">دعوت‌شده</div><div class="mt-1 text-xl font-bold text-zinc-700">@Format.Number(stats.InvitedCount)</div></div>
          <div class="rounded-xl border p-3"><div class="text-xs text-zinc-500">خرید کرده‌اند</div><div class="mt-1 text-xl font-bold text-emerald-600">@Format.Number(stats.PurchasedCount)</div></div>
          <div class="rounded-xl border p-3"><div class="text-xs text-zinc-500">امتیاز دریافتی</div><div class="mt-1 text-xl font-bold text-amber-500">@Format.Number(stats.PointsEarned)</div></div>
        </section>

        <section>
          <h2 class="mb-3 font-semibold text-zinc-700">دوستان دعوت‌شده</h2>
          @if (stats.Friends.Count == 0)
          {
            <p class="rounded-xl border border-dashed p-6 text-center text-sm text-zinc-400">هنوز کسی با لینک شما ثبت‌نام نکرده است.</p>
          }
          else
          {
            <ul class="divide-y rounded-xl border">
              @foreach (var friend in stats.Friends)
              {
                <li class="flex items-center justify-between gap-2 p-3 text-sm">
                  <span class="text-zinc-700">@friend.DisplayName</span>
                  <span class="text-xs text-zinc-400">@Format.Date(friend.JoinedAt)</span>
                  <span class="rounded-full px-2 py-0.5 text-[11px] @(friend.HasPurchased ? "bg-emerald-50 text-emerald-600" : "bg-zinc-100 text-zinc-500")">@(friend.HasPurchased ? "خرید کرده" : "هنوز خرید نکرده")</span>
                </li>
              }
            </ul>
          }
          <p class="mt-2 text-[11px] text-zinc-400">برای حفظ حریم خصوصی، فقط نام کوتاه دوستان نمایش داده می‌شود. دعوت از حساب‌های تکراری یا خودتان امتیازی ندارد.</p>
        </section>
      </div>
    </div>
  </main>
