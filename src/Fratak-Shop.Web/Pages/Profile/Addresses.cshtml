@page "/profile/addresses"
@model Fratak_Shop.Web.Pages.Profile.AddressesModel
@{
    Layout = "_Layout";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.Addresses" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0">
        <div>
          <div class="flex items-center justify-between mb-4">
            <h1 class="text-zinc-800 text-lg font-semibold">
              آدرس های من:
            </h1>
            <a href="/profile/addresses?new=1" data-ui="modal-open" data-arg="showEditAddress" class="text-zinc-50 cursor-pointer hover:text-zinc-100 transition bg-sky-500 hover:bg-sky-600 px-3 py-2 text-sm rounded-md">
              افزودن آدرس جدید
            </a>
          </div>
          @if (Model.Addresses.Count == 0)
          {
            <div class="text-center py-10 text-zinc-500">هنوز آدرسی ثبت نکرده اید.</div>
          }
          <div class="space-y-5">
            @foreach (var address in Model.Addresses)
            {
              <div class="border @(address.IsDefault ? "border-sky-400" : "border-zinc-300") rounded-md">
                <div class="border-b border-b-zinc-400 p-3 text-zinc-800 text-sm flex justify-between items-center gap-2 flex-wrap">
                  <span class="flex items-center gap-x-2">
                    <span class="font-semibold">@address.Title</span>
                    <span class="text-zinc-500">@address.ProvinceName - @address.CityName</span>
                    @if (address.IsDefault)
                    {
                      <span class="text-xs bg-sky-100 text-sky-700 rounded-full px-2 py-0.5">پیش فرض</span>
                    }
                  </span>
                  <span class="flex items-center gap-x-2">
                    @if (!address.IsDefault)
                    {
                      <form method="post" asp-page-handler="Default" asp-route-id="@address.Id">
                        <button type="submit" class="text-sky-600 hover:text-sky-700 text-xs">انتخاب به عنوان پیش فرض</button>
                      </form>
                    }
                    <a asp-page="/Profile/Addresses" asp-route-edit="@address.Id" class="text-zinc-50 cursor-pointer hover:text-zinc-100 transition bg-sky-500 hover:bg-sky-600 px-3 py-1 text-xs rounded-md">
                      ویرایش آدرس
                    </a>
                  </span>
                </div>
                <div class="px-5 py-4 text-zinc-600 fill-zinc-600 space-y-4 text-sm">
                  <div class="flex gap-x-1 items-center">
                    @Icons.Svg("MapPin")
                    @address.FullAddress
                  </div>
                  <div class="flex gap-x-1 items-center">
                    @Icons.Svg("Envelope")
                    @address.PostalCode
                  </div>
                  <div class="flex gap-x-1 items-center">
                    @Icons.Svg("Phone")
                    <span dir="ltr">@address.PhoneNumber</span>
                  </div>
                  <div class="flex gap-x-1 items-center">
                    @Icons.Svg("User")
                    @address.FirstName @address.LastName
                  </div>
                </div>
                <form method="post" asp-page-handler="Delete" asp-route-id="@address.Id" data-confirm="این آدرس حذف شود؟">
                  <button type="submit" class="text-zinc-50 hover:text-zinc-100 transition bg-red-500 hover:bg-red-600 px-3 py-1 block w-fit mb-2 mr-5 text-xs rounded-md">
                    حذف آدرس
                  </button>
                </form>
              </div>
            }
          </div>
          <!-- edit address modal -->
          <div class="max-w-2xl mx-auto relative">
            <!-- Main modal -->
            <div id="showEditAddress" data-modal data-open="@(Model.OpenModal ? "true" : "false")" class="overflow-x-hidden overflow-y-auto z-50 fixed h-modal h-full inset-0 justify-center items-center hidden">
                <div data-ui="modal-close" data-arg="showEditAddress" class="overflow-x-hidden overflow-y-auto fixed h-modal h-full inset-0 z-10 bg-gray-600 bg-opacity-50 w-full">
                </div>
                <div class="relative w-12/12 sm:w-10/12 lg:w-6/12 px-4 h-auto mb-4 z-50 mt-5 md:mt-10 mx-auto">
                  <!-- Modal content -->
                  <div class="bg-white rounded-lg shadow-lg relative overflow-y-visible">
                      <div class="flex justify-between items-center p-4 border-b">
                        <h3 class="text-gray-700">@(Model.Address.Id.HasValue ? "ویرایش آدرس" : "افزودن آدرس جدید")</h3>
                        <button data-ui="modal-close" data-arg="showEditAddress" type="button" aria-label="بستن" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 inline-flex items-center">
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>  
                        </button>
                      </div>
                      <form method="post" asp-page-handler="Save" class="space-y-6 px-6 lg:px-8 pb-4 sm:pb-6 pt-4">
                        <partial name="_AddressFields" model="new AddressFieldsModel(Model.Address, Model.Provinces)" />
                        <button type="submit" class="w-1/2 mx-auto mt-4 block py-3 text-sm bg-gradient-to-bl from-sky-500 to-sky-700 hover:opacity-80 transition text-gray-100 rounded-xl text-center">
                          ثبت تغییرات
                        </button>
                      </form>
                  </div>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
