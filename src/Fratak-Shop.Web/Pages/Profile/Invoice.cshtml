@page "/profile/orders/{orderNumber}/invoice"
@model Fratak_Shop.Web.Pages.Profile.InvoiceModel
@using Fratak_Shop.Data.Entities.Orders
@{
    Layout = null;
    var order = Model.Order;
    var settings = Site.Settings;
    var itemsDiscount = order.Items.Sum(i => i.DiscountAmount);
    var otherDiscount = order.DiscountAmount - order.CouponDiscountAmount;
    const string cell = "border border-zinc-300 px-2 py-2";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>@Site.Title($"فاکتور {order.OrderNumber}")</title>
  <link rel="icon" href="@Site.FaviconUrl">
  <link rel="stylesheet" href="~/assets/css/output.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/font.css" asp-append-version="true">
  <link rel="stylesheet" href="~/assets/css/style.css" asp-append-version="true">
</head>
<body class="bg-zinc-100 print:bg-white">
  <div class="mx-auto max-w-[900px] px-3 py-6 print:p-0">
    <div class="mb-4 flex flex-wrap items-center gap-2 print:hidden">
      <a href="/profile/orders/@order.OrderNumber.ToLowerInvariant()" class="rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm text-zinc-700 hover:bg-zinc-50">بازگشت به سفارش</a>
      <button type="button" data-invoice-pdf data-file-name="invoice-@(order.OrderNumber).pdf" class="mr-auto flex items-center gap-x-2 rounded-lg bg-sky-500 px-4 py-2 text-sm font-bold text-white hover:bg-sky-400 disabled:opacity-60">
        @Icons.Svg("Download", "fill-white", 18) دانلود PDF
      </button>
      <button type="button" data-ui="print" class="flex items-center gap-x-2 rounded-lg border border-zinc-300 bg-white px-4 py-2 text-sm text-zinc-700 hover:bg-zinc-50">
        @Icons.Svg("Printer", "fill-zinc-700", 18) چاپ
      </button>
    </div>

    <article id="invoice" class="bg-white p-6 md:p-8 text-zinc-800 shadow print:shadow-none text-[13px] leading-6">
      <header class="flex items-start justify-between gap-4 border-b-2 border-zinc-800 pb-4">
        <div>
          <img src="@Site.LogoUrl" alt="@settings.SiteName" class="h-10 w-auto" width="144" height="40">
          <div class="mt-2 font-bold">@(settings.OrganizationLegalName ?? settings.SiteName)</div>
        </div>
        <div class="text-center">
          <h1 class="text-lg font-extrabold">صورتحساب فروش کالا</h1>
          @if (order.PaymentStatus != PaymentStatus.Paid)
          {
            <div class="mt-1 text-xs text-red-600">(پیش‌فاکتور - پرداخت نشده)</div>
          }
        </div>
        <div class="text-left text-xs leading-6">
          <div>شماره: <span class="font-bold" dir="ltr">@order.OrderNumber</span></div>
          <div>تاریخ: @Format.Date(order.CreatedAt)</div>
          @if (order.PaidAt.HasValue)
          {
            <div>تاریخ پرداخت: @Format.Date(order.PaidAt.Value)</div>
          }
        </div>
      </header>

      <section class="mt-4 rounded border border-zinc-300">
        <div class="bg-zinc-100 px-3 py-1 text-xs font-bold">مشخصات فروشنده</div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-1 px-3 py-2 text-xs md:grid-cols-3">
          <div>نام: @(settings.OrganizationLegalName ?? settings.SiteName)</div>
          @if (!string.IsNullOrWhiteSpace(settings.SellerEconomicCode))
          {
            <div>کد اقتصادی: <span dir="ltr">@settings.SellerEconomicCode</span></div>
          }
          @if (!string.IsNullOrWhiteSpace(settings.SellerNationalId))
          {
            <div>شناسه ملی: <span dir="ltr">@settings.SellerNationalId</span></div>
          }
          @if (!string.IsNullOrWhiteSpace(settings.SellerRegistrationNumber))
          {
            <div>شماره ثبت: <span dir="ltr">@settings.SellerRegistrationNumber</span></div>
          }
          @if (!string.IsNullOrWhiteSpace(settings.SupportPhone))
          {
            <div>تلفن: <span dir="ltr">@settings.SupportPhone</span></div>
          }
          @if (!string.IsNullOrWhiteSpace(settings.PostalCode))
          {
            <div>کد پستی: <span dir="ltr">@settings.PostalCode</span></div>
          }
          @if (!string.IsNullOrWhiteSpace(settings.Address))
          {
            <div class="col-span-2 md:col-span-3">نشانی: @settings.Address</div>
          }
        </div>
      </section>

      <section class="mt-3 rounded border border-zinc-300">
        <div class="bg-zinc-100 px-3 py-1 text-xs font-bold">مشخصات خریدار</div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-1 px-3 py-2 text-xs md:grid-cols-3">
          <div>نام: @order.CustomerName</div>
          <div>تلفن: <span dir="ltr">@order.ShippingPhone</span></div>
          <div>کد پستی: <span dir="ltr">@order.ShippingPostalCode</span></div>
          <div class="col-span-2 md:col-span-3">نشانی: @order.ShippingProvince، @order.ShippingCity، @order.ShippingAddress @order.ShippingBuildingNumber @order.ShippingUnit</div>
        </div>
      </section>

      <table class="mt-4 w-full border-collapse text-center text-xs">
        <thead class="bg-zinc-100">
          <tr>
            <th class="@cell w-8">ردیف</th>
            <th class="@cell text-right">شرح کالا</th>
            <th class="@cell">کد کالا</th>
            <th class="@cell">تعداد</th>
            <th class="@cell">مبلغ واحد (تومان)</th>
            <th class="@cell">تخفیف (تومان)</th>
            <th class="@cell">مبلغ کل (تومان)</th>
          </tr>
        </thead>
        <tbody>
          @for (var i = 0; i < order.Items.Count; i++)
          {
            var item = order.Items[i];
            <tr class="break-inside-avoid">
              <td class="@cell">@(i + 1)</td>
              <td class="@cell text-right">@item.ProductName</td>
              <td class="@cell" dir="ltr">@item.SKU</td>
              <td class="@cell">@item.Quantity</td>
              <td class="@cell">@Format.Price(item.UnitPrice)</td>
              <td class="@cell">@Format.Price(item.DiscountAmount)</td>
              <td class="@cell font-bold">@Format.Price(item.TotalAmount)</td>
            </tr>
          }
        </tbody>
      </table>

      <div class="mt-4 flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
        <div class="text-xs leading-6 text-zinc-600 md:max-w-sm">
          <div>روش پرداخت: @Display.PaymentMethod(order.PaymentMethod) | وضعیت: @Display.PaymentStatus(order.PaymentStatus)</div>
          @if (!string.IsNullOrWhiteSpace(order.TransactionId))
          {
            <div>شناسه پرداخت: <span dir="ltr">@order.TransactionId</span></div>
          }
          @if (!string.IsNullOrWhiteSpace(order.ShippingMethod))
          {
            <div>روش ارسال: @order.ShippingMethod</div>
          }
          @if (!string.IsNullOrWhiteSpace(settings.InvoiceNote))
          {
            <p class="mt-2 whitespace-pre-line">@settings.InvoiceNote</p>
          }
        </div>
        <table class="w-full border-collapse text-xs md:w-80">
          <tbody>
            <tr><td class="@cell bg-zinc-50">جمع کل کالاها</td><td class="@cell text-left">@Format.Price(order.SubtotalAmount)</td></tr>
            @if (itemsDiscount > 0)
            {
              <tr><td class="@cell bg-zinc-50">تخفیف کالاها</td><td class="@cell text-left text-red-600">@Format.Price(itemsDiscount)-</td></tr>
            }
            @if (order.CouponDiscountAmount > 0)
            {
              <tr><td class="@cell bg-zinc-50">کد تخفیف <span dir="ltr">@order.CouponCode</span></td><td class="@cell text-left text-red-600">@Format.Price(order.CouponDiscountAmount)-</td></tr>
            }
            @if (otherDiscount > 0)
            {
              <tr><td class="@cell bg-zinc-50">سایر تخفیف‌ها</td><td class="@cell text-left text-red-600">@Format.Price(otherDiscount)-</td></tr>
            }
            <tr><td class="@cell bg-zinc-50">هزینه ارسال</td><td class="@cell text-left">@(order.ShippingAmount > 0 ? Format.Price(order.ShippingAmount) : "رایگان")</td></tr>
            <tr class="font-bold"><td class="@cell bg-zinc-100">مبلغ قابل پرداخت (تومان)</td><td class="@cell text-left text-base">@Format.Price(order.PayableAmount)</td></tr>
            @if (order.RefundedAmount > 0)
            {
              <tr><td class="@cell bg-zinc-50">مبلغ مسترد شده</td><td class="@cell text-left text-emerald-600">@Format.Price(order.RefundedAmount)</td></tr>
            }
          </tbody>
        </table>
      </div>

      <footer class="mt-10 grid grid-cols-2 gap-6 text-center text-xs text-zinc-500">
        <div class="border-t border-dashed border-zinc-300 pt-2">مهر و امضای فروشنده</div>
        <div class="border-t border-dashed border-zinc-300 pt-2">امضای خریدار</div>
      </footer>
    </article>
  </div>
  <script src="~/assets/js/main.js" asp-append-version="true"></script>
  <script src="~/assets/js/dependencies/html2pdf.bundle.min.js"></script>
  <script src="~/assets/js/invoice.js" asp-append-version="true"></script>
</body>
</html>
