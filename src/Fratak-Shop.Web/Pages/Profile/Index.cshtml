@page
@model Fratak_Shop.Web.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "پنل کاربری";
    Layout = "_Layout";
}

<div class="grid gap-6 lg:grid-cols-12">
    <aside class="lg:col-span-3">
        <partial name="_ProfileSidebar" />
    </aside>

    <section class="flex flex-col gap-6 lg:col-span-9">
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
            <div class="card flex items-center gap-x-3 p-4">
                <span class="stat-icon @Ui.StatTile("sky")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M230.14,58.87A8,8,0,0,0,224,56H62.68L56.6,22.57A8,8,0,0,0,48.73,16H24a8,8,0,0,0,0,16h18L67.56,172.29a24,24,0,0,0,5.33,11.27,28,28,0,1,0,44.4,8.44h45.42A27.75,27.75,0,0,0,160,204a28,28,0,1,0,28-28H91.17a8,8,0,0,1-7.87-6.57L80.13,152h116a24,24,0,0,0,23.61-19.71l12.16-66.86A8,8,0,0,0,230.14,58.87Z"></path></svg>
                </span>
                <div>
                    <p class="text-lg font-bold text-zinc-800">@Ui.Number(Model.Profile.OrdersCount)</p>
                    <p class="stat-label">سفارش</p>
                </div>
            </div>
            <div class="card flex items-center gap-x-3 p-4">
                <span class="stat-icon @Ui.StatTile("red")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M178,32c-20.65,0-38.73,8.88-50,23.89C116.73,40.88,98.65,32,78,32A62.07,62.07,0,0,0,16,94c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,220.66,240,164,240,94A62.07,62.07,0,0,0,178,32Z"></path></svg>
                </span>
                <div>
                    <p class="text-lg font-bold text-zinc-800">@Ui.Number(Model.Profile.FavoritesCount)</p>
                    <p class="stat-label">علاقه‌مندی</p>
                </div>
            </div>
            <div class="card flex items-center gap-x-3 p-4">
                <span class="stat-icon @Ui.StatTile("violet")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm16-40a8,8,0,0,1-8,8,16,16,0,0,1-16-16V128a8,8,0,0,1,0-16,16,16,0,0,1,16,16v40A8,8,0,0,1,144,176ZM112,84a12,12,0,1,1,12,12A12,12,0,0,1,112,84Z"></path></svg>
                </span>
                <div>
                    <p class="text-lg font-bold text-zinc-800">@Ui.Number(Model.Profile.UnreadNotifications)</p>
                    <p class="stat-label">اعلان خوانده‌نشده</p>
                </div>
            </div>
            <div class="card flex items-center gap-x-3 p-4">
                <span class="stat-icon @Ui.StatTile("green")">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 256 256"><path d="M128,16a88.1,88.1,0,0,0-88,88c0,75.3,80,132.17,83.41,134.55a8,8,0,0,0,9.18,0C136,236.17,216,179.3,216,104A88.1,88.1,0,0,0,128,16Z"></path></svg>
                </span>
                <div>
                    <p class="text-lg font-bold text-zinc-800">@Ui.Number(Model.Profile.AddressesCount)</p>
                    <p class="stat-label">آدرس</p>
                </div>
            </div>
        </div>

        <div class="card p-5">
            <div class="mb-4 flex items-center justify-between">
                <h2 class="section-title mb-0">آخرین سفارش‌ها</h2>
                <a class="text-xs text-sky-600 hover:text-sky-700" href="/profile/orders">همه سفارش‌ها</a>
            </div>

            @if (Model.RecentOrders.Count == 0)
            {
                <div class="empty-state">
                    <p class="font-semibold text-zinc-700">هنوز سفارشی ثبت نکرده‌اید</p>
                    <a class="btn-primary" href="/products">مشاهده محصولات</a>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="table-admin w-full">
                        <thead>
                            <tr>
                                <th>شماره سفارش</th>
                                <th>تاریخ</th>
                                <th>مبلغ</th>
                                <th>وضعیت</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="fa-num text-xs font-semibold text-zinc-700">@PriceHelper.ToEnglishDigits(order.OrderNumber)</td>
                                    <td class="text-xs text-zinc-500">@order.CreatedAt.ToPersianDate()</td>
                                    <td class="text-xs font-semibold text-zinc-700">@order.PayableAmount.ToToman()</td>
                                    <td><span class="badge @Ui.OrderStatusClass(order.Status)">@Ui.OrderStatusTitle(order.Status)</span></td>
                                    <td><a class="text-xs text-sky-600" href="/profile/orders/@order.Id">جزئیات</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
</div>
