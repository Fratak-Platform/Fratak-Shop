@page "/profile/alerts"
@model Fratak_Shop.Web.Pages.Profile.AlertsModel
@using Fratak_Shop.Data.Entities.Products
@{
    Layout = "_Layout";
    var active = Model.Items.Where(a => a.IsActive).ToList();
    var finished = Model.Items.Where(a => !a.IsActive).ToList();
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <div class="p-3 md:p-5 md:flex gap-5">
      <partial name="_ProfileSidebar" model="ProfileSection.Alerts" />
      <div class="md:w-9/12 bg-white shadow-lg rounded-2xl p-5 mt-5 md:mt-0 space-y-6">
        <div class="flex flex-wrap items-center gap-3">
          @Icons.Svg("Bell", "fill-sky-500", 28)
          <h1 class="text-zinc-800 text-lg font-semibold">خبرم کن</h1>
          <span class="text-xs text-zinc-400">@Format.Number(active.Count) مورد فعال</span>
        </div>
        <p class="text-sm leading-7 text-zinc-500">
          در صفحه هر کالا با دکمه «موجود شد خبرم کن» یا «خبرم کن وقتی قیمت کم شد» به این فهرست اضافه کنید.
          خبر از طریق اعلان سایت و (در صورت فعال بودن) اعلان مرورگر و پیامک ارسال می‌شود.
        </p>

        @if (Model.Items.Count == 0)
        {
          <div class="py-12 text-center text-zinc-500">
            @Icons.Svg("Bell", "fill-zinc-300 mx-auto mb-3", 48)
            هنوز درخواست «خبرم کن» ثبت نکرده‌اید.
          </div>
        }

        @foreach (var group in new[] { (Title: "فعال", Items: active), (Title: "انجام‌شده / پایان‌یافته", Items: finished) })
        {
          if (group.Items.Count == 0)
          {
            continue;
          }
          <section>
            <h2 class="mb-3 text-sm font-semibold text-zinc-600">@group.Title</h2>
            <ul class="space-y-3">
              @foreach (var alert in group.Items)
              {
                <li class="flex flex-wrap items-center gap-3 rounded-xl border p-3 @(alert.IsActive ? "" : "opacity-70")">
                  <a href="/product/@alert.ProductSlug" class="shrink-0">
                    <img src="@ImageHelper.Sized(ImageHelper.Product(alert.ImageName), 160, Site.Settings.IsImageOptimizationEnabled)" alt="" width="64" height="64" loading="lazy" class="h-16 w-16 rounded-lg object-contain">
                  </a>
                  <div class="min-w-0 flex-1">
                    <a href="/product/@alert.ProductSlug" class="line-clamp-1 text-sm text-zinc-700 hover:text-sky-600">@alert.ProductName</a>
                    <div class="mt-1 flex flex-wrap items-center gap-2 text-xs">
                      <span class="rounded-full px-2 py-0.5 @(alert.Type == ProductAlertType.BackInStock ? "bg-sky-50 text-sky-600" : "bg-rose-50 text-rose-600")">
                        @(alert.Type == ProductAlertType.BackInStock ? "موجود شد خبرم کن" : "کاهش قیمت")
                      </span>
                      @if (!alert.ProductIsActive)
                      {
                        <span class="text-red-400">کالا دیگر فروخته نمی‌شود</span>
                      }
                      else if (alert.IsAvailable)
                      {
                        <span class="text-zinc-500">قیمت فعلی: <b class="text-zinc-700">@Format.Toman(alert.CurrentFinalPrice)</b></span>
                      }
                      else
                      {
                        <span class="text-zinc-400">فعلاً ناموجود</span>
                      }
                      @if (alert.Type == ProductAlertType.PriceDrop)
                      {
                        <span class="text-zinc-400">قیمت هنگام ثبت: @Format.Toman(alert.PriceAtSubscribe)</span>
                      }
                    </div>
                    <div class="mt-1 text-[11px] text-zinc-400">
                      ثبت: @Format.Date(alert.CreatedAt)
                      @if (alert.NotifiedAt is { } notified)
                      {
                        <span> — خبر داده شد: @Format.Date(notified)@(alert.NotifiedPrice is { } price ? $" ({Format.Toman(price)})" : null)</span>
                      }
                    </div>
                  </div>
                  <form method="post" asp-page-handler="Delete" asp-route-id="@alert.Id" data-confirm="این مورد از فهرست «خبرم کن» حذف شود؟" data-confirm-ok="حذف" data-confirm-danger>
                    <button type="submit" class="rounded-lg border border-red-100 p-2 text-red-500 hover:bg-red-50" aria-label="حذف">@Icons.Svg("Trash", "fill-red-500", 18)</button>
                  </form>
                </li>
              }
            </ul>
          </section>
        }
      </div>
    </div>
  </main>
