@page
@model Fratak_Shop.Web.Pages.Profile.FavoritesModel
@{
    ViewData["Title"] = "علاقه‌مندی‌های من";
}

<div class="grid gap-6 lg:grid-cols-12">
    <aside class="lg:col-span-3">
        <partial name="_ProfileSidebar" />
    </aside>

    <section class="lg:col-span-9">
        <div class="card p-5">
            <h1 class="section-title">علاقه‌مندی‌های من</h1>

            @if (Model.Items.Count == 0)
            {
                <div class="empty-state">
                    <p class="font-semibold text-zinc-700">لیست علاقه‌مندی‌های شما خالی است</p>
                    <p class="text-xs text-zinc-500">با زدن آیکن قلب روی هر کالا، آن را برای بعد ذخیره کنید.</p>
                    <a class="btn-primary" href="/products">مشاهده محصولات</a>
                </div>
            }
            else
            {
                <div class="grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-4">
                    @foreach (var product in Model.Items)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            }
        </div>
    </section>
</div>
