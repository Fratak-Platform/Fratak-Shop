@page "/verify-email"
@model VerifyEmailModel
@*
  تأیید ایمیل (مرحلهٔ دوازدهم): لینک ایمیل → این صفحه → دکمهٔ «تأیید ایمیل» (POST). منطق: Infrastructure/Email/EmailVerification.cs.
*@
@{
    Layout = "_LayoutMinimal";
}

  <main class="max-w-[1600px] mx-auto">
    <div class="flex justify-center items-center min-h-screen py-10">
      <div class="bg-white rounded-3xl shadow-xl border border-zinc-100 w-11/12 sm:w-7/12 md:w-6/12 lg:w-4/12 h-auto py-6 px-5 text-center">
        <div class="flex justify-center mb-4">
          @await Html.PartialAsync("_BrandLockup", new BrandLockupModel(BrandPlace.Auth))
        </div>
        @if (Model.Confirmed is true)
        {
          <div class="flex justify-center mb-3">@Icons.Svg("CheckCircle", "fill-green-500", 48)</div>
          <h1 class="text-lg font-semibold text-zinc-800 mb-2">ایمیل تأیید شد</h1>
          <p class="text-sm text-zinc-600 leading-7">@Model.Outcome</p>
          <a href="/profile/info" class="mx-auto block w-full px-2 py-3 font-bold mt-6 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">اطلاعات حساب</a>
        }
        else if (Model.Confirmed is false || !Model.IsValid)
        {
          <div class="flex justify-center mb-3">@Icons.Svg("XCircle", "fill-red-500", 48)</div>
          <h1 class="text-lg font-semibold text-zinc-800 mb-2">لینک قابل استفاده نیست</h1>
          <p class="text-sm text-zinc-600 leading-7">@(Model.Outcome ?? "لینک تأیید نامعتبر یا منقضی است (اعتبار هر لینک ۲۴ ساعت است). از صفحهٔ اطلاعات حساب، لینک تازه بخواهید.")</p>
          <a href="/profile/info" class="mx-auto block w-full px-2 py-3 font-bold mt-6 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">درخواست لینک تازه</a>
        }
        else
        {
          <div class="flex justify-center mb-3">@Icons.Svg("Envelope", "fill-sky-500", 48)</div>
          <h1 class="text-lg font-semibold text-zinc-800 mb-2">تأیید نشانی ایمیل</h1>
          <p class="text-sm text-zinc-600 leading-7">برای تأیید <span dir="ltr" class="font-semibold">@Model.MaskedEmail</span> به‌عنوان ایمیل حساب کاربری خود در @Site.Settings.SiteName، دکمهٔ زیر را بزنید.</p>
          <form method="post" class="mt-6">
            <input type="hidden" name="token" value="@Model.Token">
            <button type="submit" class="mx-auto block w-full px-2 py-3 font-bold bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg">تأیید ایمیل</button>
          </form>
        }
        <a href="/" class="mt-5 inline-block text-sm text-sky-600 hover:text-sky-500 transition">صفحهٔ اصلی فروشگاه</a>
      </div>
    </div>
  </main>
