@page
@model Fratak_Shop.Web.Pages.Auth.VerifyModel
@{
    ViewData["Title"] = "تأیید شماره موبایل";
    var digits = Fratak_Shop.Core.Utilities.PriceHelper.ToPersianDigits(Model.PhoneNumber);
}

<div class="mx-auto max-w-md">
    <div class="card p-6 md:p-8">
        <div class="mb-6 text-center">
            <span class="stat-icon mx-auto mb-3 @Ui.StatTile("sky")">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l-21.12-47.16c-3.18-7.15-11.01-11.3-18.6-9.86-23.85,4.5-39.69,13.9-45.61,27.36a54.63,54.63,0,0,0-3.53,36.76c14.9,66.65,83,132.93,150.15,149.09a75.62,75.62,0,0,0,18.83,2.31c13.56,0,23.5-4.25,31.11-13.28,10.83-12.87,16.65-26.76,18.75-34.6C226.65,169,229.17,161.4,222.37,158.46Z"></path></svg>
            </span>
            <h1 class="text-lg font-bold text-zinc-800">کد تأیید را وارد کنید</h1>
            <p class="mt-1 text-xs text-zinc-500">کد به شماره @digits ارسال شد.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.DevelopmentCode))
        {
            <div class="alert-info mb-4 text-center">
                حالت توسعه: کد تأیید شما <strong class="fa-num">@Fratak_Shop.Core.Utilities.PriceHelper.ToPersianDigits(Model.DevelopmentCode)</strong> است.
            </div>
        }

        <form method="post" class="flex flex-col gap-y-4">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>
            <div>
                <label class="form-label" for="Code">کد تأیید</label>
                <input class="form-input text-center text-lg tracking-[0.6em]" id="Code" name="Code" inputmode="numeric" maxlength="6" autofocus />
            </div>
            <button type="submit" class="btn-primary w-full">تأیید و ورود</button>
        </form>

        <div class="mt-4 flex items-center justify-between text-xs">
            <a class="text-sky-600 hover:text-sky-700" asp-page="/Auth/Verify" asp-route-resend="true">ارسال دوباره کد</a>
            <a class="text-zinc-500 hover:text-zinc-700" asp-page="/Auth/Register">ویرایش شماره موبایل</a>
        </div>
    </div>
</div>
