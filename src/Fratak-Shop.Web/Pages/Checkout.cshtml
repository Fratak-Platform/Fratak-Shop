@page
@model Fratak_Shop.Web.Pages.CheckoutModel
@{
    ViewData["Title"] = "تسویه حساب";
    var summary = Model.Summary;
}

<partial name="_Breadcrumbs" model="new List<BreadcrumbDto> { new() { Title = \"سبد خرید\", Url = \"/cart\" }, new() { Title = \"تسویه حساب\", Url = \"/checkout\" } }" />

<form method="post" class="grid gap-6 lg:grid-cols-12">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Input.PaymentMethod" id="paymentMethodInput" />
    <input type="hidden" asp-for="Input.ShippingMethodId" id="shippingMethodInput" />
    <input type="hidden" asp-for="Input.CouponCode" />

    <div class="flex flex-col gap-6 lg:col-span-8">
        @* ------------------------------------------------------------- addresses *@
        <section class="card p-5">
            <h2 class="section-title">اطلاعات گیرنده و آدرس</h2>

            @if (Model.SavedAddresses.Count > 0)
            {
                <div class="mb-4 grid gap-3 md:grid-cols-2">
                    @foreach (var address in Model.SavedAddresses)
                    {
                        <label class="flex cursor-pointer items-start gap-x-2 rounded-xl border p-3 text-xs text-zinc-600 hover:border-sky-400">
                            <input type="radio" class="form-radio mt-0.5" name="addressPicker" data-address="@address.Id" />
                            <span>
                                <span class="mb-1 block font-semibold text-zinc-800">@address.Title</span>
                                @address.AddressLine
                                @if (!string.IsNullOrWhiteSpace(address.PostalCode))
                                {
                                    <span class="mt-1 block text-zinc-400">کد پستی: @PriceHelper.ToPersianDigits(address.PostalCode)</span>
                                }
                            </span>
                        </label>
                    }
                </div>
            }

            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="form-label" asp-for="Input.CustomerName">نام و نام خانوادگی <span class="text-rose-500">*</span></label>
                    <input class="form-input" asp-for="Input.CustomerName" />
                    <span class="form-error" asp-validation-for="Input.CustomerName"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.CustomerPhone">شماره تماس <span class="text-rose-500">*</span></label>
                    <input class="form-input text-left" asp-for="Input.CustomerPhone" dir="ltr" inputmode="numeric" placeholder="09xxxxxxxxx" />
                    <span class="form-error" asp-validation-for="Input.CustomerPhone"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ShippingProvince">استان <span class="text-rose-500">*</span></label>
                    <select class="form-input" asp-for="Input.ShippingProvince" id="provinceSelect">
                        <option value="">انتخاب استان...</option>
                        @foreach (var province in Model.Provinces)
                        {
                            <option value="@province.Name">@province.Name</option>
                        }
                    </select>
                    <span class="form-error" asp-validation-for="Input.ShippingProvince"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ShippingCity">شهر <span class="text-rose-500">*</span></label>
                    <select class="form-input" asp-for="Input.ShippingCity" id="citySelect">
                        <option value="">انتخاب شهر...</option>
                    </select>
                    <span class="form-error" asp-validation-for="Input.ShippingCity"></span>
                </div>
                <div class="md:col-span-2">
                    <label class="form-label" asp-for="Input.ShippingAddress">نشانی کامل <span class="text-rose-500">*</span></label>
                    <textarea class="form-input" asp-for="Input.ShippingAddress" rows="2"></textarea>
                    <span class="form-error" asp-validation-for="Input.ShippingAddress"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ShippingBuildingNumber">پلاک</label>
                    <input class="form-input" asp-for="Input.ShippingBuildingNumber" />
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ShippingUnit">واحد</label>
                    <input class="form-input" asp-for="Input.ShippingUnit" />
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ShippingPostalCode">کد پستی <span class="text-rose-500">*</span></label>
                    <input class="form-input text-left" asp-for="Input.ShippingPostalCode" dir="ltr" inputmode="numeric" />
                    <span class="form-error" asp-validation-for="Input.ShippingPostalCode"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Input.ShippingPhone">تلفن گیرنده</label>
                    <input class="form-input text-left" asp-for="Input.ShippingPhone" dir="ltr" inputmode="numeric" />
                </div>
                <div class="md:col-span-2">
                    <label class="form-label" asp-for="Input.CustomerNote">توضیحات سفارش (اختیاری)</label>
                    <textarea class="form-input" asp-for="Input.CustomerNote" rows="2" placeholder="زمان تحویل، توضیح خاص و ..."></textarea>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <label class="flex items-center gap-x-2 text-xs text-zinc-600 md:col-span-2">
                        <input type="checkbox" class="form-checkbox" asp-for="Input.SaveAddress" />
                        این آدرس در دفترچه آدرس‌های من ذخیره شود.
                    </label>
                }
            </div>
        </section>

        @* --------------------------------------------------------- shipping ways *@
        <section class="card p-5">
            <h2 class="section-title">روش ارسال</h2>
            <div class="grid gap-3 md:grid-cols-2">
                @foreach (var method in summary.ShippingMethods)
                {
                    var selected = summary.SelectedShippingMethodId == method.Id || (summary.SelectedShippingMethodId is null && method == summary.ShippingMethods.First());
                    <label class="flex cursor-pointer items-start gap-x-3 rounded-xl border p-3 text-xs transition hover:border-sky-400 @(selected ? "border-sky-500 bg-sky-50/50" : null)">
                        <input type="radio" class="form-radio mt-0.5 shipping-option" name="shippingPicker" value="@method.Id"
                               data-cost="@method.Cost" checked="@selected" />
                        <span class="flex-1">
                            <span class="mb-1 block text-sm font-semibold text-zinc-800">@method.Name</span>
                            @if (!string.IsNullOrWhiteSpace(method.Description))
                            {
                                <span class="block text-[11px] leading-5 text-zinc-500">@method.Description</span>
                            }
                            @if (method.EstimatedDeliveryDays is > 0)
                            {
                                <span class="mt-1 block text-[11px] text-zinc-400">تحویل حدوداً @Ui.Number(method.EstimatedDeliveryDays.Value) روز کاری</span>
                            }
                        </span>
                        <span class="shrink-0 text-xs font-semibold text-zinc-700">
                            @(method.Cost == 0 ? "رایگان" : method.Cost.ToToman())
                        </span>
                    </label>
                }
            </div>
        </section>

        @* -------------------------------------------------------- payment methods *@
        <section class="card p-5">
            <h2 class="section-title">روش پرداخت</h2>
            <div class="grid gap-3 md:grid-cols-3">
                @foreach (var option in summary.PaymentOptions)
                {
                    var isSelected = summary.AvailablePaymentMethods.FirstOrDefault() == option.Method;
                    <label class="flex cursor-pointer flex-col gap-y-2 rounded-xl border p-4 text-xs transition hover:border-sky-400 @(isSelected ? "border-sky-500 bg-sky-50/50" : null)">
                        <span class="flex items-center gap-x-2">
                            <input type="radio" class="form-radio payment-option" name="paymentPicker" value="@((int)option.Method)" checked="@isSelected" />
                            <span class="text-sm font-semibold text-zinc-800">@option.Title</span>
                        </span>
                        <span class="leading-6 text-zinc-500">@option.Description</span>
                    </label>
                }
            </div>

            @if (summary.BankTransfer is not null && summary.IsBankTransferEnabled)
            {
                <div class="mt-4 rounded-xl bg-zinc-50 p-4 text-xs leading-6 text-zinc-600" id="bankTransferHint">
                    <p class="mb-2 font-semibold text-zinc-800">اطلاعات کارت به کارت</p>
                    @foreach (var card in summary.BankTransfer.Cards)
                    {
                        <p>
                            کارت @card.BankName به نام <strong>@card.AccountHolder</strong>:
                            <span class="fa-num font-bold text-zinc-800">@Fratak_Shop.Core.Utilities.PriceHelper.ToEnglishDigits(card.CardNumber)</span>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(summary.BankTransfer.Instructions))
                    {
                        <p class="mt-2">@summary.BankTransfer.Instructions</p>
                    }
                    <p class="mt-2 text-amber-600">پس از ثبت سفارش، اطلاعات واریز و تصویر فیش را در صفحه سفارش ثبت کنید. مهلت: @Ui.Number(summary.BankTransfer.DeadlineHours) ساعت.</p>
                </div>
            }
        </section>
    </div>

    @* ------------------------------------------------------------------ summary *@
    <aside class="lg:col-span-4">
        <div class="card sticky top-40 p-5">
            <h2 class="mb-4 text-sm font-bold text-zinc-800">سفارش شما</h2>

            <div class="mb-4 max-h-64 overflow-y-auto border-b border-zinc-100 pb-4">
                @foreach (var item in summary.Cart.Items)
                {
                    <div class="mb-3 flex items-center gap-x-3 last:mb-0">
                        <img class="h-12 w-12 shrink-0 rounded-lg border object-contain p-0.5" src="@Ui.ProductImage(item.Product.ImageName)" alt="@item.Product.Name" />
                        <div class="flex-1">
                            <p class="line-clamp-1 text-xs font-semibold text-zinc-700">@item.Product.Name</p>
                            <span class="text-[11px] text-zinc-400">@Ui.Number(item.Quantity) × @item.Product.FinalPrice.ToToman()</span>
                        </div>
                    </div>
                }
            </div>

            <ul class="mb-4 flex flex-col gap-y-2 text-xs text-zinc-600">
                <li class="flex justify-between">
                    <span>جمع کالاها</span>
                    <span id="summarySubtotal">@summary.Cart.Subtotal.ToToman()</span>
                </li>
                @if (summary.Cart.ProductDiscount > 0)
                {
                    <li class="flex justify-between text-rose-500">
                        <span>تخفیف کالاها</span>
                        <span>@summary.Cart.ProductDiscount.ToToman()</span>
                    </li>
                }
                @if (summary.Cart.CouponDiscount > 0)
                {
                    <li class="flex justify-between text-emerald-600">
                        <span>کد تخفیف @summary.Cart.CouponCode</span>
                        <span>@summary.Cart.CouponDiscount.ToToman()</span>
                    </li>
                }
                <li class="flex justify-between">
                    <span>هزینه ارسال</span>
                    <span id="summaryShipping">@summary.Cart.ShippingAmount.ToToman()</span>
                </li>
            </ul>

            <div class="flex items-center justify-between border-t border-zinc-100 pt-4">
                <span class="text-sm text-zinc-500">مبلغ قابل پرداخت</span>
                <span class="text-lg font-bold text-zinc-800" id="summaryPayable">@summary.Cart.PayableAmount.ToToman()</span>
            </div>

            <button type="submit" class="btn-primary mt-5 w-full">ثبت نهایی سفارش</button>
            <p class="mt-3 text-[11px] leading-5 text-zinc-400">
                با ثبت سفارش،
                <a class="text-sky-600" href="/rules">قوانین فروشگاه</a>
                را می‌پذیرید.
            </p>
        </div>
    </aside>
</form>

@section Scripts {
    <script>
        (function () {
            const province = document.getElementById("provinceSelect");
            const city = document.getElementById("citySelect");
            const shippingInput = document.getElementById("shippingMethodInput");
            const paymentInput = document.getElementById("paymentMethodInput");

            const cityApi = "/api/locations?handler=Cities&provinceId=";

            async function loadCities() {
                const selected = province.value;
                city.innerHTML = '<option value="">انتخاب شهر...</option>';
                if (!selected) {
                    return;
                }

                const option = province.options[province.selectedIndex];
                const response = await fetch("/api/locations?handler=Cities&provinceId=" + option.dataset.id);
                if (!response.ok) {
                    return;
                }

                const items = await response.json();
                items.forEach(item => city.insertAdjacentHTML("beforeend", `<option value="${item.name}">${item.name}</option>`));
            }

            // Province options carry their id so the city endpoint can be called.
            fetch("/api/locations?handler=Provinces")
                .then(response => response.ok ? response.json() : [])
                .then(items => {
                    const current = province.value;
                    province.innerHTML = '<option value="">انتخاب استان...</option>' +
                        items.map(item => `<option value="${item.name}" data-id="${item.id}">${item.name}</option>`).join("");
                    if (current) {
                        province.value = current;
                    }
                    loadCities();
                });

            province.addEventListener("change", loadCities);

            document.querySelectorAll(".shipping-option").forEach(option => {
                option.addEventListener("change", () => {
                    shippingInput.value = option.value;
                    updateTotals();
                });
            });

            function updateTotals() {
                const form = document.querySelector("form");
                const selected = document.querySelector(".shipping-option:checked");
                const cost = selected ? parseInt(selected.dataset.cost || "0", 10) : 0;
                const payable = parseInt(form.dataset.payable || "0", 10) + cost;
                const shippingLabel = cost === 0 ? "رایگان" : cost.toLocaleString("fa-IR");
                document.getElementById("summaryShipping").textContent = shippingLabel;
                document.getElementById("summaryPayable").textContent = payable.toLocaleString("fa-IR");
            }

            document.querySelector("form").dataset.payable = "@((long)summary.Cart.PayableAmount - (long)summary.Cart.ShippingAmount)";
            updateTotals();

            document.querySelectorAll(".payment-option").forEach(option => {
                option.addEventListener("change", () => {
                    paymentInput.value = option.value;
                });
            });

            document.querySelectorAll("[data-address]").forEach(radio => {
                radio.addEventListener("change", async () => {
                    const response = await fetch("/api/addresses?handler=Address&id=" + radio.dataset.address);
                    if (!response.ok) {
                        return;
                    }
                    const address = await response.json();
                    document.getElementById("Input_CustomerName").value = address.fullName ?? "";
                    document.getElementById("Input_CustomerPhone").value = address.phoneNumber ?? "";
                    document.getElementById("Input_ShippingProvince").value = address.province ?? "";
                    document.getElementById("Input_ShippingCity").value = address.city ?? "";
                    document.getElementById("Input_ShippingAddress").value = address.addressLine ?? "";
                    document.getElementById("Input_ShippingPostalCode").value = address.postalCode ?? "";
                });
            });
        })();
    </script>
}
