@page "/checkout"
@model CheckoutModel
@{
    Layout = "_Layout";
    var cart = Model.Cart;
    const string optionLabel = "inline-flex items-center justify-center w-full p-3 text-gray-600 bg-white border-2 border-gray-200 rounded-lg cursor-pointer peer-checked:border-sky-400 peer-checked:text-sky-600 hover:text-gray-600 hover:bg-gray-100";
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
      <div class="w-full h-px bg-zinc-300">
      </div>
      <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
        تکمیل سفارش
      </div>
      <div class="w-full h-px bg-zinc-300">
      </div>
    </span>
    <div class="flex flex-col md:flex-row gap-5">
      <form method="post" asp-page-handler="PlaceOrder" id="checkoutForm" class="md:w-8/12 bg-white border rounded-xl shadow-lg p-4">
        <div class="p-2 sm:p-4 mb-10">
          <div class="flex justify-between gap-x-1 items-center text-zinc-600 border-b pb-2 mb-4 text-lg font-semibold">
            <div>
              آدرس تحویل سفارش
            </div>
            <a onclick="showEditAddress()" class="text-base font-normal text-sky-700 cursor-pointer" href="#" role="button">
              افزودن آدرس جدید
            </a>
          </div>
          @if (Model.Addresses.Count == 0)
          {
            <div class="text-zinc-600 text-lg">
              هنوز آدرسی ثبت نکرده اید؛ برای ادامه یک آدرس اضافه کنید.
            </div>
          }
          <ul class="grid gap-3">
            @foreach (var address in Model.Addresses)
            {
              <li>
                <input type="radio" id="address-@address.Id" name="Input.AddressId" value="@address.Id" class="hidden peer" required checked="@(address.Id == Model.Input.AddressId ? "checked" : null)">
                <label for="address-@address.Id" class="block w-full p-4 text-gray-600 bg-white border-2 border-gray-200 rounded-lg cursor-pointer peer-checked:border-sky-400 hover:bg-gray-50">
                  <div class="flex items-center justify-between">
                    <span class="font-semibold text-zinc-700">@address.Title</span>
                    @if (address.IsDefault)
                    {
                      <span class="text-xs bg-sky-100 text-sky-700 rounded-full px-2 py-1">پیش فرض</span>
                    }
                  </div>
                  <div class="text-zinc-600 mt-2">@address.FullAddress</div>
                  <div class="text-xs text-zinc-500 mt-2 flex flex-wrap gap-x-4">
                    <span>گیرنده: @address.FirstName @address.LastName</span>
                    <span dir="ltr">@address.PhoneNumber</span>
                    <span>کد پستی: @address.PostalCode</span>
                  </div>
                </label>
              </li>
            }
          </ul>
        </div>
        <div class="p-2 sm:p-4 mb-10">
          <div class="flex gap-x-1 items-center text-zinc-600 border-b pb-2 mb-4 text-lg font-semibold">
            انتخاب روز تحویل کالا
          </div>
          <ul class="grid w-full gap-6 grid-cols-3 md:grid-cols-6">
            @foreach (var day in Model.DeliveryDays)
            {
              <li>
                <input type="radio" id="day-@day.Value" name="Input.DeliveryDate" value="@day.Value" class="hidden peer" checked="@(day.Value == Model.Input.DeliveryDate ? "checked" : null)">
                <label for="day-@day.Value" class="@optionLabel">
                  <div class="text-center">
                    <div class="mb-1">@Format.DayName(day.Date)</div>
                    <div class="text-sm">@Format.DayOfMonth(day.Date) @Format.MonthName(day.Date)</div>
                  </div>
                </label>
              </li>
            }
          </ul>
        </div>
        <div class="grid md:grid-cols-2 ">
          <div class="p-2 sm:p-4">
            <div class="flex gap-x-1 items-center text-zinc-600 border-b pb-2 mb-4 text-lg font-semibold">
              انتخاب نوع ارسال کالا
            </div>
            <ul class="grid grid-cols-1 sm:grid-cols-2 w-full gap-3">
              @foreach (var method in Model.Shop.ShippingMethods)
              {
                var cost = Model.ShippingCost(method);
                <li>
                  <input type="radio" id="ship-@method.Code" name="Input.ShippingMethod" value="@method.Code" class="hidden peer" required data-shipping-cost="@cost" checked="@(method.Code == Model.Input.ShippingMethod ? "checked" : null)">
                  <label for="ship-@method.Code" class="@optionLabel" title="@method.Description">
                    <div class="text-center">
                      <div class="text-sm">@method.Title</div>
                      <div class="text-xs mt-1">@(cost == 0 ? "رایگان" : Format.Toman(cost))</div>
                    </div>
                  </label>
                </li>
              }
            </ul>
          </div>
          <div class="p-2 sm:p-4">
            <div class="flex gap-x-1 items-center text-zinc-600 border-b pb-2 mb-4 text-lg font-semibold">
              انتخاب نوع پرداخت
            </div>
            <ul class="grid grid-cols-1 sm:grid-cols-2 w-full gap-3">
              @foreach (var payment in CheckoutModel.PaymentMethods)
              {
                <li>
                  <input type="radio" id="pay-@payment.Method" name="Input.PaymentMethod" value="@payment.Method" class="hidden peer" checked="@(payment.Method == Model.Input.PaymentMethod ? "checked" : null)">
                  <label for="pay-@payment.Method" class="@optionLabel gap-x-2">
                    @Icons.Svg(payment.Icon, "max-w-12 fill-sky-800")
                    <div class="text-center">
                      <span class="text-sm">@payment.Title</span>
                    </div>
                  </label>
                </li>
              }
            </ul>
          </div>
        </div>
        <div class="p-2 sm:p-4">
          <label class="text-sm text-zinc-700 flex mb-2" for="Input_Note">توضیحات سفارش</label>
          <textarea id="Input_Note" name="Input.Note" placeholder="نکات مهم درباره تحویل محصول" cols="30" rows="4" maxlength="1000" class="focus:shadow-primary-outline text-sm leading-5.6 ease block w-full appearance-none rounded-lg border border-solid border-gray-300 bg-white bg-clip-padding px-3 py-2 font-normal text-gray-700 outline-none transition-all focus:border-sky-400 focus:outline-none">@Model.Input.Note</textarea>
        </div>
      </form>
      <div class="bg-white border rounded-xl shadow-lg p-4 md:w-4/12 h-fit space-y-5">
        <div class="p-3" data-checkout-summary data-payable="@cart.PayableAmount">
          <div class="flex gap-x-1 justify-between items-center text-zinc-600 px-2 py-3 font-semibold">
            <div>
              قیمت کالاها (@cart.TotalQuantity)
            </div>
            <div class="flex gap-x-1">
              <div>@Format.Price(cart.SubtotalAmount)</div>
              <div>تومان</div>
            </div>
          </div>
          @if (cart.TotalDiscountAmount > 0)
          {
            <div class="flex gap-x-1 justify-between items-center text-red-500 font-semibold mt-3 px-2 py-3">
              <div>
                تخفیف
              </div>
              <div class="flex gap-x-1">
                <div>@Format.Price(cart.TotalDiscountAmount)</div>
                <div>تومان</div>
              </div>
            </div>
          }
          <div class="flex gap-x-1 justify-between items-center text-zinc-600 font-semibold mt-3 px-2 py-3">
            <div>
              هزینه ارسال
            </div>
            <div class="flex gap-x-1">
              <div data-shipping-output>@(Model.IsFreeShipping ? "رایگان" : "-")</div>
            </div>
          </div>
          <div class="flex gap-x-1 justify-between items-center text-zinc-800 mt-5 px-2 pt-5 font-black border-t">
            <div>
              مبلغ قابل پرداخت
            </div>
            <div class="flex gap-x-1">
              <div data-total-output>@Format.Price(cart.PayableAmount)</div>
              <div>تومان</div>
            </div>
          </div>
          @if (Model.Shop.FreeShippingThreshold > 0 && !Model.IsFreeShipping)
          {
            <p class="text-xs text-zinc-500 px-2 mt-3">با افزودن @Format.Toman(Model.Shop.FreeShippingThreshold - cart.PayableAmount) دیگر، ارسال رایگان می شود.</p>
          }
          <button type="submit" form="checkoutForm" class="mx-auto block text-center w-full px-2 py-3 mt-8 bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-lg" disabled="@(Model.Addresses.Count == 0 ? "disabled" : null)">
            تکمیل سفارش و پرداخت
          </button>
          <a asp-page="/Cart" class="block text-center text-sm text-sky-600 mt-4">بازگشت به سبد خرید</a>
        </div>
      </div>
    </div>
    <!-- add address modal -->
          <div class="max-w-2xl mx-auto relative">
            <!-- Main modal -->
            <div id="showEditAddress" class="overflow-x-hidden overflow-y-auto z-50 fixed h-modal h-full inset-0 justify-center items-center hidden">
                <div onclick="closeEditAddress()" class="overflow-x-hidden overflow-y-auto fixed h-modal h-full inset-0 z-10 bg-gray-600 bg-opacity-50 w-full">
                </div>
                <div class="relative w-12/12 sm:w-10/12 lg:w-6/12 px-4 h-auto mb-4 z-50 mt-5 md:mt-10 mx-auto">
                  <!-- Modal content -->
                  <div class="bg-white rounded-lg shadow-lg relative overflow-y-visible">
                      <div class="flex justify-between items-center p-4 border-b">
                        <h3 class="text-gray-700">افزودن آدرس جدید</h3>
                        <button onclick="closeEditAddress()" type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 inline-flex items-center">
                          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>  
                        </button>
                      </div>
                      <form method="post" asp-page-handler="AddAddress" class="space-y-6 px-6 lg:px-8 pb-4 sm:pb-6 pt-4">
                        <partial name="_AddressFields" model="new AddressFieldsModel(Model.Address, Model.Provinces)" />
                        <button type="submit" class="w-1/2 mx-auto mt-2 block py-3 text-sm bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-xl text-center">
                          ثبت آدرس
                        </button>
                      </form>
                  </div>
                </div>
            </div>
          </div>
  </main>
