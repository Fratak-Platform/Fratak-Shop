@page "/checkout/failed/{orderNumber}"
@model CheckoutFailedModel
@{
    Layout = "_Layout";
    ViewData[PageMetaKeys.SitePage] = Fratak_Shop.Data.Entities.Pages.SitePage.Checkout;
    var order = Model.Order;
}

  <main class="pt-24 md:pt-36 max-w-[1600px] mx-auto px-3 md:px-6">
    <span class="flex items-center justify-center mt-4 mb-8 md:mt-10 md:mb-14 gap-x-5">
      <div class="w-full h-px bg-zinc-300">
      </div>
      <div class="text-xl md:text-4xl font-semibold text-zinc-700 min-w-max text-center">
        پرداخت ناموفق
      </div>
      <div class="w-full h-px bg-zinc-300">
      </div>
    </span>
    <div class="bg-white border rounded-xl shadow-lg p-4">
      @Icons.Svg("XCircle", "mx-auto fill-red-500 mt-12", 70)
      <div class="text-red-500 text-center text-lg font-semibold mt-2">
        پرداخت با شکست انجام شد
      </div>
      <div class="text-red-400 text-center text-sm mt-2">
        @if (order.IsAwaitingPayment(DateTimeOffset.UtcNow))
        {
          <text>سفارش شما ثبت شده و در انتظار پرداخت است؛ تا @Format.DateTime(order.PaymentDeadline) فرصت پرداخت دارید.</text>
        }
        else
        {
          <text>مهلت پرداخت این سفارش به پایان رسیده است.</text>
        }
      </div>
      <div class="px-2 sm:px-6 py-3 rounded-xl shadow-lg border mx-auto my-5 max-w-md">
        <partial name="_OrderReceipt" model="order" />
        @if (order.IsAwaitingPayment(DateTimeOffset.UtcNow))
        {
          <partial name="_PayOrderButton" model="order" />
        }
        <a asp-page="/Profile/Orders" class="mx-auto block text-center w-full px-2 py-3 mt-3 text-sm border border-sky-500 text-sky-600 rounded-lg">
          سفارش های من
        </a>
      </div>
    </div>
  </main>
