@using Fratak_Shop.Core.DTOs.Pages.Query
@{
    var message = TempData[ViewDataKeys.Message] as string;
    var type = TempData[ViewDataKeys.MessageType] as string ?? "success";
    var alertClass = type switch
    {
        "error" or "danger" => "alert-danger",
        "warning" => "alert-warning",
        "info" => "alert-info",
        _ => "alert-success",
    };
}
@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="@alertClass mb-5" role="alert">
        <span>@message</span>
        <button type="button" class="mr-auto opacity-60 hover:opacity-100" onclick="this.parentElement.remove()">×</button>
    </div>
}
@if (ViewData["PageAlertsTop"] is List<PageAlertDto> topAlerts)
{
    foreach (var alert in topAlerts)
    {
        <div class="@Ui.AlertClass(alert.Type) mb-5" role="alert">
            @if (!string.IsNullOrWhiteSpace(alert.Title))
            {
                <strong class="block">@alert.Title</strong>
            }
            <span>@Html.Raw(alert.Content)</span>
        </div>
    }
}
