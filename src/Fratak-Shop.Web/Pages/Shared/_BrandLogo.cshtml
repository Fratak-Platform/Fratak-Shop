@model Fratak_Shop.Web.Models.BrandLogoModel
@*
  لوگوی فروشگاه (هویت بصری فراتک شاپ).
  - اگر مدیر در تنظیمات «آدرس لوگو» نگذاشته باشد، لوگوی برند چاپ می‌شود: نسخهٔ روشن (brand-logo-light) و
    نسخهٔ سفید برای حالت تیره (brand-logo-dark). نمایش/پنهان شدنشان با style.css و dark.css است.
  - اگر لوگوی اختصاصی گذاشته شده باشد فقط همان یک تصویر چاپ می‌شود.
  محل استفاده: هدر (دسکتاپ و منوی موبایل)، صفحه‌های ورود و ثبت‌نام.
*@
@{
    var alt = Site.Settings.SiteName;
    var hasDark = Site.LogoDarkUrl != Site.LogoUrl;
}
<img class="@Model.CssClass @(hasDark ? "brand-logo-light" : null)" src="@Site.LogoUrl" asp-append-version="true" alt="@alt" width="@Model.Width" height="@Model.Height" decoding="async">
@if (hasDark)
{
  <img class="@Model.CssClass brand-logo-dark" src="@Site.LogoDarkUrl" asp-append-version="true" alt="@alt" width="@Model.Width" height="@Model.Height" loading="lazy" decoding="async">
}
