@model ProductFilterData
@{
    var url = $"/product/{Model.Slug}";
}
<div class="card swiper-slide my-2 p-2 md:p-3 bg-white rounded-xl relative group shadow-lg">
  @if (Model.DiscountEndAt.HasValue)
  {
    <div class="countdown flex flex-row-reverse justify-start items-center gap-x-1 text-white bg-cyan-500 rounded-full px-2 py-1 mr-auto w-fit" data-countdown="@Format.UnixMilliseconds(Model.DiscountEndAt.Value)">
      @Icons.Svg("Clock", "fill-white", 16)
      <div class="days-container hidden">
        <span data-cd="days" class="text-xs md:text-base"></span>
      </div>
      <div class="hours-container">
        <span data-cd="hours" class="text-xs md:text-base">00</span>
      </div>
      <div>:</div>
      <div class="minutes-container">
        <span data-cd="minutes" class="text-xs md:text-base">00</span>
      </div>
      <div>:</div>
      <div class="seconds-container">
        <span data-cd="seconds" class="text-xs md:text-base">00</span>
      </div>
    </div>
  }
  @if (Model.AverageRating > 0)
  {
    <div class="absolute left-3 mt-3 text-gray-500 opacity-0 group-hover:opacity-100 transition-all text-sm md:text-base flex flex-col items-center">
      @Icons.Svg("StarOutline", "fill-gray-500 size-4 md:size-6", 24)
      @Model.AverageRating.ToString("0.0")
    </div>
  }
  <a href="@url" class="image-box mb-6 block">
    <img class="w-full mx-auto" src="@ImageHelper.Product(Model.PrimaryImageName)" srcset="@ImageHelper.Srcset(ImageHelper.Product(Model.PrimaryImageName), Site.Settings.IsImageOptimizationEnabled, 640)" sizes="(min-width: 768px) 240px, 45vw" alt="@(Model.PrimaryImageAlt ?? Model.Name)" loading="lazy" decoding="async" />
  </a>
  @if (!string.IsNullOrWhiteSpace(Model.EnglishName))
  {
    <p class="text-xs md:text-sm text-gray-400 line-clamp-1" dir="ltr">
      @Model.EnglishName
    </p>
  }
  <a href="@url" class="text-gray-700 font-semibold text-sm md:text-base line-clamp-2">
    @Model.Name
  </a>
  <div class="mt-8 flex flex-row-reverse items-center justify-between">
    <div class="space-y-2">
      @if (Model.HasActiveDiscount)
      {
        <div class="flex justify-end opacity-65 gap-x-1">
          <div class="line-through decoration-gray-500 text-xs">@Format.Price(Model.Price)</div>
          <div class="line-through decoration-gray-500 text-xs">تومان</div>
        </div>
      }
      <div class="flex flex-row-reverse items-center gap-x-1">
        <div class="flex justify-end mt-1 mb-1 text-zinc-800 font-semibold gap-x-1">
          <div class="text-sm md:text-base">@Format.Price(Model.FinalPrice)</div>
          <div class="text-sm md:text-base">تومان</div>
        </div>
        @if (Model.DiscountPercent > 0)
        {
          <div class="bg-blue-500 h-fit text-white rounded-full text-xs md:text-sm px-2 py-1">
            @Model.DiscountPercent%
          </div>
        }
      </div>
    </div>
    <partial name="_AddToCartButton" model="Model" />
  </div>
  <div class="hidden group-hover:flex opacity-0 group-hover:opacity-100 transition-all items-center justify-between border-t mt-5 pt-5 gap-x-4">
    <partial name="_FavoriteButton" model="Model.Id" />
    <a href="@url" class="bg-blue-600 hover:bg-blue-500 transition h-auto text-white text-sm rounded-lg py-3 w-full text-center">
      جزئیات محصول
    </a>
  </div>
</div>
