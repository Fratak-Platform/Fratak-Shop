@model Fratak_Shop.Web.ViewComponents.HeaderViewModel
@inject Fratak_Shop.Core.Services.Smart.ISmartConfigService SmartConfig
@{
    // دور ۲۴: دکمهٔ دوربین (جست‌وجو با عکس) فقط وقتی قابلیت روشن است؛ میکروفون را commerce.js فقط در مرورگرهای پشتیبان نشان می‌دهد.
    var imageSearchOn = (await SmartConfig.GetAsync()).ImageSearch;
    var cart = Model.Cart;
    var cartItems = cart?.Items ?? [];
    var siteName = Site.Settings.SiteName;
    const string megaLink = "flex items-center gap-x-2 rounded-lg px-3 py-2 text-sm text-zinc-700 hover:bg-sky-50 hover:text-sky-600 transition";
}
<header class="fixed w-full border-b z-40 bg-white">
    @if (Site.ShowAnnouncement)
    {
      var announcementUrl = UrlSafety.IsSafeLink(Site.Settings.AnnouncementUrl) ? Site.Settings.AnnouncementUrl!.Trim() : null;
      var look = Site.Announcement;
      @* دور ۲۱: ظاهر کامل نوار (AnnouncementLook: رنگ‌ها فقط هگز معتبر، کلاس‌ها از فهرست ثابت). چرخش پیام‌ها، بستن و
         متن متحرک با main.js (بدون اسکریپت درون‌خطی)؛ «کاهش حرکت» دستگاه همهٔ جلوه‌ها را خاموش می‌کند. *@
      <div class="@look.CssClass relative flex @look.HeightClass items-center justify-center overflow-hidden px-8"
           style="background: @look.Background; color: @look.TextColor" data-ann="@Fratak_Shop.Core.Services.Seo.Engine.PersianText.Hash(string.Join("|", look.Messages))"
           data-ann-closeable="@(look.Closeable ? "1" : null)" role="region" aria-label="اطلاعیه">
        <div class="fs-ann-track truncate">
          @for (var i = 0; i < look.Messages.Count; i++)
          {
            var message = look.Messages[i];
            if (announcementUrl is not null)
            {
              <a href="@announcementUrl" class="fs-ann-msg hover:underline" data-ann-msg hidden="@(i > 0 ? "hidden" : null)">@message</a>
            }
            else
            {
              <span class="fs-ann-msg" data-ann-msg hidden="@(i > 0 ? "hidden" : null)">@message</span>
            }
          }
        </div>
        @if (look.Closeable)
        {
          <button type="button" class="absolute left-2 top-1/2 -translate-y-1/2 rounded p-1 opacity-80 hover:opacity-100" data-ann-close aria-label="بستن اطلاعیه">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true"><path d="M205.66,194.34a8,8,0,0,1-11.32,11.32L128,139.31,61.66,205.66a8,8,0,0,1-11.32-11.32L116.69,128,50.34,61.66A8,8,0,0,1,61.66,50.34L128,116.69l66.34-66.35a8,8,0,0,1,11.32,11.32L139.31,128Z"></path></svg>
          </button>
        }
      </div>
    }
    @* header *@
    <div class="flex items-center justify-between pt-2 pb-4 gap-y-5 flex-wrap lg:flex-nowrap">
      @* btn menu mobile *@
      <button type="button" class="md:hidden mr-3 md:mr-5" data-ui="nav-open" aria-label="باز کردن منو" aria-controls="navbarMobile">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000" viewBox="0 0 256 256" aria-hidden="true"><path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"></path></svg>
      </button>
      @* navbar moblie *@
      <div class="flex fixed w-full h-[100dvh] z-50 -right-full top-0 transition-all ease-out duration-500 md:hidden" id="navbarMobile">
        <nav class="bg-white w-9/12 h-full py-5 drop-shadow-2xl max-w-md overflow-y-auto overscroll-contain" aria-label="منوی اصلی">
          <div class="mx-auto mb-5">
            <a asp-page="/Index" class="flex justify-center" aria-label="@siteName">
              @await Html.PartialAsync("_BrandLockup", new BrandLockupModel(BrandPlace.MobileMenu))
            </a>
          </div>
          <ul class="flex flex-col gap-y-3 px-2">
            <li class="text-zinc-700 hover:text-zinc-900 hover:bg-gray-200 transition p-2 rounded-lg">
              <a class="block" asp-page="/Index">صفحه اصلی</a>
            </li>
            @foreach (var menuItem in Model.MainMenu)
            {
              if (menuItem.Type == Fratak_Shop.Data.Entities.Contents.MenuItemType.CategoriesMegaMenu)
              {
                <li class="text-zinc-700">
                  <details class="group/shop">
                    <summary class="flex gap-x-1 items-center justify-between hover:bg-gray-200 transition p-2 rounded-lg cursor-pointer list-none">
                      <span>@menuItem.Title</span>
                      @Icons.Svg("CaretDown", "group-open/shop:rotate-180 transition-transform duration-300", 16)
                    </summary>
                    <div class="flex flex-col p-2 mt-1 rounded-lg bg-gray-50">
                      <a class="hover:bg-sky-500 hover:text-gray-50 px-2 py-2 rounded-md transition-all font-semibold" href="@UrlSafety.Link(menuItem.Url, "/products")">همه محصولات</a>
                      @foreach (var category in Model.Categories)
                      {
                        if (category.SubCategories.Count == 0)
                        {
                          <a class="flex items-center gap-x-2 hover:bg-sky-500 hover:text-gray-50 px-2 py-2 rounded-md transition-all" href="/category/@category.Slug">@Icons.Svg(Icons.Has(category.IconKey) ? category.IconKey! : "Tag", "shrink-0", 16)<span>@category.Name</span></a>
                          continue;
                        }
                        <details class="group/cat">
                          <summary class="flex items-center justify-between px-2 py-2 rounded-md hover:bg-gray-200 cursor-pointer list-none">
                            <span class="flex items-center gap-x-2">@Icons.Svg(Icons.Has(category.IconKey) ? category.IconKey! : "Tag", "shrink-0", 16)<span>@category.Name</span></span>
                            @Icons.Svg("CaretDown", "group-open/cat:rotate-180 transition-transform duration-300", 14)
                          </summary>
                          <div class="flex flex-col pr-3 border-r border-sky-200 mr-2 mb-1">
                            <a class="px-2 py-1.5 text-sm text-sky-600" href="/category/@category.Slug">همه @category.Name</a>
                            @foreach (var sub in category.SubCategories)
                            {
                              <a class="px-2 py-1.5 text-sm text-zinc-600 hover:text-sky-600" href="/category/@sub.Slug">@sub.Name</a>
                            }
                          </div>
                        </details>
                      }
                    </div>
                  </details>
                </li>
                continue;
              }
              <li class="text-zinc-700 hover:text-zinc-900 hover:bg-gray-200 transition p-2 rounded-lg">
                <partial name="_MenuLink" model='(menuItem, "flex items-center gap-x-2")' />
              </li>
            }
          </ul>
        </nav>
        <div class="bg-white/30 w-3/12 sm:w-5/12 backdrop-blur-sm" data-ui="nav-close" aria-hidden="true">
        </div>
      </div>
      @* دور ۲۹ (#۳): نوار پایین قدیمی (با جست‌وجوی پنهان در پنجرهٔ hover) حذف شد؛ جست‌وجوی موبایل بالای صفحه است و میانبرها در nav.fs-bnav. *@
      @* logo *@
      <div class="mr-0 md:mr-5">
        <a asp-page="/Index" aria-label="@siteName">
          @await Html.PartialAsync("_BrandLockup", new BrandLockupModel(BrandPlace.Header))
        </a>
      </div>
      @* search input *@
      <div class="md:w-5/12 lg:w-4/12 hidden md:block">
        <form method="get" action="/search" role="search" data-search-suggest class="items-center rounded-xl p-3 justify-between flex bg-gray-100 relative">
          <input class="text-base text-gray-700 flex-grow outline-none bg-gray-100" type="search" name="q" value="@Model.SearchQuery" aria-label="جستجو" placeholder="نام محصول را وارد کنید" autocomplete="off" maxlength="100" />
          <span class="flex items-center gap-1 ml-11">
            <button type="button" data-voice-search class="hidden size-8 rounded-lg items-center justify-center hover:bg-sky-100" aria-label="جست‌وجوی صوتی" title="جست‌وجوی صوتی">@Icons.Svg("Microphone", "fill-zinc-600 size-5", 20)</button>
            @if (imageSearchOn)
            {
              <button type="button" data-image-search class="size-8 rounded-lg flex items-center justify-center hover:bg-sky-100" aria-label="جست‌وجو با عکس" title="جست‌وجو با عکس">@Icons.Svg("Camera", "fill-zinc-600 size-5", 20)</button>
            }
          </span>
          <button type="submit" aria-label="جستجو" class="absolute left-1 bg-sky-500 hover:bg-sky-600 transition rounded-xl h-10 w-10 p-1">
            <img class="" src="~/assets/image/search.webp" alt="جستجو">
          </button>
        </form>
      </div>
      @* buttonn *@
      <div class="flex items-center justify-center gap-x-3 ml-3 md:ml-5">
        @if (Site.Settings.IsDarkModeEnabled)
        {
          <button type="button" data-theme-toggle class="flex items-center rounded-lg p-2 text-zinc-600 fill-zinc-600 hover:bg-sky-100" aria-label="تغییر پوسته">
            <span class="ti ti-light">@Icons.Svg("Sun", null, 24)</span>
            <span class="ti ti-dark">@Icons.Svg("Moon", null, 24)</span>
            <span class="ti ti-system">@Icons.Svg("CircleHalf", null, 24)</span>
          </button>
        }
        @* card *@
        <div class="flex items-center hover:bg-sky-100 p-2 rounded-lg">
          <button type="button" class="relative" aria-label="سبد خرید" data-ui="cart-open" aria-controls="cardHeader">
            <img class="w-10" src="~/assets/image/Cart.webp" alt="" width="40" height="40">
            @if (Model.CartCount > 0)
            {
            <span class="absolute -right-3 -top-3 flex h-5 w-5 drop-shadow-lg items-center justify-center rounded-full bg-sky-500 text-sm font-semibold text-white">
              @Model.CartCount
            </span>
            }
          </button>
          <div class="fixed inset-0 z-50 hidden" id="cardHeader" role="dialog" aria-modal="true" aria-label="سبد خرید">
            <div data-ui="cart-close" class="absolute inset-0 bg-gray-600/50" aria-hidden="true"></div>
            <div class="absolute inset-y-0 left-0 flex flex-col w-[22rem] max-w-full sm:w-[400px] h-[100dvh] bg-white shadow-lg">
              @* Head *@
              <div class="shrink-0 flex items-center justify-between p-4 pb-2 border-b mx-5 bg-white">
                <div class="text-zinc-500">
                  @Model.CartCount کالا
                </div>
                <button data-ui="cart-close" type="button" aria-label="بستن سبد خرید" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm p-1.5 inline-flex items-center">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                </button>
              </div>
              @* Items: only this list scrolls, and only when it doesn't fit *@
              <ul class="main-scroll flex-1 min-h-0 overflow-y-auto overscroll-contain divide-y divide-gray-100 px-5 pl-2">
                    @if (cartItems.Count == 0)
                    {
                      <li class="py-10 text-center text-sm text-zinc-500">
                        سبد خرید شما خالی است.
                      </li>
                    }
                    @foreach (var item in cartItems)
                    {
                    <li>
                      <div class="flex gap-x-2 py-4">
                        @* Product *@
                        <div class="relative min-w-fit">
                          <a href="/product/@item.ProductSlug">
                            <img alt="@item.ImageAlt" class="h-[96px] w-[96px] object-contain" src="@ImageHelper.Sized(ImageHelper.Product(item.ImageName), 160, Site.Settings.IsImageOptimizationEnabled)" loading="lazy" width="96" height="96">
                          </a>
                        </div>
                        <div class="w-full space-y-1.5">
                          @* Title *@
                          <a class="line-clamp-2 h-12 text-zinc-700" href="/product/@item.ProductSlug">
                            @item.ProductName
                          </a>
                          @* Attribute *@
                          @if (item.HasDiscount)
                          {
                            <div class="flex items-center gap-x-2 text-xs text-red-500">
                              <span>تخفیف: @Format.Toman(item.DiscountAmount)</span>
                            </div>
                          }
                          <div class="flex items-center gap-x-2 text-xs text-zinc-500">
                            <div class="flex items-center gap-x-2">
                              <svg class="fill-red-700" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#4d4d4d" viewBox="0 0 256 256"><path d="M245.57,117.78l-14-35a13.93,13.93,0,0,0-13-8.8H182V64a6,6,0,0,0-6-6H24A14,14,0,0,0,10,72V184a14,14,0,0,0,14,14H42.6a30,30,0,0,0,58.8,0h53.2a30,30,0,0,0,58.8,0H232a14,14,0,0,0,14-14V120A6,6,0,0,0,245.57,117.78ZM182,86h36.58a2,2,0,0,1,1.86,1.26L231.14,114H182ZM22,72a2,2,0,0,1,2-2H170v68H22ZM72,210a18,18,0,1,1,18-18A18,18,0,0,1,72,210Zm82.6-24H101.4a30,30,0,0,0-58.8,0H24a2,2,0,0,1-2-2V150H170v15.48A30.1,30.1,0,0,0,154.6,186ZM184,210a18,18,0,1,1,18-18A18,18,0,0,1,184,210Zm50-26a2,2,0,0,1-2,2H213.4A30.05,30.05,0,0,0,184,162c-.67,0-1.34,0-2,.07V126h52Z"></path></svg>
                              <span>@(item.HasEnoughStock ? "آماده ارسال" : "موجودی کافی نیست")</span>
                            </div>
                          </div>
                          <div class="flex items-center justify-between gap-x-2">
                            @* Price *@
                            <div class="text-gray-700">
                              <span class="text-lg font-bold">@Format.Price(item.TotalAmount)</span>
                              <span class="text-sm">تومان</span>
                            </div>
                            @* Quantity *@
                            <div class="flex h-10 w-24 items-center justify-between rounded-lg border border-gray-100 px-2 py-1">
                              <form method="post" asp-page="/Cart" asp-page-handler="Update" class="flex">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                <input type="hidden" name="returnUrl" value="@Model.CurrentPath" />
                                <button type="submit" aria-label="افزایش تعداد" disabled="@(item.Quantity >= item.StockQuantity ? "disabled" : null)">
                                  <svg xlink:href="#plus" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#4d4d4d" viewBox="0 0 256 256"><path d="M222,128a6,6,0,0,1-6,6H134v82a6,6,0,0,1-12,0V134H40a6,6,0,0,1,0-12h82V40a6,6,0,0,1,12,0v82h82A6,6,0,0,1,222,128Z"></path></svg>
                                </button>
                              </form>
                              <input value="@item.Quantity" disabled="" type="number" class="flex h-5 w-full grow select-none items-center justify-center bg-transparent text-center text-sm text-zinc-700 outline-none" aria-label="تعداد">
                              <form method="post" asp-page="/Cart" asp-page-handler="@(item.Quantity > 1 ? "Update" : "Remove")" class="flex">
                                <input type="hidden" name="productId" value="@item.ProductId" />
                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                <input type="hidden" name="returnUrl" value="@Model.CurrentPath" />
                                <button type="submit" aria-label="کاهش تعداد">
                                  <svg xlink:href="#minus" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="#4d4d4d" viewBox="0 0 256 256"><path d="M222,128a6,6,0,0,1-6,6H40a6,6,0,0,1,0-12H216A6,6,0,0,1,222,128Z"></path></svg>
                                </button>
                              </form>
                            </div>
                          </div>
                        </div>
                      </div>
                    </li>
                    }
              </ul>
              @* Down Price *@
              <div class="shrink-0 flex items-center justify-between border-t border-gray-100 p-5 bg-white">
                <div class="flex flex-col items-center gap-y-1">
                  <div class="text-sm text-zinc-600">
                    مبلغ قابل پرداخت
                  </div>
                  <div class="text-zinc-600">
                    <span class="font-bold">@Format.Price(cart?.PayableAmount ?? 0)</span>
                    <span class="text-xs">تومان</span>
                  </div>
                </div>
                @if (cartItems.Count > 0)
                {
                  <div class="flex gap-x-2">
                    <a asp-page="/Cart" class="py-3 px-3 text-sm border border-sky-500 text-sky-600 rounded-xl text-center">
                      مشاهده سبد
                    </a>
                    <a asp-page="/Checkout" class="w-28 py-3 text-sm bg-sky-500 hover:bg-sky-400 transition text-gray-100 rounded-xl text-center">
                      ثبت سفارش
                    </a>
                  </div>
                }
              </div>
            </div>
          </div>
        </div>
        @if (Model.IsSignedIn)
        {
        <a asp-page="/Profile/Notifications" class="relative flex items-center rounded-lg p-2 text-zinc-600 hover:bg-sky-100 hover:text-sky-600"
           aria-label="@(Model.UnreadNotifications > 0 ? $"اعلان‌ها ({Model.UnreadNotifications} خوانده‌نشده)" : "اعلان‌ها")">
          @Icons.Svg("Bell", null, 28)
          @* شمارنده همیشه رندر می‌شود (اگر صفر باشد پنهان) تا live.js بتواند آن را زنده به‌روز کند. *@
          <span class="absolute right-0 top-0 flex h-5 min-w-5 items-center justify-center rounded-full bg-rose-500 px-1 text-xs font-semibold text-white"
                data-live-count="notifications" data-value="@Model.UnreadNotifications" hidden="@(Model.UnreadNotifications <= 0)">
            @(Model.UnreadNotifications > 99 ? "99+" : Model.UnreadNotifications.ToString())
          </span>
        </a>
        <div class="flex items-center py-2 px-2 rounded-lg border border-sky-300 hover:bg-sky-100 group relative">
          <button class="text-sky-500 flex gap-x-2 items-center" type="button" aria-label="حساب کاربری">
            <svg class="fill-sky-500" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="" viewBox="0 0 256 256"><path d="M192,96a64,64,0,1,1-64-64A64,64,0,0,1,192,96Z" opacity="0.2"></path><path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z"></path></svg>
            <span class="hidden md:block text-sm">
              @Model.DisplayName
            </span>
          </button>
          <div class="z-50 group-hover:block group-focus-within:block left-0 top-full pt-1 w-60 hidden absolute">
          <div class="rounded-lg bg-white shadow-lg border">
            @* دور ۲۹: ردیف‌ها از ProfileMenu (همان ترتیب ستون پروفایل)؛ کارکنان ← «پنل مدیریت» اول؛ «پروفایل» ← اطلاعات حساب. *@
            <ul class="space-y-1 p-2">
              <li class="border-b pb-1">
                <a class="flex flex-col rounded-lg p-2 text-zinc-700 transition hover:bg-gray-100" href="/profile">
                  @* دور ۳۱ (#۴): نام کامل (نام + نام خانوادگی) بدون «جان»؛ بی‌نام ← شمارهٔ موبایل. *@
                  <span class="text-sm font-semibold truncate" title="@Model.DisplayName">@Model.DisplayName</span>
                  <span class="text-xs text-zinc-400">پیشخوان حساب کاربری</span>
                </a>
              </li>
              @foreach (var item in ProfileMenu.Dropdown(Site.Settings, Model.IsStaff))
              {
                var isProfile = item.Section == ProfileSection.PersonalInfo;
                <li>
                  <a class="flex items-center justify-between gap-x-2 rounded-lg p-2 transition @(item.Staff ? "text-sky-700 hover:bg-sky-50" : "text-zinc-700 hover:text-zinc-800 hover:bg-gray-100")" href="@item.Url">
                    <span class="flex items-center gap-x-2">
                      @Icons.Svg(item.Icon, item.Staff ? "fill-sky-700" : "fill-[#4d4d4d]", 20)
                      <span class="text-sm@(item.Staff ? " font-semibold" : "")">@(isProfile ? "پروفایل" : item.Title)</span>
                    </span>
                    @if (item.Section == ProfileSection.Notifications && Model.UnreadNotifications > 0)
                    {
                      <span class="rounded-full bg-rose-500 px-2 text-xs text-white">@Model.UnreadNotifications</span>
                    }
                  </a>
                </li>
              }
              <li>
                <form method="post" asp-page="/Logout">
                  <button type="submit" class="w-full flex items-center justify-between gap-x-2 rounded-lg p-2 text-red-500 hover:text-red-600 transition hover:bg-red-100">
                  <div class="flex items-center gap-x-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#4d4d4d" viewBox="0 0 256 256"><path d="M110,216a6,6,0,0,1-6,6H48a14,14,0,0,1-14-14V48A14,14,0,0,1,48,34h56a6,6,0,0,1,0,12H48a2,2,0,0,0-2,2V208a2,2,0,0,0,2,2h56A6,6,0,0,1,110,216Zm110.24-92.24-40-40a6,6,0,0,0-8.48,8.48L201.51,122H104a6,6,0,0,0,0,12h97.51l-29.75,29.76a6,6,0,1,0,8.48,8.48l40-40A6,6,0,0,0,220.24,123.76Z"></path></svg>
                    <span>خروج از حساب کاربری</span>
                  </div>
                  </button>
                </form>
              </li>
            </ul>
          </div>
          </div>
        </div>
        }
        else
        {
          <a asp-page="/Login" asp-route-returnUrl="@Model.CurrentPath" class="flex items-center py-2 px-2 rounded-lg border border-sky-300 hover:bg-sky-100 text-sky-500 gap-x-2">
            <svg class="fill-sky-500" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="" viewBox="0 0 256 256"><path d="M192,96a64,64,0,1,1-64-64A64,64,0,0,1,192,96Z" opacity="0.2"></path><path d="M230.92,212c-15.23-26.33-38.7-45.21-66.09-54.16a72,72,0,1,0-73.66,0C63.78,166.78,40.31,185.66,25.08,212a8,8,0,1,0,13.85,8c18.84-32.56,52.14-52,89.07-52s70.23,19.44,89.07,52a8,8,0,1,0,13.85-8ZM72,96a56,56,0,1,1,56,56A56.06,56.06,0,0,1,72,96Z"></path></svg>
            <span class="hidden md:block text-sm">
              ورود | ثبت نام
            </span>
          </a>
        }
      </div>
    </div>
    @* دور ۲۹ (#۳) – جست‌وجوی موبایل همیشه بالای صفحه: متن + صدا + عکس کنار هم، بزرگ و در دسترس (فقط زیر ۷۶۸ پیکسل).
       همان فرم دسکتاپ (data-search-suggest ← پیشنهاد زنده؛ data-voice-search و data-image-search ← commerce.js). *@
    <div class="fs-msearch md:hidden">
      <form method="get" action="/search" role="search" data-search-suggest class="fs-msearch-form">
        <span class="fs-msearch-icon" aria-hidden="true">@Icons.Svg("MagnifyingGlass", null, 20)</span>
        <input type="search" name="q" value="@Model.SearchQuery" aria-label="جستجو در @siteName" placeholder="جستجو در @siteName" autocomplete="off" maxlength="100" enterkeyhint="search" data-msearch-input />
        <button type="button" data-voice-search class="hidden fs-msearch-btn" aria-label="جست‌وجوی صوتی" title="جست‌وجوی صوتی">@Icons.Svg("Microphone", null, 20)</button>
        @if (imageSearchOn)
        {
          <button type="button" data-image-search class="fs-msearch-btn" aria-label="جست‌وجو با عکس" title="جست‌وجو با عکس">@Icons.Svg("Camera", null, 20)</button>
        }
        <button type="submit" class="sr-only">جستجو</button>
      </form>
    </div>
    @* menus: the mega menu is positioned against this bar, so it spans the full header width *@
    <nav class="hidden md:block pb-2 relative" aria-label="منوی اصلی">
      <ul class="flex flex-wrap gap-x-3 xl:gap-x-5 px-3 md:px-5">
        @foreach (var menuItem in Model.MainMenu)
        {
          if (menuItem.Type == Fratak_Shop.Data.Entities.Contents.MenuItemType.CategoriesMegaMenu)
          {
            <li class="text-zinc-700 group">
              <a href="@UrlSafety.Link(menuItem.Url, "/products")" class="flex gap-x-1 items-center group-hover:bg-gray-100 group-hover:text-sky-600 transition p-2 rounded-lg" aria-haspopup="true">
                @Icons.Svg(menuItem.Icon ?? "Grid", "fill-gray-600 group-hover:fill-sky-600", 20)
                @menuItem.Title
                @Icons.Svg("CaretDown", "group-hover:rotate-180 transition-transform duration-300 fill-zinc-600", 12)
              </a>
              @* -mt-2 + pt-2 bridge the bar padding so the pointer never "falls" into a gap *@
              <div class="absolute inset-x-0 top-full -mt-2 pt-2 z-50 hidden group-hover:block group-focus-within:block">
                <div class="mx-3 md:mx-5 flex gap-6 rounded-b-2xl border bg-white p-5 lg:p-6 shadow-xl max-h-[70vh] overflow-y-auto">
                  <div class="grid flex-1 grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-x-5 gap-y-6">
                    @foreach (var category in Model.Categories.Take(6))
                    {
                      <div class="space-y-2 min-w-0">
                        <a href="/category/@category.Slug" class="flex items-center gap-x-1 font-semibold text-zinc-800 hover:text-sky-600">
                          @Icons.Svg(Icons.Has(category.IconKey) ? category.IconKey! : "Tag", "fill-sky-600 shrink-0", 18)
                          <span class="text-sm truncate">@category.Name</span>
                          @Icons.Svg("ChevronLeft", "fill-zinc-500 shrink-0", 12)
                        </a>
                        <ul>
                          @foreach (var sub in category.SubCategories.Take(7))
                          {
                            <li>
                              <a class="block py-1.5 text-xs text-zinc-600 hover:text-sky-700 truncate" href="/category/@sub.Slug">@sub.Name</a>
                            </li>
                          }
                          <li>
                            <a class="block py-1.5 text-xs text-sky-600 hover:text-sky-700" href="/category/@category.Slug">مشاهده همه</a>
                          </li>
                        </ul>
                      </div>
                    }
                    @if (Model.Categories.Count == 0)
                    {
                      <p class="col-span-full text-sm text-zinc-500">هنوز دسته بندی ثبت نشده است.</p>
                    }
                  </div>
                  <div class="hidden lg:flex w-56 shrink-0 flex-col gap-y-1 border-r pr-5">
                    @foreach (var shortcut in Model.Shortcuts)
                    {
                      <partial name="_MenuLink" model='(shortcut, megaLink)' />
                    }
                    @if (Model.Categories.Count > 6)
                    {
                      <p class="mt-3 px-3 text-xs text-zinc-400">دسته بندی های دیگر</p>
                      @foreach (var category in Model.Categories.Skip(6).Take(6))
                      {
                        <a class="block px-3 py-1 text-xs text-zinc-600 hover:text-sky-600" href="/category/@category.Slug">@category.Name</a>
                      }
                    }
                  </div>
                </div>
              </div>
            </li>
            continue;
          }
          <li class="text-zinc-700 hover:text-sky-600 hover:bg-gray-100 transition p-2 rounded-lg">
            <partial name="_MenuLink" model='(menuItem, "flex items-center gap-x-1 [&>svg]:hidden xl:[&>svg]:block")' />
          </li>
        }
      </ul>
    </nav>
  </header>

@* دور ۲۸ (#۱۳۱) – «نوار پایین موبایل»: پنج میانبر همیشه در دسترس شست (خانه، دسته‌ها، جست‌وجو، سبد، حساب) فقط زیر ۷۶۸ پیکسل.
   در صفحه‌های پرداخت/تسویه نشان داده نمی‌شود و وقتی نوار «افزودن به سبد» صفحهٔ کالا باز است کنار می‌رود (commerce.css). *@
@{
    var bottomPath = ViewContext.HttpContext.Request.Path.Value ?? "/";
    var hideBottomNav = bottomPath.StartsWith("/checkout", StringComparison.OrdinalIgnoreCase) || bottomPath.StartsWith("/pay", StringComparison.OrdinalIgnoreCase)
                        || bottomPath.StartsWith("/payment", StringComparison.OrdinalIgnoreCase) || bottomPath.StartsWith("/login", StringComparison.OrdinalIgnoreCase)
                        || bottomPath.StartsWith("/register", StringComparison.OrdinalIgnoreCase);
    string BottomCurrent(string prefix) => (prefix == "/" ? bottomPath == "/" : bottomPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "page" : "false";
}
@if (!hideBottomNav)
{
  <nav class="fs-bnav md:hidden" aria-label="میانبرهای پایین صفحه">
    <a href="/" aria-current="@BottomCurrent("/")">@Icons.Svg("Home", null, 22)<span>خانه</span></a>
    <button type="button" data-ui="nav-open" aria-controls="navbarMobile">@Icons.Svg("SquaresFour", null, 22)<span>دسته‌ها</span></button>
    <a href="/search" aria-current="@BottomCurrent("/search")" data-focus-search>@Icons.Svg("MagnifyingGlass", null, 22)<span>جست‌وجو</span></a>
    <a href="/cart" aria-current="@BottomCurrent("/cart")" class="fs-bnav-cart">
      @Icons.Svg("Cart", null, 22)<span>سبد خرید</span>
      @if (Model.CartCount > 0)
      {
        <b class="fs-bnav-badge" aria-label="@Model.CartCount کالا در سبد">@Model.CartCount</b>
      }
    </a>
    <a href="@(Model.IsSignedIn ? "/profile" : "/login")" aria-current="@BottomCurrent("/profile")">@Icons.Svg("User", null, 22)<span>@(Model.IsSignedIn ? "حساب من" : "ورود")</span></a>
  </nav>
}
