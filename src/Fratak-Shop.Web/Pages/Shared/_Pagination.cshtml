@model Fratak_Shop.Core.Utilities.BasePaginate
@{
    string BuildUrl(int page)
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(Context.Request.QueryString.Value ?? string.Empty)
            .ToDictionary(item => item.Key, item => (string?)item.Value.ToString());
        query["page"] = page.ToString();
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(Context.Request.Path.Value ?? string.Empty, query);
    }
}
@if (Model.PageCount > 1)
{
    <nav class="pagination mt-8" aria-label="صفحه‌بندی">
        @if (Model.CurrentPage > 1)
        {
            <a href="@BuildUrl(Model.CurrentPage - 1)" rel="prev">قبلی</a>
        }
        @for (var page = Model.StartPage; page <= Model.EndPage; page++)
        {
            if (page == Model.CurrentPage)
            {
                <span class="is-active">@Ui.Number(page)</span>
            }
            else
            {
                <a href="@BuildUrl(page)">@Ui.Number(page)</a>
            }
        }
        @if (Model.CurrentPage < Model.PageCount)
        {
            <a href="@BuildUrl(Model.CurrentPage + 1)" rel="next">بعدی</a>
        }
    </nav>
    <p class="mt-3 text-center text-xs text-zinc-400">صفحه @Ui.Number(Model.CurrentPage) از @Ui.Number(Model.PageCount)</p>
}
