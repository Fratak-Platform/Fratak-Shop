@model PagerModel
@if (Model.HasPages)
{
  <nav aria-label="صفحه بندی">
    <ul class="flex items-center justify-center gap-x-2 md:gap-x-3 h-8 text-sm mt-10 mb-4">
      @if (Model.CurrentPage > 1)
      {
        <li>
          <a href="@Model.UrlFor(Model.CurrentPage - 1)" class="flex items-center justify-center px-3 h-8 rounded-lg border border-gray-300 bg-white text-zinc-600 hover:bg-sky-50" rel="prev">قبلی</a>
        </li>
      }
      @for (var page = Model.StartPage; page <= Model.EndPage; page++)
      {
        <li>
          @if (page == Model.CurrentPage)
          {
            <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-sky-500 text-white" aria-current="page">@page</span>
          }
          else
          {
            <a href="@Model.UrlFor(page)" class="flex items-center justify-center w-8 h-8 rounded-lg border border-gray-300 bg-white text-zinc-600 hover:bg-sky-50">@page</a>
          }
        </li>
      }
      @if (Model.CurrentPage < Model.PageCount)
      {
        <li>
          <a href="@Model.UrlFor(Model.CurrentPage + 1)" class="flex items-center justify-center px-3 h-8 rounded-lg border border-gray-300 bg-white text-zinc-600 hover:bg-sky-50" rel="next">بعدی</a>
        </li>
      }
    </ul>
  </nav>
}
