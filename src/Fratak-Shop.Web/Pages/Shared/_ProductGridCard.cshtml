@model ProductFilterData
@* دور ۲۴: کارت داخل یک ظرف است تا دکمه‌های «نمایش سریع» و «مقایسه» (پیشنهاد ۳۱ و ۳۲) کنار پیوند باشند، نه داخل آن
   (دکمه داخل پیوند HTML نامعتبر است). data-product-id برای ثبت کلیک جست‌وجو (رتبه‌بندی یادگیرنده) هم استفاده می‌شود. رفتار: assets/js/commerce.js *@
<div class="relative group" data-product-id="@Model.Id">
<a href="/product/@Model.Slug" class="relative my-2 p-2 md:p-3 bg-white rounded-xl shadow-lg border border-zinc-200 block">
  @if (Model.DiscountPercent > 0)
  {
    <span class="absolute right-3 top-3 bg-red-500 text-white rounded-full text-xs px-2 py-1 z-10">@Model.DiscountPercent%</span>
  }
  @if (Model.AverageRating > 0)
  {
    <div class="absolute left-3 text-gray-600 opacity-0 group-hover:opacity-100 transition-all text-xs md:text-sm flex flex-col items-center">
      @Icons.Svg("StarOutline", "fill-yellow-500 size-4 md:size-6", 24)
      @Model.AverageRating.ToString("0.0")
    </div>
  }
  <img class="mx-auto fc-img-skel @(Model.IsInStock ? "" : "grayscale opacity-60")" src="@ImageHelper.Product(Model.PrimaryImageName)" srcset="@ImageHelper.Srcset(ImageHelper.Product(Model.PrimaryImageName), Site.Settings.IsImageOptimizationEnabled, 640)" sizes="(min-width: 1280px) 18vw, (min-width: 768px) 30vw, 48vw" alt="@(Model.PrimaryImageAlt ?? Model.Name)" loading="lazy" decoding="async">
  <div class="mt-5">
    <div class="flex flex-col gap-y-1">
      @if (!string.IsNullOrWhiteSpace(Model.BrandName))
      {
        <div class="text-xs text-zinc-400">@Model.BrandName</div>
      }
      <div class="text-zinc-700 text-sm md:text-base line-clamp-2 h-12">
        @Model.Name
      </div>
      @if (!Model.IsInStock)
      {
        <div class="text-red-500 text-sm mt-2">ناموجود</div>
      }
      else
      {
        <div class="flex items-center justify-between mt-2">
          <div class="text-blue-800 text-base md:text-lg">@Format.Price(Model.FinalPrice) <span class="text-xs">تومان</span></div>
          @if (Model.HasActiveDiscount)
          {
            <div class="text-xs text-gray-400 line-through">@Format.Price(Model.Price)</div>
          }
        </div>
      }
    </div>
  </div>
</a>
<div class="absolute left-3 top-16 z-10 flex flex-col gap-1 md:opacity-0 md:group-hover:opacity-100 md:focus-within:opacity-100 transition-opacity">
  <button type="button" class="size-8 rounded-full bg-white/90 border border-zinc-200 shadow flex items-center justify-center hover:border-sky-400" data-quick-view="@Model.Id" aria-label="نمایش سریع @Model.Name" title="نمایش سریع">@Icons.Svg("Eye", "fill-zinc-700 size-4", 16)</button>
  <button type="button" class="size-8 rounded-full bg-white/90 border border-zinc-200 shadow flex items-center justify-center hover:border-sky-400" data-compare-add="@Model.Id" aria-label="افزودن @Model.Name به مقایسه" title="افزودن به مقایسه">@Icons.Svg("Scales", "fill-zinc-700 size-4", 16)</button>
</div>
</div>
