@using Fratak_Shop.Core.DTOs.Products.Query
@model List<BreadcrumbDto>
@if (Model.Count > 0)
{
    <nav class="mb-5 flex flex-wrap items-center gap-x-2 text-xs text-zinc-500" aria-label="مسیر صفحه">
        @for (var index = 0; index < Model.Count; index++)
        {
            var item = Model[index];
            if (index == Model.Count - 1 || string.IsNullOrWhiteSpace(item.Url))
            {
                <span class="text-zinc-700">@item.Title</span>
            }
            else
            {
                <a class="hover:text-sky-600" href="@item.Url">@item.Title</a>
                <span class="text-zinc-300">/</span>
            }
        }
    </nav>
}
