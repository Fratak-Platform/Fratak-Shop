@model ProductModel
@* «خبرم کن» buttons and the price-history chart under the price box of the product page. *@
@{
    var p = Model.Product;
    var settings = Site.Settings;
    var state = Model.AlertState;
}
@if (settings.IsProductAlertEnabled || settings.IsPriceHistoryEnabled)
{
  <div class="mt-4 space-y-2">
    @if (settings.IsProductAlertEnabled)
    {
      if (p.IsInStock)
      {
        <button type="button" data-product-alert="2" data-product="@p.Id" aria-pressed="@(state.PriceDrop ? "true" : "false")"
                data-on-text="به شما خبر می‌دهیم (کاهش قیمت)" data-off-text="خبرم کن وقتی قیمت کم شد"
                class="flex w-full items-center justify-center gap-x-2 rounded-lg border border-sky-200 px-3 py-2 text-sm text-sky-700 transition hover:bg-sky-50 aria-pressed:border-emerald-300 aria-pressed:bg-emerald-50 aria-pressed:text-emerald-700 dark:border-sky-500/40 dark:text-sky-300 dark:hover:bg-sky-500/10">
          @Icons.Svg("Bell", "fill-current", 18)
          <span data-alert-label>@(state.PriceDrop ? "به شما خبر می‌دهیم (کاهش قیمت)" : "خبرم کن وقتی قیمت کم شد")</span>
        </button>
      }
      else
      {
        <button type="button" data-product-alert="1" data-product="@p.Id" aria-pressed="@(state.BackInStock ? "true" : "false")"
                data-on-text="به محض موجود شدن خبرتان می‌کنیم" data-off-text="موجود شد خبرم کن"
                class="flex w-full items-center justify-center gap-x-2 rounded-lg bg-sky-500 px-3 py-2.5 text-sm font-semibold text-white transition hover:bg-sky-400 aria-pressed:bg-emerald-500">
          @Icons.Svg("Bell", "fill-current", 18)
          <span data-alert-label>@(state.BackInStock ? "به محض موجود شدن خبرتان می‌کنیم" : "موجود شد خبرم کن")</span>
        </button>
      }
      <p class="text-[11px] leading-5 text-zinc-400">اطلاع‌رسانی از طریق اعلان سایت@(settings.CanUseWebPush ? "، اعلان مرورگر" : null) و پیامک (در صورت فعال بودن) انجام می‌شود. لیست را در «خبرم کن» پروفایل ببینید.</p>
    }
    @if (settings.IsPriceHistoryEnabled)
    {
      <details class="group rounded-lg border px-3 py-2 text-sm text-zinc-600 dark:border-zinc-700 dark:text-zinc-300" data-price-history="@p.Id">
        <summary class="flex cursor-pointer list-none items-center justify-between">
          <span class="flex items-center gap-x-2">@Icons.Svg("ChartLine", "fill-current", 18) نمودار تغییرات قیمت</span>
          @Icons.Svg("CaretDown", "fill-current transition group-open:rotate-180", 16)
        </summary>
        <div class="mt-3" data-price-chart aria-live="polite">
          <p class="text-xs text-zinc-400">در حال بارگذاری…</p>
        </div>
      </details>
    }
  </div>
}
