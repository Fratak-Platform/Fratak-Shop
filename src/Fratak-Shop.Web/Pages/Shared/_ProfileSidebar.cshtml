@model ProfileSection
@{
    var items = new List<(ProfileSection Section, string Page, string Title, string Icon)>
    {
        (ProfileSection.Dashboard, "/Profile/Index", "پیشخوان", "Home"),
        (ProfileSection.Orders, "/Profile/Orders", "سفارش ها", "Orders"),
        (ProfileSection.Addresses, "/Profile/Addresses", "آدرس ها", "MapPin"),
        (ProfileSection.Favorites, "/Profile/Favorites", "علاقه مندی ها", "HeartThin"),
        (ProfileSection.Notifications, "/Profile/Notifications", "اعلان ها", "Bell"),
        (ProfileSection.Messages, "/Profile/Messages", "پیغام ها", "Mail"),
        (ProfileSection.PersonalInfo, "/Profile/PersonalInfo", "اطلاعات حساب کاربری", "UserCircle"),
        (ProfileSection.Password, "/Profile/Password", "رمز عبور و امنیت", "Shield"),
        (ProfileSection.Sessions, "/Profile/Sessions", "دستگاه های فعال", "Devices"),
    };
    if (Site.Settings.IsWalletEnabled)
    {
        items.Insert(2, (ProfileSection.Wallet, "/Profile/Wallet", "کیف پول", "Wallet"));
    }
    if (Site.Settings.IsLoyaltyEnabled)
    {
        items.Insert(Site.Settings.IsWalletEnabled ? 3 : 2, (ProfileSection.Club, "/Club", "باشگاه مشتریان", "Crown"));
    }
}
<div class="md:w-3/12 bg-white shadow-lg rounded-2xl py-3 h-fit">
  @Icons.Svg("Profile", "fill-zinc-700 mx-auto", 60)
  <div class="text-center font-semibold text-lg md:text-xl text-zinc-700">
    @User.GetDisplayName()
  </div>
  <div class="text-center text-xs text-zinc-400 mt-1" dir="ltr">@User.GetPhoneNumber()</div>
  <ul class="px-5 py-3 space-y-1">
    @foreach (var item in items)
    {
      var active = item.Section == Model;
      <li class="px-3 py-2 group flex gap-x-2 items-center rounded-lg @(active ? "bg-sky-50" : "hover:bg-gray-50")">
        <span class="h-5 w-0.5 rounded-full @(active ? "bg-sky-500" : "bg-transparent group-hover:bg-sky-300")"></span>
        <a asp-page="@item.Page" class="flex items-center gap-x-2 w-full @(active ? "text-sky-600" : "text-zinc-700 hover:text-sky-600")" aria-current="@(active ? "page" : null)">
          @Icons.Svg(item.Icon, active ? "fill-sky-600" : "fill-zinc-600 group-hover:fill-sky-600")
          @item.Title
        </a>
      </li>
    }
    <li class="px-3 py-2 group flex gap-x-2 items-center rounded-lg hover:bg-red-50">
      <span class="h-5 w-0.5 rounded-full bg-transparent group-hover:bg-red-400"></span>
      <form method="post" asp-page="/Logout" class="w-full">
        <button type="submit" class="flex items-center gap-x-2 w-full text-red-500 hover:text-red-600">
          @Icons.Svg("SignOut", "fill-red-500")
          خروج از حساب کاربری
        </button>
      </form>
    </li>
  </ul>
</div>
