@model VoteButtonsModel
@* Helpful votes (shop.js → /api/comments/{id}/vote). Guests are sent to the login page. *@
<div class="mt-3 flex items-center gap-x-2 text-xs text-zinc-500" data-vote="@Model.CommentId">
  <span>این مطلب مفید بود؟</span>
  <button type="button" data-vote-value="true" aria-pressed="@(Model.MyVote == true ? "true" : "false")"
          class="inline-flex items-center gap-x-1 rounded-full border px-2 py-0.5 transition hover:border-emerald-400 aria-pressed:border-emerald-500 aria-pressed:bg-emerald-50 aria-pressed:text-emerald-600 dark:aria-pressed:bg-emerald-500/10">
    @Icons.Svg("ThumbsUp", "fill-current", 14) <span data-vote-count="helpful">@Model.HelpfulCount</span>
    <span class="sr-only">مفید بود</span>
  </button>
  <button type="button" data-vote-value="false" aria-pressed="@(Model.MyVote == false ? "true" : "false")"
          class="inline-flex items-center gap-x-1 rounded-full border px-2 py-0.5 transition hover:border-red-300 aria-pressed:border-red-400 aria-pressed:bg-red-50 aria-pressed:text-red-500 dark:aria-pressed:bg-red-500/10">
    @Icons.Svg("ThumbsDown", "fill-current", 14) <span data-vote-count="notHelpful">@Model.NotHelpfulCount</span>
    <span class="sr-only">مفید نبود</span>
  </button>
</div>
