@model int
@{
    string[] ordinals = ["اول", "دوم", "سوم", "چهارم", "پنجم", "ششم"];
}
<div class="mb-2" dir="ltr">
  <div class="input-field mb-5 flex gap-x-3 justify-center">
    @for (var i = 0; i < Model; i++)
    {
      <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" name="Digits" aria-label="رقم @(i < ordinals.Length ? ordinals[i] : (i + 1).ToString())"
             class="inputVerify w-10 h-11 rounded-md outline-none text-center drop-shadow-lg border border-zinc-200 focus:border-sky-500"
             autocomplete="@(i == 0 ? "one-time-code" : "off")" disabled="@(i > 0)" required />
    }
  </div>
</div>
