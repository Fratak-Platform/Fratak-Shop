@using Fratak_Shop.Core.DTOs.Pages.Query
@using Fratak_Shop.Data.Entities.Pages
@{
    var alerts = (ViewData[PageMetaKeys.Alerts] as List<PageAlertDto>)?
        .Where(a => a.Position is AlertPosition.Top or AlertPosition.AboveContent)
        .OrderBy(a => a.DisplayOrder)
        .ToList() ?? [];

    static string Style(AlertType type) => type switch
    {
        AlertType.Success => "border-green-200 bg-green-50 text-green-700",
        AlertType.Warning => "border-yellow-200 bg-yellow-50 text-yellow-700",
        AlertType.Error => "border-red-200 bg-red-50 text-red-600",
        _ => "border-sky-200 bg-sky-50 text-sky-700",
    };
}
@if (alerts.Count > 0)
{
  <div class="pt-24 md:pt-36 -mb-20 md:-mb-32 max-w-[1600px] mx-auto px-3 md:px-6 space-y-2">
    @foreach (var alert in alerts)
    {
      <div class="rounded-xl border px-4 py-3 text-sm @Style(alert.Type)">
        @if (!string.IsNullOrWhiteSpace(alert.Title))
        {
          <span class="font-semibold">@alert.Title:</span>
        }
        @alert.Content
      </div>
    }
  </div>
}
