@{
    var layout = ViewData[ViewDataKeys.Layout] as LayoutViewModel ?? new LayoutViewModel();
    var seo = ViewData[ViewDataKeys.Seo] as SeoRenderModel ?? new SeoRenderModel();
}
<!DOCTYPE html>
<html lang="fa" dir="rtl" class="scroll-smooth">
<head>
    <partial name="_Head" model="seo" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="mx-auto min-h-screen bg-[#fcfcfc] pb-16 pt-28 md:pb-0 md:pt-36">
    <partial name="_Header" model="layout" />

    <main class="container mx-auto px-3 pt-5 md:px-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <partial name="_Footer" model="layout" />
    <partial name="_MobileNav" model="layout" />
    <partial name="_CartDrawer" model="layout" />

    <div id="toast-host" class="pointer-events-none fixed bottom-24 left-1/2 z-[60] flex w-11/12 max-w-sm -translate-x-1/2 flex-col gap-y-2 md:bottom-8"></div>

    <script src="~/assets/js/main.js"></script>
    <script src="~/assets/js/dependencies/swiper.min.js"></script>
    <script src="~/assets/js/sliders.js"></script>
    <script src="~/assets/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
