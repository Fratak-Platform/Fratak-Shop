@{
    var shop = ShopSettings.Value;
    var quickLinks = new (string Page, string Title)[]
    {
        ("/Index", "صفحه اصلی"),
        ("/Search", "همه محصولات"),
        ("/Blog", "وبلاگ"),
        ("/Faq", "سوالات متداول"),
        ("/Rules", "قوانین و مقررات"),
        ("/AboutUs", "درباره ما"),
        ("/ContactUs", "تماس با ما"),
    };
    const string linkClass = "text-gray-500 hover:text-blue-600 transition flex items-center gap-x-1 group w-fit";
}
<footer class="mt-44 relative flex justify-center">
    <div class="flex flex-col md:flex-row gap-y-7 justify-between md:items-center px-10 py-14 absolute mx-auto -top-32 bg-blue-600 w-11/12 rounded-2xl">
      <div class="flex flex-col gap-y-5">
        <p class="text-2xl text-center md:text-right md:text-4xl font-semibold text-gray-50">
          @shop.Tagline
        </p>
        <p class="text-lg text-center md:text-xl text-gray-100">
          به مشتریان خود خدمات شگفت انگیزی ارائه می دهیم.
        </p>
      </div>
      <div class="md:w-6/12">
        <p class="text-sm leading-7 md:text-lg text-gray-50">
          برای داشتن مشتریان همیشه راضی، کنترل کیفی دقیق لازم داریم. ارتباط عالی با مشتریان یکی از ویژگی های ماست. ما دائما درحال بررسی کیفیت محصولات هستیم تا مشتریانمان بهترین خدمات را دریافت کنند.
        </p>
        <a asp-page="/Search" class="inline-block text-gray-800 bg-white px-3 py-2 mt-3 rounded-xl bg-gradient-to-r from-gray-200 to-gray-300">
          مشاهده محصولات
        </a>
      </div>
    </div>
    <div class="bg-zinc-950 pt-80 lg:pt-40 w-full pb-20 md:pb-0">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-y-7 lg:grid-cols-3 px-10">
        <div class="flex flex-col md:items-center">
          <div class="text-sky-500 mb-4 text-lg font-bold border-t-2 border-t-sky-700 w-fit pt-2">
            دسترسی سریع
          </div>
          <div class="">
            <ul class="flex flex-col gap-y-4">
              @foreach (var link in quickLinks)
              {
                <li>
                  <a class="@linkClass" asp-page="@link.Page">
                    @Icons.Svg("ChevronLeft", "group-hover:fill-blue-600 fill-gray-500", 14)
                    @link.Title
                  </a>
                </li>
              }
            </ul>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="text-sky-500 mb-4 text-lg font-bold border-t-2 border-t-sky-700 w-fit pt-2">
            راه های ارتباطی
          </div>
          <div>
            <ul class="flex flex-col gap-y-4">
              @if (!string.IsNullOrWhiteSpace(shop.SupportPhone))
              {
                <li>
                  <a class="@linkClass" href="tel:@shop.SupportPhone" dir="ltr">
                    @Icons.Svg("Phone", "group-hover:fill-blue-600 fill-gray-500")
                    @shop.SupportPhone
                  </a>
                </li>
              }
              @if (!string.IsNullOrWhiteSpace(shop.SupportEmail))
              {
                <li>
                  <a class="@linkClass" href="mailto:@shop.SupportEmail">
                    @Icons.Svg("Envelope", "group-hover:fill-blue-600 fill-gray-500")
                    @shop.SupportEmail
                  </a>
                </li>
              }
              @if (!string.IsNullOrWhiteSpace(shop.Address))
              {
                <li>
                  <span class="@linkClass">
                    @Icons.Svg("MapPin", "group-hover:fill-blue-600 fill-gray-500")
                    @shop.Address
                  </span>
                </li>
              }
              @if (!string.IsNullOrWhiteSpace(shop.WorkingHours))
              {
                <li>
                  <span class="@linkClass">
                    @Icons.Svg("Clock", "group-hover:fill-blue-600 fill-gray-500")
                    @shop.WorkingHours
                  </span>
                </li>
              }
            </ul>
          </div>
        </div>
        <div class="flex justify-center gap-x-5">
          <img class="max-w-32 h-fit bg-white rounded-xl" src="~/assets/image/service/symbol-01.png" alt="نماد اعتماد" loading="lazy">
          <img class="max-w-32 h-fit bg-white rounded-xl" src="~/assets/image/service/symbol-02.png" alt="نماد ساماندهی" loading="lazy">
        </div>
      </div>
      <div class="mt-5 border-t w-full text-xs text-zinc-500 pr-5 py-5">
        تمامی حقوق برای @shop.SiteName محفوظ است. © @DateTime.Now.Year
      </div>
    </div>
  </footer>
