@model LayoutViewModel
@{
    var site = Model.Site;
}
<footer class="relative mt-44 flex justify-center">
    @* --------------------------------------------------------------- call to action *@
    <div class="absolute -top-32 mx-auto flex w-11/12 flex-col justify-between gap-y-7 rounded-2xl bg-gradient-to-l from-sky-600 to-sky-500 px-6 py-10 md:flex-row md:items-center md:px-10 md:py-14">
        <div class="flex flex-col gap-y-4">
            <p class="text-center text-2xl font-semibold text-gray-50 md:text-right md:text-4xl">بهترین تجربه خرید را داشته باشید</p>
            <p class="text-center text-base text-sky-50 md:text-right md:text-xl">
                @(string.IsNullOrWhiteSpace(site.AboutShortText) ? "پشتیبانی واقعی، ارسال سریع و ضمانت اصالت کالا." : site.AboutShortText)
            </p>
        </div>
        <div class="md:w-6/12">
            <p class="text-sm leading-7 text-sky-50 md:text-base">
                @(string.IsNullOrWhiteSpace(site.FooterAbout) ? "همراهی ما پس از خرید تمام نمی‌شود؛ تا زمانی که از خرید خود راضی باشید در کنار شما هستیم." : site.FooterAbout)
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
                <a class="btn bg-white text-zinc-800 hover:bg-zinc-100" href="/products">مشاهده محصولات</a>
                @if (!string.IsNullOrWhiteSpace(site.PhoneNumber))
                {
                    <a class="btn border border-white/40 text-white hover:bg-white/10" href="tel:@site.PhoneNumber">
                        تماس با پشتیبانی: @PriceHelper.ToPersianDigits(site.PhoneNumber)
                    </a>
                }
            </div>
        </div>
    </div>

    @* ------------------------------------------------------------------- bottom *@
    <div class="w-full bg-zinc-950 pb-24 pt-80 md:pb-0 lg:pt-40">
        <div class="container mx-auto grid grid-cols-1 gap-y-8 px-5 md:grid-cols-2 lg:grid-cols-4">
            <div class="flex flex-col gap-y-4">
                <img class="w-36" src="@Ui.FooterLogo(site)" alt="@site.SiteName" />
                <p class="text-sm leading-7 text-zinc-500">
                    @(string.IsNullOrWhiteSpace(site.AboutShortText) ? site.SiteDescription : site.AboutShortText)
                </p>
                @if (site.ShowSocialInFooter && Model.FooterSocials.Count > 0)
                {
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                        @foreach (var social in Model.FooterSocials)
                        {
                            <a class="chip border-zinc-700 bg-zinc-900 text-zinc-400 hover:border-sky-500 hover:text-sky-400" href="@social.Url" target="_blank" rel="noopener">@social.PlatformTitle</a>
                        }
                    </div>
                }
            </div>

            @foreach (var column in Model.FooterColumns)
            {
                <div class="flex flex-col">
                    <div class="mb-4 w-fit border-t-2 border-sky-700 pt-2 text-lg font-bold text-sky-500">@column.Title</div>
                    <ul class="flex flex-col gap-y-3">
                        @foreach (var link in column.Children)
                        {
                            <li>
                                <a class="text-sm text-zinc-500 transition hover:text-sky-500" href="@link.Url">@link.Title</a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="flex flex-col">
                <div class="mb-4 w-fit border-t-2 border-sky-700 pt-2 text-lg font-bold text-sky-500">راه‌های ارتباطی</div>
                <ul class="flex flex-col gap-y-3 text-sm text-zinc-500">
                    @if (!string.IsNullOrWhiteSpace(site.Address))
                    {
                        <li class="flex items-start gap-x-2">
                            <svg class="mt-0.5 shrink-0 text-sky-600" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M128,16a88.1,88.1,0,0,0-88,88c0,75.3,80,132.17,83.41,134.55a8,8,0,0,0,9.18,0C136,236.17,216,179.3,216,104A88.1,88.1,0,0,0,128,16Zm0,120a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z"></path></svg>
                            <span>@site.Address</span>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.Email))
                    {
                        <li class="flex items-center gap-x-2">
                            <svg class="shrink-0 text-sky-600" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M224,48H32a8,8,0,0,0-8,8V192a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V56A8,8,0,0,0,224,48Zm-96,85.15L52.57,64H203.43ZM98.71,128,40,181.81V74.19Zm11.84,10.85,12,11.05a8,8,0,0,0,10.82,0l12-11.05,58,53.15H52.57ZM157.29,128,216,74.18V181.82Z"></path></svg>
                            <a class="hover:text-sky-500" href="mailto:@site.Email">@site.Email</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.MobileNumber))
                    {
                        <li class="flex items-center gap-x-2">
                            <svg class="shrink-0 text-sky-600" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 256 256"><path d="M222.37,158.46l-47.11-21.11-.13-.06a16,16,0,0,0-15.17,1.4,8.12,8.12,0,0,0-.75.56L134.87,160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16,16,0,0,0,1.32-15.06l-21.12-47.16c-3.18-7.15-11.01-11.3-18.6-9.86-23.85,4.5-39.69,13.9-45.61,27.36a54.63,54.63,0,0,0-3.53,36.76c14.9,66.65,83,132.93,150.15,149.09a75.62,75.62,0,0,0,18.83,2.31c13.56,0,23.5-4.25,31.11-13.28,10.83-12.87,16.65-26.76,18.75-34.6C226.65,169,229.17,161.4,222.37,158.46Z"></path></svg>
                            <a class="hover:text-sky-500" href="tel:@site.MobileNumber">@PriceHelper.ToPersianDigits(site.MobileNumber)</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(site.WorkingHours))
                    {
                        <li>@site.WorkingHours</li>
                    }
                </ul>

                <div class="mt-5 flex items-center gap-x-4">
                    <img class="h-fit max-w-28 rounded-xl bg-white p-1" src="/assets/image/service/symbol-01.png" alt="نماد اعتماد الکترونیکی" />
                    <img class="h-fit max-w-28 rounded-xl bg-white p-1" src="/assets/image/service/symbol-02.png" alt="ساماندهی" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(site.EnamadCode) || !string.IsNullOrWhiteSpace(site.SamandehiCode))
        {
            <div class="container mx-auto mt-6 flex flex-wrap items-center gap-4 px-5 text-xs text-zinc-500">
                @Html.Raw(site.EnamadCode)
                @Html.Raw(site.SamandehiCode)
            </div>
        }

        <div class="container mx-auto mt-6 flex flex-col items-center justify-between gap-4 border-t border-zinc-800 px-5 py-5 text-xs text-zinc-500 md:flex-row">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                @foreach (var link in Model.FooterBottom)
                {
                    <a class="hover:text-sky-500" href="@link.Url">@link.Title</a>
                }
            </div>
            <p>@(string.IsNullOrWhiteSpace(site.Copyright) ? $"تمامی حقوق این سایت متعلق به {site.SiteName} است." : site.Copyright)</p>
        </div>
    </div>
</footer>
