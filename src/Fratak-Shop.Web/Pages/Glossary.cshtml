@page "/glossary"
@model GlossaryModel
@{
    Layout = "_Layout";
}
@* دور ۲۴ (پیشنهاد ۴۲): واژه‌نامهٔ مشخصات فنی *@
  <main class="pt-24 md:pt-36 max-w-[1100px] mx-auto px-3 md:px-6">
    <div class="bg-white border rounded-xl shadow-lg p-4 md:p-8">
      <h1 class="text-2xl md:text-3xl font-bold text-zinc-800">واژه‌نامهٔ مشخصات فنی</h1>
      <p class="mt-3 text-zinc-600 leading-7">معنی ساده اصطلاحاتی که در مشخصات کالاهای فروشگاه می‌بینید؛ برای اینکه پیش از خرید بدانید هر عدد و عبارت دقیقاً چه معنایی دارد.</p>
      @if (Model.View.Terms.Count == 0)
      {
        <p class="py-10 text-center text-zinc-500">هنوز اصطلاحی برای نمایش وجود ندارد.</p>
      }
      else
      {
        <nav class="mt-6 flex flex-wrap gap-2 text-sm" aria-label="فهرست اصطلاحات">
          @foreach (var term in Model.View.Terms)
          {
            <a href="#@term.Slug" class="border rounded-full px-3 py-1 hover:border-sky-400">@term.Name</a>
          }
        </nav>
        <dl class="mt-8 space-y-6">
          @foreach (var term in Model.View.Terms)
          {
            <div id="@term.Slug" class="border-b last:border-b-0 pb-6 scroll-mt-32">
              <dt class="font-bold text-lg text-zinc-800">@term.Name</dt>
              <dd class="mt-2 text-zinc-600 leading-8">
                @term.Definition
                @if (term.CategorySlug is not null)
                {
                  <span class="block mt-2 text-sm">
                    <a href="/category/@term.CategorySlug" class="text-sky-600 hover:underline">مشاهدهٔ @term.CategoryName</a>
                    <span class="text-zinc-400">(@Fratak_Shop.Web.Helpers.Format.Number(term.ProductCount) کالا با این مشخصه)</span>
                  </span>
                }
              </dd>
            </div>
          }
        </dl>
      }
    </div>
  </main>
